---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
const cats = [['', 'Toutes'], ['desert', '🏜️ Désert'], ['mer', '🛥️ Mer & yacht'], ['ciel', '🎈 Dans les airs'], ['incontournables', '🏙️ Incontournables'], ['excursions', '🧭 Excursions'], ['famille', '👨‍👩‍👧 En famille']];
---
<Layout title="Activités à Dubaï" description="Toutes nos activités à Dubaï : désert, yacht, montgolfière, hélicoptère, Burj Khalifa, Oman, Abu Dhabi. Réservez en ligne.">
  <section class="container-x pb-6 pt-28 sm:pt-32">
    <nav class="text-xs text-muted"><a href="/" class="hover:text-ink">Accueil</a> › Activités</nav>
    <h1 class="mt-2 text-3xl font-bold sm:text-4xl">🇦🇪 Activités à Dubaï</h1>
    <p class="mt-1 text-muted">Découvrez notre sélection d'activités à Dubaï, préparées avec soin par notre équipe.</p>
    <div class="mt-6 flex max-w-xl items-center gap-2 rounded-full border border-line bg-white p-1.5 pl-5 shadow-sm" role="search">
      <Icon name="search" class="h-5 w-5 shrink-0 text-muted" />
      <label for="q" class="sr-only">Rechercher</label>
      <input id="q" type="search" placeholder="Rechercher une activité…" class="min-w-0 flex-1 bg-transparent py-2 text-ink outline-none placeholder:text-muted" />
    </div>
    <div class="no-scrollbar -mx-4 mt-5 flex gap-2 overflow-x-auto px-4 sm:mx-0 sm:px-0" role="group" aria-label="Catégories">
      {cats.map(([id, label]) => <button class="chip" data-cat={id} aria-pressed={id === '' ? 'true' : 'false'}>{label}</button>)}
    </div>
  </section>
  <section class="container-x pb-20">
    <p id="count" class="mb-5 text-sm text-muted" aria-live="polite"></p>
    <div id="grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"></div>
    <p id="empty" class="hidden rounded-2xl bg-sand p-10 text-center text-muted">Aucune activité trouvée. Écrivez-nous, nous avons d'autres idées !</p>
  </section>
</Layout>
<script>
  import { fetchActivities, activityCard, skeleton, paintFavs, live } from '../../lib/app';
  const grid = document.getElementById('grid')!;
  grid.innerHTML = skeleton(8);
  const params = new URLSearchParams(location.search);
  let cat = params.get('cat') ?? '';
  const q = document.getElementById('q') as HTMLInputElement;
  q.value = params.get('q') ?? '';
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-cat]')];
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const apply = () => {
    const words = norm(q.value.trim()).split(/\s+/).filter(Boolean);
    let n = 0;
    grid.querySelectorAll<HTMLElement>('.card').forEach((c) => {
      const ok = (!cat || (c.dataset.cats ?? '').split(' ').includes(cat)) && words.every((w) => norm(c.dataset.search ?? '').includes(w));
      c.style.display = ok ? '' : 'none'; if (ok) n++;
    });
    chips.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
    document.getElementById('count')!.textContent = `${n} activité${n > 1 ? 's' : ''}`;
    document.getElementById('empty')!.classList.toggle('hidden', n > 0);
  };
  chips.forEach((b) => b.addEventListener('click', () => { cat = b.dataset.cat ?? ''; history.replaceState(null, '', cat ? '?cat=' + cat : location.pathname); apply(); }));
  q.addEventListener('input', apply);
  live('acts', fetchActivities, (acts) => { grid.innerHTML = acts.map((a) => activityCard(a)).join(''); paintFavs(grid); apply(); });
</script>
