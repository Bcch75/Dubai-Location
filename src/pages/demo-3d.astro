---
// Page de démonstration : voiture en 3D (non référencée dans le menu)
import Layout from '../layouts/Layout.astro';
---
<Layout title="Démo voiture 3D" description="Démonstration : une voiture de luxe en 3D, à faire tourner à 360°.">
  <section class="container-x pb-16 pt-28 sm:pt-32">
    <p class="text-sm font-semibold text-gold">Maquette · démonstration</p>
    <h1 class="mt-1 text-3xl sm:text-4xl">Ferrari 458 Italia en 3D</h1>
    <p class="mt-2 max-w-2xl text-gray-500">Faites tourner la voiture avec le doigt ou la souris, zoomez avec deux doigts, et changez sa couleur.</p>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_340px]">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-b from-[#f4f6fa] via-white to-[#e9edf3] shadow-soft ring-1 ring-gray-100">
        <model-viewer
          id="car"
          src="/models/ferrari.glb"
          alt="Ferrari 458 Italia en 3D"
          camera-controls
          auto-rotate
          auto-rotate-delay="0"
          rotation-per-second="18deg"
          interaction-prompt="auto"
          shadow-intensity="1.2"
          shadow-softness="0.9"
          exposure="1.05"
          environment-image="legacy"
          camera-orbit="35deg 72deg 105%"
          min-camera-orbit="auto 20deg auto"
          max-camera-orbit="auto 88deg 160%"
          touch-action="pan-y"
          style="width:100%;height:clamp(320px,55vw,560px);background:transparent;--poster-color:transparent"
        >
          <div slot="progress-bar"></div>
        </model-viewer>
        <div id="hint" class="pointer-events-none absolute inset-x-0 bottom-4 text-center text-sm font-medium text-gray-500">Faites glisser pour tourner · pincez pour zoomer</div>
        <span class="absolute left-4 top-4 rounded-full bg-sky-400/90 px-3 py-1.5 text-xs font-semibold text-white shadow-lg">Vue 3D 360°</span>
      </div>

      <aside class="space-y-4">
        <div class="rounded-2xl border border-line bg-white p-5 shadow-soft">
          <p class="text-xs text-muted">Prix par jour</p>
          <p class="text-2xl font-bold">Sur demande</p>
          <p class="label mt-5">Couleur</p>
          <div id="colors" class="flex flex-wrap gap-2">
            <button data-c="#b90000" class="h-9 w-9 rounded-full ring-2 ring-gold ring-offset-2" style="background:#b90000" title="Rosso Corsa"></button>
            <button data-c="#f5c400" class="h-9 w-9 rounded-full ring-2 ring-transparent ring-offset-2" style="background:#f5c400" title="Giallo"></button>
            <button data-c="#111111" class="h-9 w-9 rounded-full ring-2 ring-transparent ring-offset-2" style="background:#111111" title="Nero"></button>
            <button data-c="#f2f2f2" class="h-9 w-9 rounded-full ring-2 ring-transparent ring-offset-2 border border-gray-200" style="background:#f2f2f2" title="Bianco"></button>
            <button data-c="#0b3d91" class="h-9 w-9 rounded-full ring-2 ring-transparent ring-offset-2" style="background:#0b3d91" title="Blu"></button>
            <button data-c="#c9a227" class="h-9 w-9 rounded-full ring-2 ring-transparent ring-offset-2" style="background:#c9a227" title="Oro"></button>
          </div>
          <div class="mt-5 grid grid-cols-3 gap-2 text-center text-xs text-gray-500">
            <div class="rounded-xl bg-sand p-2"><b class="block text-base text-ink">2</b>places</div>
            <div class="rounded-xl bg-sand p-2"><b class="block text-base text-ink">V8</b>moteur</div>
            <div class="rounded-xl bg-sand p-2"><b class="block text-base text-ink">570</b>ch</div>
          </div>
          <button id="spin" class="btn-outline mt-5 w-full !py-2.5 text-sm">Arrêter la rotation</button>
        </div>
        <p class="text-xs leading-relaxed text-gray-400">Modèle 3D « Ferrari 458 Italia » par vicent091036 (Sketchfab), utilisé ici uniquement pour la démonstration. Pour le site final, il faudra des modèles 3D de vos propres voitures.</p>
      </aside>
    </div>
  </section>
</Layout>

<script>
  import { ModelViewerElement } from '@google/model-viewer';
  // Décodeur 3D hébergé sur le site (pas de service extérieur)
  (ModelViewerElement as any).dracoDecoderLocation = '/draco/';
  const mv = document.getElementById('car') as any;
  const paint = (hex: string) => {
    const mat = mv.model?.materials.find((m: any) => m.name === 'Body_Color');
    if (!mat) return;
    const c = hex.match(/\w\w/g)!.map((x) => parseInt(x, 16) / 255);
    mat.pbrMetallicRoughness.setBaseColorFactor([c[0], c[1], c[2], 1]);
    mat.pbrMetallicRoughness.setMetallicFactor(0.6);
    mat.pbrMetallicRoughness.setRoughnessFactor(0.25);
  };
  mv.addEventListener('load', () => {
    paint('#b90000');
    // Vitres transparentes
    for (const m of mv.model?.materials ?? []) {
      if (/glass/i.test(m.name)) { m.setAlphaMode('BLEND'); m.pbrMetallicRoughness.setBaseColorFactor([0.12, 0.14, 0.16, 0.35]); m.pbrMetallicRoughness.setRoughnessFactor(0.05); }
    }
  });
  mv.addEventListener('camera-change', (e: any) => { if (e.detail.source === 'user-interaction') document.getElementById('hint')?.remove(); });
  document.getElementById('colors')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-c]'); if (!b) return;
    document.querySelectorAll('#colors [data-c]').forEach((x) => { x.classList.toggle('ring-gold', x === b); x.classList.toggle('ring-transparent', x !== b); });
    paint(b.dataset.c!);
  });
  const spin = document.getElementById('spin')!;
  spin.addEventListener('click', () => { mv.autoRotate = !mv.autoRotate; spin.textContent = mv.autoRotate ? 'Arrêter la rotation' : 'Relancer la rotation'; });
</script>
