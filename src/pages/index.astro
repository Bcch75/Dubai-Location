---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import hero from '../assets/img/hero.jpg';
import desert from '../assets/img/desert.jpg';
import yacht from '../assets/img/yacht.jpg';
import balloon from '../assets/img/montgolfiere.jpg';
import burj from '../assets/img/burj-khalifa.jpg';
import carImg from '../assets/img/cars/huracan-evo.jpg';

const tiles = [
  { href: '/activites/?cat=desert', title: 'Désert', img: desert },
  { href: '/activites/?cat=mer', title: 'Mer & yacht', img: yacht },
  { href: '/activites/?cat=ciel', title: 'Dans les airs', img: balloon },
  { href: '/activites/?cat=incontournables', title: 'Incontournables', img: burj },
  { href: '/voitures/', title: 'Voitures', img: carImg },
];
const rows = [
  { id: 'populaires', icon: '🔥', title: 'Les plus populaires', sub: 'Les activités préférées de nos clients à Dubaï.', href: '/activites/', kind: 'featured' },
  { id: 'desert', icon: '🏜️', title: 'Désert', sub: 'Quad, buggy, dîner bédouin : l’aventure au cœur des dunes.', href: '/activites/?cat=desert', kind: 'desert' },
  { id: 'mer', icon: '🛥️', title: 'Mer & yacht', sub: 'Yacht privé, jet-ski, plongée et croisière à Oman.', href: '/activites/?cat=mer', kind: 'mer' },
  { id: 'incontournables', icon: '🏙️', title: 'Incontournables & famille', sub: 'Burj Khalifa, Ski Dubai, dauphins, parcs d’attractions…', href: '/activites/?cat=famille', kind: 'famille' },
  { id: 'voitures', icon: '🏎️', title: 'Location de voitures', sub: 'Supercars et SUV de luxe livrés à votre hôtel.', href: '/voitures/', kind: 'cars' },
];
---
<Layout>
  <section class="relative isolate flex h-[520px] items-center justify-center overflow-hidden sm:h-[630px]">
    <Image src={hero} alt="Skyline de Dubaï au coucher du soleil" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-black/25"></div>
    <div class="container-x pt-16 text-center">
      <h1 class="mx-auto max-w-5xl text-4xl font-extrabold leading-none !text-white drop-shadow-[0_2px_12px_rgb(0_0_0/0.35)] sm:text-[60px]">Trouvez et réservez des activités</h1>
      <form action="/activites/" method="get" role="search" class="mx-auto mt-10 flex h-[66px] max-w-[576px] items-center gap-2 rounded-full bg-white p-[7px] pl-5 shadow-lift ring-4 ring-white/40">
        <Icon name="search" class="h-5 w-5 shrink-0 text-muted" />
        <label for="hero-q" class="sr-only">Rechercher</label>
        <input id="hero-q" name="q" type="search" placeholder="Une activité ou une voiture…" class="min-w-0 flex-1 bg-transparent py-2.5 text-ink outline-none placeholder:text-muted" />
        <button class="h-full shrink-0 rounded-full bg-gold px-5 text-base font-bold text-white shadow-md transition hover:bg-gold-deep sm:px-8 sm:text-xl">Rechercher</button>
      </form>
    </div>
  </section>

  <section class="container-x pt-14">
    <h2 class="mb-2 text-3xl font-bold sm:text-4xl">Nos univers</h2>
    <div class="no-scrollbar -mx-4 mt-6 flex snap-x scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-5 sm:overflow-visible sm:px-0">
      {tiles.map((t) => (
        <a href={t.href} class="group relative isolate aspect-[5/7] w-40 shrink-0 snap-start overflow-hidden rounded-3xl shadow-[0_4px_20px_0_rgb(0_0_0/0.08)] sm:w-auto">
          <Image src={t.img} alt="" widths={[300, 500]} sizes="(min-width: 640px) 20vw, 150px" class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
          <p class="absolute inset-x-0 bottom-0 p-4 text-xl font-bold text-white sm:text-2xl">{t.title}</p>
        </a>
      ))}
    </div>
  </section>

  {rows.map((r) => (
    <section id={r.id} class="container-x scroll-mt-28 pt-16">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="mb-1 flex items-center gap-2 text-2xl font-bold tracking-[-0.75px] sm:text-[30px] sm:leading-[1.25]"><span aria-hidden="true">{r.icon}</span>{r.title}</h2>
          <p class="text-gray-500">{r.sub}</p>
        </div>
        <a href={r.href} class="hidden shrink-0 text-base font-bold text-ink hover:text-gold sm:inline">Toutes les activités →</a>
      </div>
      <div class="relative mt-6">
        <div data-row={r.kind} class="no-scrollbar -mx-4 flex snap-x scroll-px-4 gap-5 overflow-x-auto scroll-smooth px-4 pb-4 sm:mx-0 sm:px-0"></div>
        <button type="button" data-scroll aria-label="Suivant" class="absolute -right-3 top-[38%] hidden h-11 w-11 place-items-center rounded-full border border-line bg-white shadow-soft hover:bg-sand lg:grid">→</button>
      </div>
    </section>
  ))}

  <section class="container-x py-16">
    <div class="flex flex-col items-start justify-between gap-5 rounded-2xl bg-ink p-6 text-white sm:flex-row sm:items-center sm:p-8">
      <div>
        <p class="text-xl font-bold">Une question avant de réserver ?</p>
        <p class="text-white/70">Notre équipe vous répond sur WhatsApp, en français.</p>
      </div>
      <a href="https://wa.me/971569736810" target="_blank" rel="noopener" class="btn-wa shrink-0 !py-3"><Icon name="whatsapp" class="h-5 w-5" /> Nous écrire</a>
    </div>
  </section>
</Layout>

<script>
  import { fetchActivities, fetchCars, activityCard, carCard, skeleton, paintFavs } from '../lib/app';
  const W = 'w-[78vw] shrink-0 snap-start sm:w-[270px]';
  const rows = document.querySelectorAll<HTMLElement>('[data-row]');
  rows.forEach((r) => (r.innerHTML = skeleton(4, W)));
  const [acts, cars] = await Promise.all([fetchActivities(), fetchCars()]);
  rows.forEach((r) => {
    const k = r.dataset.row!;
    const list = k === 'cars' ? cars.map((c) => carCard(c, W))
      : (k === 'featured' ? acts.filter((a) => a.featured) : acts.filter((a) => a.categories.includes(k))).map((a) => activityCard(a, W));
    r.innerHTML = list.join('') || '<p class="text-muted">Bientôt disponible.</p>';
  });
  paintFavs();
  document.querySelectorAll<HTMLButtonElement>('[data-scroll]').forEach((b) =>
    b.addEventListener('click', () => b.previousElementSibling?.scrollBy({ left: 640, behavior: 'smooth' })));
</script>
