---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getActivities, getCars, getCategories } from '../lib/data';
import { site } from '../data/site';
import { pill } from '../lib/icons';
import { activityCard, carCard, setBase } from '../lib/cards';
import hero from '../assets/img/hero.jpg';
import carImg from '../assets/img/cars/huracan-evo.jpg';

const categories = await getCategories();
const tileImg = (u: string | null) => (u && u.startsWith('/img/') ? u.replace('/img/', '/img/thumb/') : u ?? '');
const tiles = [
  ...categories.map((c) => ({ href: `/activites/${c.slug}/`, title: c.label, src: tileImg(c.image_url) })),
  { href: '/voitures/', title: 'Voitures', src: site.carsTileImage },
];
setBase(import.meta.env.BASE_URL);
const acts = await getActivities();
const cars = await getCars();
const W = 'w-[76vw] max-w-[300px] shrink-0 snap-start sm:w-[270px]';
const rowHtml = (k: string) => k === 'cars' ? cars.map((c) => carCard(c, W)).join('') : (k === 'featured' ? acts.filter((a) => a.featured) : acts.filter((a) => a.categories.includes(k))).map((a) => activityCard(a, W)).join('');
const rows = [
  { id: 'populaires', icon: 'flame', title: 'Les plus populaires', sub: 'Les activités préférées de nos clients à Dubaï.', href: '/activites/', kind: 'featured' },
  ...categories.filter((c) => c.on_home).map((c) => ({ id: c.slug, icon: c.icon ?? '', color: c.icon_color ?? null, title: c.label, sub: c.subtitle ?? '', href: `/activites/${c.slug}/`, kind: c.slug })),
  { id: 'voitures', icon: 'car', title: 'Location de voitures', sub: 'Supercars et SUV de luxe livrés à votre hôtel.', href: '/voitures/', kind: 'cars' },
];
---
<Layout>
  <section class="relative isolate flex h-[450px] items-center justify-center overflow-hidden sm:h-[630px]">
    {site.heroImage
      ? <img src={site.heroImage} alt="Dubaï" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[center_45%]" />
      : <Image src={hero} alt="La mer et le skyline de Dubaï avec le Burj Al Arab et des bateaux" widths={[800, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[center_45%]" />}
    <div class="absolute inset-0 -z-10 bg-black/25"></div>
    <div class="container-x pt-14 text-center sm:pt-16">
      <h1 class="mx-auto max-w-5xl text-[34px] font-extrabold leading-[1.08] min-[390px]:text-[36px] tracking-[-0.01em] !text-white sm:leading-none drop-shadow-[0_2px_12px_rgb(0_0_0/0.35)] sm:text-[60px]">{site.heroTitle}</h1>
      <form action="/activites/" method="get" role="search" class="relative mx-auto mt-7 w-full max-w-[576px] sm:mt-10">
        <label for="hero-q" class="sr-only">Rechercher</label>
        <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-5 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input id="hero-q" name="q" type="search" placeholder={site.searchPlaceholder} class="h-[58px] w-full rounded-full border border-gray-200 bg-white py-4 pl-11 pr-[136px] sm:h-[66px] sm:py-5 sm:pl-12 text-base text-[#121212] shadow-[0_10px_15px_-3px_rgb(0_0_0/0.1),0_4px_6px_-4px_rgb(0_0_0/0.1)] outline-none placeholder:text-gray-400 focus:border-gold sm:pr-[190px]" />
        <button class="absolute right-[6px] top-[6px] h-[46px] rounded-full bg-[#0171eb] px-5 text-base font-bold sm:right-[7px] sm:top-[7px] sm:h-[52px] text-white shadow-[0_4px_6px_-1px_rgb(0_0_0/0.1),0_2px_4px_-2px_rgb(0_0_0/0.1)] transition hover:bg-gold-deep sm:px-8 sm:text-xl">Rechercher</button>
      </form>
    </div>
  </section>

  <section class="container-x pt-14">
    <h2 class="mb-6 text-[32px] font-extrabold leading-tight sm:mb-8 sm:text-4xl">Nos univers</h2>
    <div class="no-scrollbar -mx-4 flex snap-x scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 lg:mx-0 lg:grid lg:auto-cols-fr lg:grid-flow-col lg:overflow-visible lg:px-0">
      {tiles.map((t) => (
        <a href={t.href} class="group relative isolate h-[250px] w-[160px] shrink-0 snap-start overflow-hidden rounded-[24px] shadow-[0_4px_20px_0_rgb(0_0_0/0.08)] sm:h-[283px] sm:w-[200px] lg:w-auto">
          {t.src ? <img src={t.src} alt="" loading="lazy" class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" /> : <Image src={carImg} alt="" widths={[300, 500]} sizes="200px" class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" />}
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
          <p class="absolute inset-x-0 bottom-0 p-4 text-lg font-bold leading-tight text-white lg:p-3 lg:text-[13px] xl:text-[17px]">{t.title}</p>
        </a>
      ))}
    </div>
  </section>

  {rows.map((r) => (
    <section id={r.id} class="container-x scroll-mt-28 pt-16">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between sm:gap-4">
        <div>
          <h2 class="mb-1 flex items-center gap-2 text-[28px] font-extrabold leading-tight tracking-[-0.75px] sm:text-[30px] sm:font-bold sm:leading-[1.25]"><Fragment set:html={pill(r.icon, 22, false, (r as any).color)} />{r.title}</h2>
          <p class="text-gray-500">{r.sub}</p>
        </div>
        <a href={r.href} class="shrink-0 text-sm font-bold text-ink hover:text-gold sm:text-base">Toutes les activités →</a>
      </div>
      <div class="relative mt-6">
        <div data-row={r.kind} set:html={rowHtml(r.kind)} class="no-scrollbar -mx-4 flex snap-x scroll-px-4 gap-6 overflow-x-auto scroll-smooth px-4 pb-6 pt-1 sm:-mx-2 sm:px-2"></div>
        <button type="button" data-scroll aria-label="Suivant" class="absolute -right-3 top-[38%] hidden h-11 w-11 place-items-center rounded-full border border-line bg-white shadow-soft hover:bg-sand lg:grid">→</button>
      </div>
    </section>
  ))}

  <section class="container-x py-16">
    <div class="flex flex-col items-start justify-between gap-5 rounded-2xl bg-ink p-6 text-white sm:flex-row sm:items-center sm:p-8">
      <div>
        <p class="text-xl font-bold">Une question avant de réserver ?</p>
        <p class="text-white/70">Notre équipe vous répond sur WhatsApp, en français.</p>
      </div>
      <a href="https://wa.me/971569736810" target="_blank" rel="noopener" class="btn-wa shrink-0 !py-3"><Icon name="whatsapp" class="h-5 w-5" /> Nous écrire</a>
    </div>
  </section>
  <script type="application/json" id="seed-acts" set:html={JSON.stringify(acts)} />
  <script type="application/json" id="seed-cars" set:html={JSON.stringify(cars)} />
</Layout>

<script>
  import { fetchActivities, fetchCars, activityCard, carCard, paintFavs, live } from '../lib/app';
  const W = 'w-[76vw] max-w-[300px] shrink-0 snap-start sm:w-[270px]';
  const rows = document.querySelectorAll<HTMLElement>('[data-row]');
  live('acts', fetchActivities, (acts) => rows.forEach((r) => {
    const k = r.dataset.row!; if (k === 'cars') return;
    r.innerHTML = (k === 'featured' ? acts.filter((a) => a.featured) : acts.filter((a) => a.categories.includes(k))).map((a) => activityCard(a, W)).join('') || '<p class="text-muted">Bientôt disponible.</p>';
    paintFavs(r);
  }));
  live('cars', fetchCars, (cars) => rows.forEach((r) => { if (r.dataset.row === 'cars') { r.innerHTML = cars.map((c) => carCard(c, W)).join(''); paintFavs(r); } }));
  paintFavs();
  document.querySelectorAll<HTMLButtonElement>('[data-scroll]').forEach((b) =>
    b.addEventListener('click', () => b.previousElementSibling?.scrollBy({ left: 640, behavior: 'smooth' })));
</script>
