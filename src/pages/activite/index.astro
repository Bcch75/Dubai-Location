---
import Layout from '../../layouts/Layout.astro';
import { getActivities } from '../../lib/data';
const seedData = await getActivities();
---
<Layout title="Activité" description="Réservez votre activité à Dubaï avec Dubai Location.">
  <div id="page" class="container-x pb-20 pt-28 sm:pt-32">
    <div class="animate-pulse space-y-4"><div class="h-8 w-1/2 rounded bg-sand"></div><div class="h-80 rounded-2xl bg-sand"></div></div>
  </div>
  <script type="application/json" id="seed-acts" set:html={JSON.stringify(seedData)} />
</Layout>
<script>
  import { svgIcon, pill } from '../../lib/icons';
  import { sb, esc, aed, img, url, cart, activityCard, paintFavs, ICON, waLink, videoBadge, cachedActivities, refreshCache, type Activity } from '../../lib/app';
  const slug = new URLSearchParams(location.search).get('s') ?? '';
  const page = document.getElementById('page')!;
  const fromCache = cachedActivities().find((x) => x.slug === slug) ?? null;
  const net = sb.from('activities').select('*').eq('slug', slug).maybeSingle();
  const a = (fromCache ?? (await net).data) as Activity | null;
  if (fromCache) net.then(({ data }) => { if (data && JSON.stringify(data) !== JSON.stringify(fromCache)) { const all = cachedActivities().map((x) => (x.slug === slug ? data : x)); refreshCache('acts', all); location.reload(); } });
  if (!a) {
    page.innerHTML = `<h1 class="text-3xl font-bold">Activité introuvable</h1><a class="btn-gold mt-6" href="${url('activites/')}">Voir toutes les activités</a>`;
  } else {
    document.title = `${a.title} | Dubai Location`;
    const pics = [a.image_url, ...(a.gallery ?? [])].filter(Boolean) as string[];
    const today = new Date().toISOString().slice(0, 10);
    const check = '<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
    const cross = '<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 6l12 12M18 6 6 18"/></svg>';
    page.innerHTML = `
      <nav class="text-xs text-muted"><a href="${url('')}" class="hover:text-ink">Accueil</a> › <a href="${url('activites/')}" class="hover:text-ink">Activités</a></nav>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">${esc(a.title)}</h1>
      <div class="mt-2 flex flex-wrap items-center justify-between gap-3 text-sm text-muted">
        <span class="flex flex-wrap items-center gap-1.5">${a.rating ? `<span class="flex">${ICON.star.repeat(Math.round(a.rating))}</span><b class="text-ink">${Number(a.rating).toFixed(1)}</b>${a.reviews_count ? `(${a.reviews_count})` : ''} · ` : ''}${svgIcon('pin', 15)} ${esc(a.location ?? 'Dubaï')} · ${ICON.clock} ${esc(a.duration ?? '')}</span>
        <span class="flex items-center gap-5">
          <button type="button" data-fav="activity:${esc(a.slug)}" class="fav-btn flex items-center gap-1.5 font-medium text-ink">${ICON.heart} Ajouter aux favoris</button>
          <button type="button" id="share" class="font-medium text-ink">↗ Partager</button>
        </span>
      </div>
      <div class="mt-5 grid gap-8 lg:grid-cols-[1fr_340px]">
        <div>
          <div class="relative grid h-[260px] gap-2 sm:h-[400px] ${pics.length > 1 ? 'sm:grid-cols-[2fr_1fr] sm:grid-rows-2' : ''}">
            <button type="button" data-gal="0" class="block h-full overflow-hidden rounded-2xl sm:row-span-2"><img src="${esc(img(pics[0]))}" alt="${esc(a.image_alt ?? a.title)}" class="h-full w-full object-cover transition duration-500 hover:scale-[1.03]"></button>
            ${pics.slice(1, 3).map((p, i) => `<button type="button" data-gal="${i + 1}" class="relative hidden h-full overflow-hidden rounded-2xl sm:block ${pics.length === 2 ? 'sm:row-span-2' : ''}"><img src="${esc(img(p))}" alt="" class="h-full w-full object-cover transition duration-500 hover:scale-[1.03]">${i === Math.min(1, pics.length - 2) ? `<span class="absolute inset-0 grid place-items-center bg-black/35 text-sm font-semibold text-white">${svgIcon('photos', 16, 'currentColor')} Voir toutes les photos (${pics.length})</span>` : ''}</button>`).join('')}
            ${a.video_url ? videoBadge(a.video_url, 'absolute right-3 top-3 z-10') : ''}
          </div>
          ${pics.length > 1 ? `<button type="button" data-gal="0" class="mt-2 text-sm font-semibold text-gold sm:hidden">${svgIcon('photos', 16, 'currentColor')} Voir toutes les photos (${pics.length})</button>` : ''}
          <div class="mt-6 space-y-4 leading-relaxed text-ink-soft">${(a.description ?? '').split(/\n\n+/).map((p) => `<p>${esc(p)}</p>`).join('')}</div>
          <h2 class="mt-8 text-xl font-bold">À propos</h2>
          <ul class="mt-3 space-y-3 text-sm">
            <li><b>Réservez maintenant, payez plus tard</b><br><span class="text-muted">Aucun paiement en ligne : vous réglez après confirmation.</span></li>
            <li><b>Confirmation rapide</b><br><span class="text-muted">Nous vérifions la disponibilité et vous confirmons sur WhatsApp.</span></li>
            <li><b>Durée : ${esc(a.duration ?? '-')}</b><br><span class="text-muted">L’horaire exact vous est communiqué à la confirmation.</span></li>
          </ul>
          ${a.highlights?.length ? `<div class="mt-8 grid gap-3 border-t border-line pt-6 sm:grid-cols-[160px_1fr]"><h2 class="text-lg font-bold">Points forts</h2><ul class="list-disc space-y-2 pl-5 font-medium">${a.highlights.map((h) => `<li>${esc(h)}</li>`).join('')}</ul></div>` : ''}
          ${a.options?.length ? `<div class="mt-8 border-t border-line pt-6"><h2 class="text-lg font-bold">Formules</h2><ul class="mt-3 divide-y divide-line rounded-2xl border border-line">${a.options.map((o) => `<li class="flex items-center justify-between gap-4 p-4"><span><b class="block">${esc(o.name)}</b>${o.detail ? `<span class="text-sm text-muted">${esc(o.detail)}</span>` : ''}</span>${o.price ? `<span class="shrink-0 font-semibold">${aed(o.price)}</span>` : ''}</li>`).join('')}</ul></div>` : ''}
          ${a.included?.length || a.excluded?.length ? `<div class="mt-8 border-t border-line pt-6"><h2 class="text-lg font-bold">Inclus / Non inclus</h2><div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            ${(a.included ?? []).map((i) => `<p class="flex gap-2 rounded-xl border border-emerald-200 bg-emerald-50/60 p-3 text-sm"><span class="text-emerald-600">${check}</span>${esc(i)}</p>`).join('')}
            ${(a.excluded ?? []).map((i) => `<p class="flex gap-2 rounded-xl border border-line bg-sand/60 p-3 text-sm text-muted"><span class="text-red-500">${cross}</span><span class="line-through">${esc(i)}</span></p>`).join('')}
          </div></div>` : ''}
          ${a.important ? `<div class="mt-8 grid gap-3 border-t border-line pt-6 sm:grid-cols-[160px_1fr]"><h2 class="text-lg font-bold">Informations importantes</h2><p class="flex items-start gap-2 font-medium">${svgIcon('warn', 18)}<span>${esc(a.important)}</span></p></div>` : ''}
        </div>
        <aside class="lg:sticky lg:top-28 lg:self-start">
          <form id="book" class="rounded-2xl border border-line bg-white p-5 shadow-soft">
            <p class="text-xs text-muted">${a.price_from ? 'À partir de' : 'Prix'}</p>
            <p class="text-2xl font-bold">${a.old_price ? `<span class="mr-2 text-base font-medium text-muted line-through">${aed(a.old_price)}</span>` : ''}${aed(a.price)} <span class="text-sm font-normal text-muted">${esc(a.price_unit ?? '')}</span></p>
            ${a.important ? `<p class="mt-4 flex items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">${svgIcon('warn', 16)}<span>${esc(a.important)}</span></p>` : ''}
            ${a.options?.length ? `<p class="label mt-4">Formule</p>
              <select id="opt" class="hidden" aria-hidden="true">${a.options.map((o, i) => `<option value="${i}">${esc(o.name)}</option>`).join('')}</select>
              <button type="button" id="opt-btn" class="flex w-full items-center gap-3 rounded-xl border border-line p-3 text-left transition hover:border-gold">
                ${pill('ticket', 22)}
                <span class="min-w-0 flex-1"><b id="opt-name" class="block truncate text-sm text-ink">Choisir une formule</b><span id="opt-price" class="text-xs text-gray-500">${a.options.length} formules disponibles</span></span>
                <span class="text-gray-400">›</span>
              </button>` : ''}
            <div class="mt-4 grid grid-cols-2 gap-3">
              <div><label class="label" for="date">Date</label><input id="date" type="date" min="${today}" class="field !px-3" required></div>
              <div><label class="label" for="qty">${esc(a.qty_label || 'Participants')}</label><input id="qty" type="number" min="1" max="50" value="2" class="field !px-3"></div>
            </div>
            <div class="mt-5 flex items-center justify-between border-t border-line pt-4"><span class="text-muted">Total estimé</span><span id="total" class="text-xl font-bold">-</span></div>
            <button class="mt-4 w-full rounded-xl bg-gold py-3.5 font-semibold text-white transition hover:bg-gold-deep">Ajouter au panier</button>
            <p id="err" class="mt-2 hidden text-center text-sm text-red-600">Veuillez sélectionner une date</p>
            <p id="ok" class="mt-2 hidden text-center text-sm text-emerald-700">Ajouté au panier ✓ <a class="font-semibold underline" href="${url('panier/')}">Voir le panier</a></p>
            <ul class="mt-5 space-y-3 text-sm">
              <li class="flex gap-2"><span class="text-emerald-600">${check}</span><span><b>Sans paiement en ligne</b><br><span class="text-muted">Vous réglez après confirmation.</span></span></li>
              <li class="flex gap-2"><span class="text-gold">${check}</span><span><b>Confirmation sur WhatsApp</b><br><span class="text-muted">Un conseiller vous recontacte rapidement.</span></span></li>
            </ul>
            <a class="mt-4 block text-center text-sm font-medium text-gold" target="_blank" rel="noopener" href="${waLink(`Bonjour Dubai Location, j'ai une question sur « ${a.title} ».`)}">Une question ? Écrivez-nous →</a>
          </form>
        </aside>
      </div>
      <section class="mt-16"><h2 class="text-2xl font-bold">Vous pourriez aussi aimer…</h2><div id="related" class="no-scrollbar -mx-4 mt-5 flex snap-x gap-6 overflow-x-auto px-4 pb-6 pt-1 sm:mx-0 sm:px-0"></div></section>`;

    const gal = document.createElement('dialog');
    gal.className = 'm-auto h-[100dvh] max-h-none w-screen max-w-none bg-black/95 p-0 backdrop:bg-black/80';
    gal.innerHTML = `<div class="flex h-full flex-col"><div class="flex items-center justify-between p-4 text-white"><span id="gal-n"></span><button type="button" data-x class="grid h-10 w-10 place-items-center rounded-full bg-white/10 text-xl">✕</button></div><div class="relative flex flex-1 items-center justify-center px-2 pb-6"><button type="button" data-p class="absolute left-3 grid h-11 w-11 place-items-center rounded-full bg-white/10 text-2xl text-white">‹</button><img id="gal-img" class="max-h-full max-w-full rounded-xl object-contain" alt=""><button type="button" data-n class="absolute right-3 grid h-11 w-11 place-items-center rounded-full bg-white/10 text-2xl text-white">›</button></div></div>`;
    document.body.append(gal);
    let gi = 0;
    const showG = (i: number) => { gi = (i + pics.length) % pics.length; (gal.querySelector('#gal-img') as HTMLImageElement).src = img(pics[gi]); gal.querySelector('#gal-n')!.textContent = `${gi + 1} / ${pics.length}`; };
    page.querySelectorAll<HTMLElement>('[data-gal]').forEach((b) => b.addEventListener('click', () => { showG(+b.dataset.gal!); gal.showModal(); }));
    gal.querySelector('[data-x]')!.addEventListener('click', () => gal.close());
    gal.querySelector('[data-p]')!.addEventListener('click', () => showG(gi - 1));
    gal.querySelector('[data-n]')!.addEventListener('click', () => showG(gi + 1));
    gal.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') showG(gi - 1); if (e.key === 'ArrowRight') showG(gi + 1); });
    const opt = document.getElementById('opt') as HTMLSelectElement | null;
    let optChosen = !a.options?.length;
    if (opt) {
      const od = document.createElement('dialog');
      od.className = 'm-auto w-[min(520px,94vw)] rounded-2xl p-0 backdrop:bg-black/50';
      od.innerHTML = `<div class="flex items-center justify-between border-b border-gray-100 p-5"><h3 class="text-lg font-bold">Choisir une formule</h3><button type="button" data-x class="grid h-9 w-9 place-items-center rounded-full bg-gray-100">✕</button></div>
        <div class="max-h-[65vh] space-y-2 overflow-y-auto p-4">${a.options.map((o, i) => `<button type="button" data-pick="${i}" class="flex w-full items-center justify-between gap-4 rounded-xl border-2 border-line p-4 text-left transition hover:border-gold"><span><b class="block text-ink">${esc(o.name)}</b>${o.detail ? `<span class="text-sm text-gray-500">${esc(o.detail)}</span>` : ''}</span><span class="shrink-0 font-bold text-ink">${o.price ? aed(o.price) : aed(a.price)}</span></button>`).join('')}</div>`;
      document.body.append(od);
      document.getElementById('opt-btn')!.addEventListener('click', () => od.showModal());
      od.querySelector('[data-x]')!.addEventListener('click', () => od.close());
      od.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-pick]'); if (!b) return;
        const o = a.options[+b.dataset.pick!];
        opt.value = b.dataset.pick!; optChosen = true;
        document.getElementById('opt-name')!.textContent = o.name;
        document.getElementById('opt-price')!.textContent = aed(o.price || a.price) + (a.price_unit ? ' ' + a.price_unit : '');
        document.getElementById('opt-btn')!.classList.add('border-gold', 'bg-blue-50/40');
        od.querySelectorAll('[data-pick]').forEach((x) => x.classList.toggle('!border-gold', x === b));
        od.close(); paint();
      });
    }
    const qty = document.getElementById('qty') as HTMLInputElement;
    const date = document.getElementById('date') as HTMLInputElement;
    const unit = () => (opt && a.options[+opt.value]?.price) || a.price;
    const paint = () => { document.getElementById('total')!.textContent = aed(unit() * Math.max(1, +qty.value || 1)); };
    [opt, qty].forEach((el) => el?.addEventListener('input', paint)); paint();
    // Dates complètes (bloquées par l'admin)
    const blocked = new Set<string>();
    const fullEl = document.createElement('p');
    fullEl.className = 'mt-2 hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700';
    date.closest('.grid')!.after(fullEl);
    const fmtD = (d: string) => new Date(d + 'T12:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
    sb.from('blocked_dates').select('day').eq('item_type', 'activity').eq('item_slug', a.slug).gte('day', today).order('day').then(({ data }) => {
      (data ?? []).forEach((x: any) => blocked.add(x.day));
      if (blocked.size) { fullEl.textContent = 'Complet le : ' + [...blocked].slice(0, 8).map(fmtD).join(', ') + (blocked.size > 8 ? '…' : ''); fullEl.classList.remove('hidden'); }
    });
    date.addEventListener('change', () => {
      const err = document.getElementById('err')!;
      if (blocked.has(date.value)) { err.textContent = 'Complet ce jour-là : choisissez une autre date.'; err.classList.remove('hidden'); }
      else err.classList.add('hidden');
    });
    document.getElementById('book')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const err = document.getElementById('err')!;
      if (!optChosen) { err.textContent = 'Veuillez choisir une formule'; err.classList.remove('hidden'); document.getElementById('opt-btn')!.click(); return; }
      if (!date.value) { err.textContent = 'Veuillez sélectionner une date'; err.classList.remove('hidden'); date.focus(); return; }
      if (blocked.has(date.value)) { err.textContent = 'Complet ce jour-là : choisissez une autre date.'; err.classList.remove('hidden'); date.focus(); return; }
      err.classList.add('hidden');
      cart.add({ type: 'activity', slug: a.slug, title: a.title, image: a.image_url, option: opt ? a.options[+opt.value].name : null,
        date: date.value, endDate: null, qty: Math.max(1, +qty.value || 1), qtyLabel: a.qty_label || 'Participants', unitPrice: unit(), priceUnit: a.price_unit });
      document.getElementById('ok')!.classList.remove('hidden');
    });
    document.getElementById('share')!.addEventListener('click', async () => {
      try { if (navigator.share) await navigator.share({ title: a.title, url: location.href }); else { await navigator.clipboard.writeText(location.href); alert('Lien copié !'); } } catch {}
    });
    const { data: rel } = await sb.from('activities').select('*').eq('active', true).neq('slug', a.slug).overlaps('categories', a.categories).limit(8);
    document.getElementById('related')!.innerHTML = ((rel ?? []) as Activity[]).map((r) => activityCard(r, 'w-[78vw] shrink-0 snap-start sm:w-[280px]')).join('');
    paintFavs();
  }
</script>
