---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Mon compte">
  <section class="container-x pb-20 pt-28 sm:pt-32">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div><h1 class="text-3xl font-bold sm:text-4xl">Mon compte</h1><p id="who" class="mt-1 text-muted"></p></div>
      <div class="flex gap-2"><a id="admin" href="/admin/" class="btn-gold hidden !py-2.5">Espace admin</a><button id="logout" class="btn-outline !py-2.5">Se déconnecter</button></div>
    </div>
    <h2 class="mt-10 text-xl font-bold">Mes commandes</h2>
    <div id="orders" class="mt-4 space-y-3"><div class="h-24 animate-pulse rounded-2xl bg-sand"></div></div>
    <h2 class="mt-12 text-xl font-bold">Mes informations</h2>
    <form id="prof" class="mt-4 grid max-w-xl gap-3 sm:grid-cols-2">
      <div><label class="label" for="pn">Nom complet</label><input id="pn" class="field"></div>
      <div><label class="label" for="pp">Téléphone WhatsApp</label><input id="pp" class="field" type="tel"></div>
      <button class="btn-gold !py-2.5 sm:col-span-2 sm:justify-self-start">Enregistrer</button>
      <p id="saved" class="hidden text-sm text-emerald-700 sm:col-span-2">Enregistré ✓</p>
    </form>
  </section>
</Layout>
<script>
  import { sb, getUser, goLogin, isAdmin, esc, aed, url } from '../../lib/app';
  const u = await getUser();
  if (!u) goLogin();
  else if (await isAdmin()) location.replace(url('admin/'));
  else {
    document.getElementById('who')!.textContent = u.email ?? '';
    const { data: p } = await sb.from('profiles').select('*').eq('id', u.id).maybeSingle();
    (document.getElementById('pn') as HTMLInputElement).value = p?.full_name ?? '';
    (document.getElementById('pp') as HTMLInputElement).value = p?.phone ?? '';
    if (p?.is_admin) { const a = document.getElementById('admin') as HTMLAnchorElement; a.href = url('admin/'); a.classList.remove('hidden'); }
    const STATUS: Record<string, string> = { pending: '<span class="text-amber-700">● En attente de confirmation</span>', confirmed: '<span class="text-emerald-700">● Confirmée</span>', cancelled: '<span class="text-red-600">● Annulée</span>', done: '<span class="text-gray-500">● Terminée</span>' };
    const { data: orders } = await sb.from('orders').select('*, order_items(*)').eq('user_id', u.id).order('created_at', { ascending: false });
    document.getElementById('orders')!.innerHTML = (orders ?? []).length ? (orders ?? []).map((o: any) => `
      <div class="rounded-2xl border border-line bg-white p-5">
        <div class="flex flex-wrap items-center justify-between gap-2"><p class="font-semibold">Commande n°${o.id} · ${new Date(o.created_at).toLocaleDateString('fr-FR')}</p><span class="rounded-full bg-sand px-3 py-1 text-sm">${STATUS[o.status] ?? o.status}</span></div>
        <ul class="mt-3 space-y-1 text-sm text-ink-soft">${o.order_items.map((i: any) => `<li>• ${esc(i.item_title)}${i.item_option ? ' (' + esc(i.item_option) + ')' : ''} · ${i.date ?? ''}${i.end_date ? ' → ' + i.end_date : ''}${i.item_type === 'activity' ? ' · ' + i.people + ' pers.' : ''}</li>`).join('')}</ul>
        ${o.total_estimate ? `<p class="mt-2 text-sm">Total estimé : <b>${aed(o.total_estimate)}</b></p>` : ''}
        ${o.admin_note ? `<p class="mt-2 rounded-lg bg-gold-light p-3 text-sm"><b>Message de l’équipe :</b> ${esc(o.admin_note)}</p>` : ''}
      </div>`).join('') : `<p class="rounded-2xl bg-sand p-6 text-muted">Aucune commande pour l'instant. <a class="font-semibold text-gold" href="${url('activites/')}">Découvrir les activités →</a></p>`;
    document.getElementById('prof')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      await sb.from('profiles').update({ full_name: (document.getElementById('pn') as HTMLInputElement).value, phone: (document.getElementById('pp') as HTMLInputElement).value }).eq('id', u.id);
      document.getElementById('saved')!.classList.remove('hidden');
    });
  }
  document.getElementById('logout')!.addEventListener('click', async () => { await sb.auth.signOut(); location.href = url(''); });
</script>
