      const code = v('pcode').toUpperCase().replace(/\s+/g, ''), pct = +v('ppct');
      const err = panel.querySelector('#perr')!;
      if (!code || !pct || pct < 1 || pct > 90) { err.textContent = 'Indiquez un code et une réduction entre 1 et 90 %.'; return; }
      const { error } = await sb.from('promo_codes').insert({ code, percent: pct, expires_on: v('pexp') || null, max_uses: v('pmax') ? +v('pmax') : null });
      if (error) { err.textContent = error.message.includes('duplicate') ? 'Ce code existe déjà.' : error.message; return; }
