    panel.querySelectorAll<HTMLElement>('[data-pdel]').forEach((b) => b.addEventListener('click', async () => { if (confirm('Supprimer ce code ?')) { await sb.from('promo_codes').delete().eq('code', b.dataset.pdel!); showPromos(); } }));
  }

  // ═════════ Statistiques ═════════
  async function showStats() {
    await loadCatalog();
    const since = new Date(Date.now() - 30 * 864e5).toISOString();
    const { data } = await sb.from('visits').select('at,path,item_slug,source,tz').gte('at', since).limit(50000);
    const v = data ?? [];
    const days: Record<string, number> = {};
    for (let i = 29; i >= 0; i--) days[iso(new Date(Date.now() - i * 864e5))] = 0;
    v.forEach((x: any) => { const k = iso(new Date(x.at)); if (k in days) days[k]++; });
    const max = Math.max(1, ...Object.values(days));
    const tally = (f: (x: any) => string | null) => { const o: Record<string, number> = {}; v.forEach((x: any) => { const k = f(x); if (k) o[k] = (o[k] ?? 0) + 1; }); return Object.entries(o).sort((a, b) => b[1] - a[1]); };
    const nameOf = (sl: string) => catalog.find((c) => c.slug === sl)?.name ?? sl;
    const topItems = tally((x) => x.item_slug).slice(0, 8);
    const sources = tally((x) => x.source || 'Direct');
    const regions = tally((x) => (x.tz ? x.tz.replace(/_/g, ' ').split('/').pop() : null)).slice(0, 8);
    const pct = (n: number) => Math.round((n / Math.max(1, v.length)) * 100);
    const bars = (rows: [string, number][], label: (k: string) => string) => rows.length ? rows.map(([k, n]) => `<li><div class="flex justify-between text-sm"><span class="truncate">${esc(label(k))}</span><b>${n}</b></div><div class="mt-1 h-2 rounded-full bg-gray-100"><div class="h-2 rounded-full bg-gold" style="width:${Math.max(3, (n / rows[0][1]) * 100)}%"></div></div></li>`).join('') : '<li class="text-sm text-gray-500">Pas encore de données.</li>';
    panel.innerHTML = `
      <div class="grid grid-cols-2 gap-4 xl:grid-cols-4">
        <div class="stat"><span class="flex items-center gap-1.5">${ap('eye', '#6366f1', 14)} Visites (30 j)</span><b>${v.length}</b><span>pages vues</span></div>
        <div class="stat"><span class="flex items-center gap-1.5">${ap('calendar', '#10b981', 14)} Aujourd’hui</span><b>${days[iso(new Date())] ?? 0}</b><span>pages vues</span></div>
        <div class="stat"><span class="flex items-center gap-1.5">${ap('sunset', '#f59e0b', 14)} Fiches consultées</span><b>${v.filter((x: any) => x.item_slug).length}</b><span>activités et voitures</span></div>
        <div class="stat"><span class="flex items-center gap-1.5">${ap('camera', '#8b5cf6', 14)} Depuis les réseaux</span><b>${pct(v.filter((x: any) => ['Instagram', 'TikTok', 'Facebook', 'Snapchat'].includes(x.source)).length)} %</b><span>Instagram, TikTok…</span></div>
      </div>
      <section class="blk mt-4"><h3>${ap('dashboard', '#0171eb', 16)} Visites par jour</h3>
        <div class="mt-4 flex h-32 items-end gap-1">${Object.entries(days).map(([d, n]) => `<div class="flex-1 rounded-t bg-gold/80 hover:bg-gold" style="height:${Math.max(2, (n / max) * 100)}%" title="${new Date(d + 'T12:00').toLocaleDateString('fr-FR')} : ${n}"></div>`).join('')}</div>
      </section>
      <div class="mt-4 grid gap-4 lg:grid-cols-3">
        <section class="blk"><h3>${ap('fire', '#f97316', 16)} Les plus vues</h3><ul class="mt-3 space-y-3">${bars(topItems, nameOf)}</ul></section>
        <section class="blk"><h3>${ap('link', '#0171eb', 16)} D’où viennent-ils</h3><ul class="mt-3 space-y-3">${bars(sources, (k) => k)}</ul></section>
        <section class="blk"><h3>${ap('globe', '#10b981', 16)} Région (fuseau horaire)</h3><ul class="mt-3 space-y-3">${bars(regions, (k) => k)}</ul></section>
      </div>
      <p class="mt-4 text-xs text-gray-400">Statistiques anonymes : aucune donnée personnelle n’est enregistrée. Pour les pays exacts, activez aussi « Analytics » dans votre projet Vercel.</p>`;
  }

