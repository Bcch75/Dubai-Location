        <button data-go="cars" class="blk flex items-center gap-3 text-left hover:ring-2 hover:ring-gold">${ap('car', '#c9a227', 22)}<span><b class="block">${nCars ?? 0} voitures</b><span class="text-sm text-gray-500">dans la flotte</span></span></button>
        <button data-new="activities" class="blk flex items-center gap-3 text-left hover:ring-2 hover:ring-gold">${ap('plus', '#0171eb', 22)}<span><b class="block">Nouvelle activité</b><span class="text-sm text-gray-500">l’ajouter en 2 minutes</span></span></button>
