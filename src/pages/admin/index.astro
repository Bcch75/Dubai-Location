  // ═════════ Calendrier + dates complètes ═════════
  let calMonth = new Date(); calMonth.setDate(1);
  const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  let catalog: { type: 'activity' | 'car'; slug: string; name: string }[] = [];
  async function loadCatalog() {
    if (catalog.length) return catalog;
    const [{ data: a }, { data: c }] = await Promise.all([sb.from('activities').select('slug,title').order('position'), sb.from('cars').select('slug,brand,model').order('position')]);
    catalog = [...(a ?? []).map((x: any) => ({ type: 'activity' as const, slug: x.slug, name: x.title })), ...(c ?? []).map((x: any) => ({ type: 'car' as const, slug: x.slug, name: `${x.brand} ${x.model}` }))];
    return catalog;
  }
  async function showCalendar() {
    await loadCatalog();
    const y = calMonth.getFullYear(), m = calMonth.getMonth();
    const first = new Date(y, m, 1), last = new Date(y, m + 1, 0);
    const from = iso(first), to = iso(last);
    const [{ data: items }, { data: blocked }] = await Promise.all([
      sb.from('order_items').select('item_title,item_type,date,end_date,people,orders!inner(id,status,contact_name)').lte('date', to).or(`end_date.gte.${from},date.gte.${from}`),
      sb.from('blocked_dates').select('*').gte('day', from).lte('day', to),
    ]);
    const byDay: Record<string, any[]> = {};
    (items ?? []).forEach((it: any) => {
      if (it.orders?.status === 'cancelled') return;
      const start = new Date(it.date + 'T12:00'), end = new Date((it.end_date ?? it.date) + 'T12:00');
      for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) (byDay[iso(d)] ??= []).push(it);
    });
    const bl: Record<string, any[]> = {};
    (blocked ?? []).forEach((b: any) => (bl[b.day] ??= []).push(b));
    const nameOf = (t: string, sl: string) => catalog.find((c) => c.type === t && c.slug === sl)?.name ?? sl;
    const offset = (first.getDay() + 6) % 7; // lundi en premier
    const cells = [...Array(offset).fill(null), ...Array.from({ length: last.getDate() }, (_, i) => new Date(y, m, i + 1))];
    const today = iso(new Date());
    panel.innerHTML = `
      <div class="blk">
        <div class="flex items-center justify-between gap-3">
          <button data-cal="-1" class="btn-outline !px-4 !py-2">‹</button>
          <h3 class="!text-base capitalize">${first.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' })}</h3>
          <button data-cal="1" class="btn-outline !px-4 !py-2">›</button>
        </div>
        <div class="mt-4 grid grid-cols-7 gap-1 text-center text-xs font-semibold text-gray-400">${['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'].map((d) => `<div>${d}</div>`).join('')}</div>
        <div class="mt-1 grid grid-cols-7 gap-1">${cells.map((d) => {
          if (!d) return '<div></div>';
          const k = iso(d), its = byDay[k] ?? [], bls = bl[k] ?? [];
          return `<button data-day="${k}" class="min-h-[74px] rounded-xl border p-1.5 text-left text-[11px] leading-tight transition hover:border-gold ${k === today ? 'border-gold' : 'border-gray-100'} ${bls.length ? 'bg-red-50' : 'bg-white'}">
            <b class="text-sm ${k === today ? 'text-gold' : 'text-ink'}">${d.getDate()}</b>
            ${its.slice(0, 2).map((it: any) => `<span class="mt-0.5 block truncate rounded px-1 ${it.orders.status === 'confirmed' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">${esc(it.item_title)}</span>`).join('')}
            ${its.length > 2 ? `<span class="block text-gray-400">+${its.length - 2}</span>` : ''}
            ${bls.length ? `<span class="mt-0.5 block truncate rounded bg-red-500 px-1 text-white">${bls.length} complet</span>` : ''}
          </button>`;
        }).join('')}</div>
