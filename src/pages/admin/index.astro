      form.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
      form.onclick = (e) => { const t = e.target as HTMLElement; if (t.closest('[data-rm-photo]')) t.closest('.photo')!.remove(); };
      form.querySelector<HTMLInputElement>('[data-upload]')!.addEventListener('change', async (e) => {
        const inp = e.target as HTMLInputElement, raw = inp.files?.[0]; inp.value = ''; if (!raw) return;
        const file = await cropImage(raw, 3 / 4); if (!file) return;
        const path = `site/${Date.now()}-${file.name.replace(/[^\w.-]/g, '_')}`;
        const { error } = await sb.storage.from('images').upload(path, file, { upsert: true });
        if (error) return alert('La photo n’a pas pu être envoyée : ' + error.message);
        form.querySelector('[data-photos="cars_tile"] .photos')!.innerHTML = photoItem(sb.storage.from('images').getPublicUrl(path).data.publicUrl);
      });
      form.onsubmit = async (e) => {
        e.preventDefault();
        const u = form.querySelector<HTMLElement>('[data-photos="cars_tile"] .photo')?.dataset.url ?? '';
        const { data: cur } = await sb.from('settings').select('data').eq('id', 1).maybeSingle();
        await sb.from('settings').upsert({ id: 1, data: { ...((cur?.data as any) ?? {}), cars_tile_image: u || null } });
        dlg.close(); await showCategories(); publishSite(panel.querySelector('#cat-msg'));
      };
      dlg.showModal(); form.scrollTop = 0;
    });
    panel.querySelector('#cat-new')!.addEventListener('click', () => catForm(null, cats.length ? cats[cats.length - 1].position + 10 : 10));
    panel.querySelectorAll<HTMLElement>('.cat-card').forEach((el) => el.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-handle]')) return;
      catForm(cats.find((c: any) => c.slug === el.dataset.slug), 0);
    }));
    const { default: Sortable } = await import('sortablejs');
    Sortable.create(panel.querySelector('#cat-list') as HTMLElement, {
      handle: '[data-handle]', animation: 180, ghostClass: 'opacity-40',
      onEnd: async () => {
        const order = [...panel.querySelectorAll<HTMLElement>('.cat-card')].map((el) => el.dataset.slug!);
        await Promise.all(order.map((slug, i) => sb.from('categories').update({ position: (i + 1) * 10 }).eq('slug', slug)));
        publishSite(panel.querySelector('#cat-msg'));
      },
    });
  }

  // Sélecteur d'icône : recherche + couleur
  function iconPicker(current: string | null, color: string | null) {
    let sel = iconKey(current), col = color || '';
    const box = document.createElement('div');
    const keys = Object.keys(ICON_LIB);
    const draw = (q = '') => {
      const norm = (x: string) => x.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
      const shown = keys.filter((k) => !q || norm(ICON_LIB[k].k).includes(norm(q)));
      box.querySelector('#ip-grid')!.innerHTML = shown.map((k) => `<button type="button" data-ik="${k}" title="${esc(ICON_LIB[k].k.split(' ')[0])}" class="grid aspect-square place-items-center rounded-xl border-2 transition ${k === sel ? 'border-gold bg-blue-50' : 'border-transparent hover:bg-gray-50'}">${pill(k, 20, false, col || '#374151')}</button>`).join('') || '<p class="col-span-full p-4 text-sm text-gray-500">Aucune icône trouvée.</p>';
      box.querySelector('#ip-preview')!.innerHTML = sel ? pill(sel, 26, false, col || null) : '<span class="text-sm text-gray-400">Aucune</span>';
    };
    box.innerHTML = `
      <div class="flex items-center gap-3"><div id="ip-preview"></div><input id="ip-q" class="field !py-2" placeholder="Rechercher"></div>
      <div class="mt-3"><span class="lab">Couleur</span><div id="ip-cols" class="flex flex-wrap gap-2">${['', ...ICON_COLORS].map((c) => `<button type="button" data-ic="${c}" class="h-8 w-8 rounded-full ring-2 ring-offset-2 ${c === col ? 'ring-gold' : 'ring-transparent'}" style="background:${c || 'conic-gradient(#f59e0b,#ef4444,#8b5cf6,#0171eb,#10b981,#f59e0b)'}" title="${c ? c : 'Couleur automatique'}"></button>`).join('')}</div></div>
      <div id="ip-grid" class="mt-3 grid max-h-72 grid-cols-6 gap-1 overflow-y-auto rounded-xl border border-gray-100 p-2 sm:grid-cols-8"></div>`;
    box.querySelector('#ip-q')!.addEventListener('input', (e) => draw((e.target as HTMLInputElement).value));
    box.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const k = t.closest<HTMLElement>('[data-ik]'); if (k) { sel = k.dataset.ik!; draw((box.querySelector('#ip-q') as HTMLInputElement).value); }
      const c = t.closest<HTMLElement>('[data-ic]'); if (c) { col = c.dataset.ic!; box.querySelectorAll('[data-ic]').forEach((x) => x.classList.toggle('ring-gold', x === c)); box.querySelectorAll('[data-ic]').forEach((x) => x.classList.toggle('ring-transparent', x !== c)); draw((box.querySelector('#ip-q') as HTMLInputElement).value); }
    });
    setTimeout(() => draw(), 0);
    return { el: box, value: () => ({ icon: sel, color: col || null }) };
  }

  function catForm(c: any, pos: number) {
    const picker = iconPicker(c?.icon ?? null, c?.icon_color ?? null);
    form.innerHTML = `
      <div class="sticky top-0 z-10 flex items-center justify-between gap-3 border-b border-gray-200 bg-white px-5 py-4">
        <h2 class="text-lg font-bold">${c ? 'Modifier' : 'Ajouter'} une catégorie</h2>
        <div class="flex gap-2"><button type="button" data-close class="btn-outline !px-4 !py-2 text-sm">Annuler</button><button class="btn-gold !px-5 !py-2 text-sm">Enregistrer</button></div>
      </div>
      <div class="space-y-4 p-4 sm:p-5">
        ${block('', 'La catégorie', '', `${input('label', 'Nom', c?.label, 'Ex. Désert')}${input('subtitle', 'Petite phrase', c?.subtitle, 'Ex. Quad, buggy, dîner bédouin…', 'text', '(sous le titre sur l’accueil)')}`)}
        <section class="blk"><h3>Icône</h3><div id="ip-slot" class="mt-4"></div></section>
        ${block('', 'Photo de la tuile', 'Affichée dans « Nos univers » sur l’accueil.', photoBox('main', c?.image_url ? [c.image_url] : [], false))}
        ${block('', 'Affichage', '', toggle('in_menu', 'Dans le menu du haut', c?.in_menu ?? false, '4 catégories maximum dans le menu.') + toggle('on_home', 'Une rangée sur l’accueil', c?.on_home ?? true) + toggle('active', 'Visible', c?.active ?? true))}
        <p id="ferr" class="hidden rounded-xl bg-red-50 p-3 text-sm text-red-700"></p>
        ${c ? `<button type="button" data-delete class="w-full rounded-xl py-3 text-sm font-semibold text-red-600 hover:bg-red-50">Supprimer la catégorie</button>` : ''}
      </div>`;
    form.querySelector('#ip-slot')!.append(picker.el);
    form.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    form.onclick = (e) => { const t = e.target as HTMLElement; if (t.closest('[data-rm-photo]')) t.closest('.photo')!.remove(); };
    form.querySelectorAll<HTMLInputElement>('[data-upload]').forEach((inp) => inp.addEventListener('change', async () => {
      const raw = inp.files?.[0]; inp.value = ''; if (!raw) return;
      const file = await cropImage(raw, 3 / 4); if (!file) return;
      const path = `categories/${Date.now()}-${file.name.replace(/[^\w.-]/g, '_')}`;
      const { error } = await sb.storage.from('images').upload(path, file, { upsert: true });
      if (error) return alert('La photo n’a pas pu être envoyée : ' + error.message);
      form.querySelector('[data-photos="main"] .photos')!.innerHTML = photoItem(sb.storage.from('images').getPublicUrl(path).data.publicUrl);
    }));
    form.querySelector('[data-delete]')?.addEventListener('click', async () => {
      if (!confirm('Supprimer cette catégorie ? Les activités ne sont pas supprimées.')) return;
      await sb.from('categories').delete().eq('slug', c.slug); dlg.close(); await showCategories(); publishSite(panel.querySelector('#cat-msg'));
    });
    form.onsubmit = async (e) => {
      e.preventDefault();
      const v = (k: string) => (form.querySelector<HTMLInputElement>('#f_' + k)?.value || '').trim();
      const chk = (k: string) => (form.querySelector('#f_' + k) as HTMLInputElement).checked;
      const err = form.querySelector('#ferr')!;
      if (!v('label')) { err.textContent = 'Indiquez un nom.'; err.classList.remove('hidden'); return; }
      const ic = picker.value();
      const row = { label: v('label'), icon: ic.icon, icon_color: ic.color, subtitle: v('subtitle') || null, image_url: getPhotos('main')[0] ?? null, in_menu: chk('in_menu'), on_home: chk('on_home'), active: chk('active') };
      const { error } = c ? await sb.from('categories').update(row).eq('slug', c.slug) : await sb.from('categories').insert({ ...row, slug: slugify(v('label')), position: pos });
      if (error) { err.textContent = error.message.includes('duplicate') ? 'Cette catégorie existe déjà.' : error.message; err.classList.remove('hidden'); return; }
      dlg.close(); await showCategories(); publishSite(panel.querySelector('#cat-msg'));
    };
    dlg.showModal();
  }


  // ═════════ Pages de rubriques (téléphone) ═════════
  async function showHub(kind: string) {
    const [{ count: nA }, { count: nC }, { count: nK }, { count: nCl }, { count: nP }] = await Promise.all([
      sb.from('activities').select('id', { count: 'exact', head: true }),
      sb.from('cars').select('id', { count: 'exact', head: true }),
      sb.from('categories').select('slug', { count: 'exact', head: true }),
      sb.from('profiles').select('id', { count: 'exact', head: true }),
      sb.from('promo_codes').select('code', { count: 'exact', head: true }),
    ]);
    const row = (go: string, k: string, c: string, t: string, sub: string) => `<button class="hub-row" data-go="${go}">${ap(k, c, 16)}<span class="acc-t"><b>${t}</b><span class="acc-sum">${sub}</span></span><span class="chev">›</span></button>`;
    const pl = (n: number | null, w: string) => `${n ?? 0} ${w}${(n ?? 0) > 1 ? 's' : ''}`;
    panel.innerHTML = kind === 'hub-catalog'
      ? grp('Catalogue') + row('activities', 'sunset', '#f59e0b', 'Activités', pl(nA, 'activité')) + row('cars', 'car', '#c9a227', 'Voitures', pl(nC, 'voiture')) + row('categories', 'folder', '#8b5cf6', 'Catégories', pl(nK, 'catégorie'))
      : grp('Ventes') + row('calendar', 'calendar', '#10b981', 'Calendrier', 'Réservations et dates complètes') + row('clients', 'users', '#ec4899', 'Clients', pl(nCl, 'compte')) + row('promos', 'tag', '#059669', 'Codes promo', pl(nP, 'code'))
        + grp('Site') + row('stats', 'stats', '#6366f1', 'Statistiques', '30 derniers jours') + row('posts', 'blog', '#0ea5e9', 'Blog', 'Articles de conseils')
        + grp('Compte') + row('account', 'user', '#0ea5e9', 'Mon compte', esc(user?.email ?? '')) + `<a class="hub-row" href="/" target="_blank">${ap('world', '#0171eb', 16)}<span class="acc-t"><b>Voir le site</b><span class="acc-sum">S’ouvre dans un nouvel onglet</span></span><span class="chev">›</span></a>`
        + `<button class="hub-row" data-logout>${ap('logout', '#dc2626', 16)}<span class="acc-t"><b class="!text-red-600">Se déconnecter</b></span></button>`;
    panel.querySelector('[data-logout]')?.addEventListener('click', async () => { await sb.auth.signOut(); location.href = '/'; });
  }

  const paintMe = (name?: string | null) => {
    document.getElementById('me-name')!.textContent = name || user?.email || 'Administrateur';
    document.getElementById('me-initial')!.textContent = (name || user?.email || 'A')[0].toUpperCase();
  };
  async function paintPending() {
    const { count } = await sb.from('orders').select('id', { count: 'exact', head: true }).eq('status', 'pending');
    const b = document.getElementById('pending-badge')!; b.textContent = String(count ?? 0); b.classList.toggle('hidden', !count);
    const bb = document.getElementById('bn-badge'); if (bb) { bb.textContent = String(count ?? 0); bb.classList.toggle('hidden', !count); }
  }

  document.getElementById('logout')?.addEventListener('click', async () => { await sb.auth.signOut(); location.href = '/'; });
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  // Affichage instantané : on remontre la dernière version de la page pendant le chargement
  const snap: Record<string, string> = {};
  const obs = new MutationObserver(() => { panel.classList.remove('stale'); });
  obs.observe(panel, { childList: true, subtree: true });
  const show = (t: string) => {
    if (current && panel.firstElementChild && !panel.classList.contains('stale') && !panel.querySelector('.animate-pulse')) snap[current] = panel.innerHTML;
    if (t !== current) listFilter = 'all';
    current = t;
    tabs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tab === t)));
    document.querySelectorAll<HTMLElement>('[data-bn]').forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.covers ?? '').split(' ').includes(t))));
    window.scrollTo(0, 0);
    document.getElementById('view-title')!.textContent = TITLES[t][0];
    panel.innerHTML = snap[t] ?? '<div class="h-40 animate-pulse rounded-2xl bg-white"></div>';
    obs.takeRecords(); if (snap[t]) panel.classList.add('stale');
    history.replaceState(null, '', '#' + t);
    ({ 'hub-catalog': () => showHub('hub-catalog'), 'hub-more': () => showHub('hub-more'), dashboard: showDashboard, account: showAccount, orders: showOrders, clients: showClients, calendar: showCalendar, categories: showCategories, promos: showPromos, stats: showStats, settings: showSettings } as Record<string, () => void>)[t]?.() ?? showTable(t);
    if (t === 'orders' || t === 'dashboard') paintPending();
  };
  tabs.forEach((b) => b.addEventListener('click', () => show(b.dataset.tab!)));
  document.querySelectorAll<HTMLElement>('[data-bn]').forEach((b) => b.addEventListener('click', () => show(b.dataset.bn!)));
  panel.addEventListener('click', (e) => {
    const g = (e.target as HTMLElement).closest<HTMLElement>('[data-go]'); if (g) show(g.dataset.go!);
    const nw = (e.target as HTMLElement).closest<HTMLElement>('[data-new]'); if (nw) { current = nw.dataset.new!; showTable(current).then(() => openEdit(current, null)); }
  });
  if (await isAdmin()) {
    const { data: me } = await sb.from('profiles').select('full_name').eq('id', user!.id).maybeSingle();
    paintMe(me?.full_name);
    const start = location.hash.slice(1);
    show(TITLES[start] ? start : 'dashboard');
    startLiveAlerts();
  }
</script>
