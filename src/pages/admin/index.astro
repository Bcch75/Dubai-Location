  async function openEdit(tab: string, id: number | null) {
    if (tab === 'activities') await loadCats();
    const F = FORMS[tab];
    const r = id ? rows.find((x) => x.id === id) : {};
    form.innerHTML = `
      <div class="sticky top-0 z-10 flex items-center justify-between gap-3 border-b border-gray-200 bg-white px-5 py-4">
        <h2 class="text-lg font-bold">${id ? 'Modifier' : 'Ajouter'} ${F.name}</h2>
        <div class="flex gap-2"><button type="button" data-close class="btn-outline !px-4 !py-2 text-sm">Annuler</button><button class="btn-gold !px-5 !py-2 text-sm">Enregistrer</button></div>
      </div>
      <div class="space-y-4 p-4 sm:p-5">${F.build(r)}
        <p id="ferr" class="hidden rounded-xl bg-red-50 p-3 text-sm text-red-700"></p>
        ${id ? `<button type="button" data-delete class="w-full rounded-xl py-3 text-sm font-semibold text-red-600 hover:bg-red-50">Supprimer ${F.name}</button>` : ''}
      </div>`;
    form.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    form.querySelector('#add-opt')?.addEventListener('click', () => form.querySelector('#opts')!.insertAdjacentHTML('beforeend', optRow()));
    form.querySelector('#add-extra')?.addEventListener('click', () => form.querySelector('#extras')!.insertAdjacentHTML('beforeend', extraRow()));
    form.onchange = async (e) => {
      const inp = (e.target as HTMLElement).closest<HTMLInputElement>('[data-row-upload]'); if (!inp?.files?.[0]) return;
      const row = inp.closest<HTMLElement>('.opt,.extra')!, raw = inp.files[0], lab = inp.parentElement!; inp.value = '';
      const file = await cropImage(raw, row.classList.contains('opt') ? 1 : 16 / 9); if (!file) return;
      lab.style.opacity = '.4';
      const path = `${tab}/${Date.now()}-${file.name.replace(/[^\w.-]/g, '_')}`;
      const { error } = await sb.storage.from('images').upload(path, file, { upsert: true });
      lab.style.opacity = '';
      if (error) return alert('La photo n’a pas pu être envoyée : ' + error.message);
      row.dataset.img = sb.storage.from('images').getPublicUrl(path).data.publicUrl;
      lab.querySelector('img, svg')?.remove(); lab.insertAdjacentHTML('afterbegin', `<img src="${esc(row.dataset.img)}" class="h-full w-full object-cover" alt="">`);
    };
    form.onclick = (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-rm-opt]')) t.closest('.opt,.extra')!.remove();
      if (t.closest('[data-rm-photo]')) t.closest('.photo')!.remove();
    };
    form.querySelectorAll<HTMLInputElement>('[data-upload]').forEach((inp) => inp.addEventListener('change', async () => {
      const box = form.querySelector<HTMLElement>(`[data-photos="${inp.dataset.upload}"]`)!;
      const grid = box.querySelector('.photos')!;
      const label = inp.parentElement!, txt = label.firstChild!, old = txt.textContent;
      const files = Array.from(inp.files ?? []); inp.value = '';
      for (const raw of files) {
        const file = await cropImage(raw, 4 / 3); if (!file) continue;
        txt.textContent = 'Envoi en cours… ';
        const path = `${tab}/${Date.now()}-${file.name.replace(/[^\w.-]/g, '_')}`;
        const { error } = await sb.storage.from('images').upload(path, file, { upsert: true });
        if (error) { alert('La photo n’a pas pu être envoyée : ' + error.message); continue; }
        const u = sb.storage.from('images').getPublicUrl(path).data.publicUrl;
        if (box.dataset.multiple !== '1') grid.innerHTML = '';
        grid.insertAdjacentHTML('beforeend', photoItem(u));
      }
      txt.textContent = old;
    }));
    form.querySelector('[data-delete]')?.addEventListener('click', async () => {
      if (!confirm(`Supprimer définitivement ${F.name} ?`)) return;
      await sb.from(tab).delete().eq('id', id!); dlg.close(); showTable(tab);
    });
    form.onsubmit = async (e) => {
      e.preventDefault();
      const out = F.read(r);
      const err = form.querySelector('#ferr')!;
      const missing = tab === 'cars' ? (!out.brand || !out.model) : !out.title;
      if (missing) { err.textContent = 'Merci de remplir au moins le nom.'; err.classList.remove('hidden'); return; }
      if (tab === 'activities' && !out.categories.length) { err.textContent = 'Cochez au moins une catégorie.'; err.classList.remove('hidden'); return; }
      const { error } = id ? await sb.from(tab).update(out).eq('id', id) : await sb.from(tab).insert(out);
      if (error) { err.textContent = error.message.includes('duplicate') ? 'Ce nom existe déjà : choisissez un autre nom.' : 'Erreur : ' + error.message; err.classList.remove('hidden'); return; }
      dlg.close(); showTable(tab);
    };
    dlg.showModal();
    form.scrollTop = 0;
  }

