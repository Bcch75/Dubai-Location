        ${kpi('À traiter', String(pending), pending ? 'en attente' : '', 'orders', pending ? 'amber' : '')}
        ${kpi('CA confirmé', aed(ca) || '0 AED', '', '', '', 'à ce jour')}
        ${kpi('Clients', String(nClients ?? 0), (newClients ?? []).length ? `↗ +${(newClients ?? []).length} ce mois` : '', 'clients')}
