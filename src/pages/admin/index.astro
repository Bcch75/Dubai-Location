          ${input('deploy_hook', 'Lien de publication', adm?.deploy_hook, 'https://api.vercel.com/v1/integrations/deploy/…', 'url', '(à créer une seule fois, voir ci-dessous)')}
          `)}
        <div class="sticky bottom-[84px] flex items-center gap-2 rounded-2xl bg-white p-2.5 shadow-lift lg:bottom-4">
          <button class="btn-gold !px-4 !py-2.5 text-sm">Enregistrer</button>
          <button type="button" id="publish-now" class="btn-outline !px-4 !py-2.5 text-sm">Republier</button>
          <span id="set-msg" class="text-sm"></span>
        </div>
      </form>`;
    const f = panel.querySelector('#set-form') as HTMLFormElement;
    const v = (k: string) => (f.querySelector<HTMLInputElement>('#f_' + k)?.value || '').trim();
    // envoi de la photo d'accueil (même composant que le catalogue)
    f.querySelectorAll<HTMLInputElement>('[data-upload]').forEach((inp) => inp.addEventListener('change', async () => {
      const k = inp.dataset.upload!, raw = inp.files?.[0]; inp.value = ''; if (!raw) return;
      const file = await cropImage(raw, k === 'logo' ? 1 : k === 'cars_tile' ? 3 / 4 : 16 / 9, k === 'logo'); if (!file) return;
      const path = `site/${Date.now()}-${file.name.replace(/[^\w.-]/g, '_')}`;
      const { error } = await sb.storage.from('images').upload(path, file, { upsert: true });
      if (error) return alert('La photo n’a pas pu être envoyée : ' + error.message);
      const u = sb.storage.from('images').getPublicUrl(path).data.publicUrl;
      f.querySelector(`[data-photos="${inp.dataset.upload}"] .photos`)!.innerHTML = photoItem(u);
    }));
    f.addEventListener('click', (e) => { const t = e.target as HTMLElement; if (t.closest('[data-rm-photo]')) t.closest('.photo')!.remove(); });
    const msg = f.querySelector('#set-msg')!;
    const publish = async () => {
      const hook = v('deploy_hook');
      if (!hook) { msg.textContent = 'Enregistré ✓ (ajoutez le lien Deploy Hook pour publier automatiquement)'; msg.className = 'text-sm text-amber-700'; return; }
      try { await fetch(hook, { method: 'POST', mode: 'no-cors' }); msg.textContent = ''; msg.className = 'hidden'; }
      catch { msg.textContent = 'Enregistré, mais la publication a échoué : vérifiez le lien.'; msg.className = 'text-sm text-red-600'; }
    };
    f.querySelector('#publish-now')!.addEventListener('click', publish);
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const ph = (k: string) => [...f.querySelectorAll<HTMLElement>(`[data-photos="${k}"] .photo`)].map((p) => p.dataset.url!)[0] ?? '';
      const hero = ph('hero');
      const data = { ...d, whatsapp: v('whatsapp').replace(/\D/g, ''), phone: v('phone'), email: v('email'), hours: v('hours'), hero_title: v('hero_title'), search_placeholder: v('search_placeholder'), hero_image: hero, logo_url: ph('logo'), cars_tile_image: ph('cars_tile'), cars_hero_image: ph('cars_hero') };
      const [{ error: e1 }, { error: e2 }] = await Promise.all([
        sb.from('settings').update({ data }).eq('id', 1),
        sb.from('admin_settings').update({ deploy_hook: v('deploy_hook') || null }).eq('id', 1),
      ]);
      if (e1 || e2) { msg.textContent = 'Erreur : ' + (e1 ?? e2)!.message; msg.className = 'text-sm text-red-600'; return; }
      Object.assign(d, data);
      f.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((x) => (x.open = false));
      window.scrollTo({ top: 0, behavior: 'smooth' });
      await publish();
    });
  }

  // ═════════ Alerte en direct : nouvelle commande ═════════
  function startLiveAlerts() {
    const beep = () => { try { const c = new AudioContext(); const o = c.createOscillator(); const g = c.createGain(); o.connect(g); g.connect(c.destination); o.frequency.value = 880; g.gain.value = 0.08; o.start(); setTimeout(() => { o.frequency.value = 1175; }, 150); setTimeout(() => { o.stop(); c.close(); }, 320); } catch {} };
    sb.channel('admin-orders').on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'orders' }, (payload: any) => {
      const o = payload.new;
      beep(); paintPending();
      document.title = 'Nouvelle commande ! | Dubai Location';
      const t = document.createElement('div');
      t.className = 'fixed right-4 top-24 z-[70] w-80 rounded-2xl bg-white p-4 shadow-lift ring-2 ring-gold';
      t.innerHTML = `<p class="font-bold">Nouvelle réservation n°${o.id}</p><p class="text-sm text-gray-600">${esc(o.contact_name ?? '')} · ${esc(o.contact_phone ?? '')}</p><div class="mt-3 flex gap-2"><button class="btn-gold !px-4 !py-2 text-sm" data-open>Voir</button><button class="btn-outline !px-4 !py-2 text-sm" data-x>Fermer</button></div>`;
      document.body.append(t);
      t.querySelector('[data-open]')!.addEventListener('click', () => { t.remove(); show('orders'); });
      t.querySelector('[data-x]')!.addEventListener('click', () => t.remove());
      if ('Notification' in window && Notification.permission === 'granted') new Notification('Nouvelle réservation n°' + o.id, { body: `${o.contact_name ?? ''} · ${o.contact_phone ?? ''}` });
      if (current === 'dashboard' || current === 'orders') show(current);
    }).subscribe();
    if ('Notification' in window && Notification.permission === 'default') {
      const b = document.createElement('button');
      b.className = 'side mt-2 !bg-amber-50 !text-amber-800';
      b.innerHTML = ap('bell', '#f59e0b', 17) + 'Activer les alertes';
      b.addEventListener('click', async () => { await Notification.requestPermission(); b.remove(); });
      document.querySelector('aside nav')!.append(b);
    }
  }


