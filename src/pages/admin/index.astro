---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Espace admin">
  <section class="container-x pb-20 pt-28 sm:pt-32">
    <div id="deny" class="hidden rounded-2xl bg-sand p-8 text-center"><p class="text-lg font-semibold">Accès réservé à l'administrateur.</p></div>
    <div id="app" class="hidden"><div class="lg:grid lg:grid-cols-[250px_1fr] lg:gap-8">
      <aside class="mb-6 lg:mb-0">
        <div class="lg:sticky lg:top-28">
          <div class="mb-4 hidden items-center gap-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-gray-100 lg:flex">
            <span id="me-initial" class="grid h-11 w-11 place-items-center rounded-full bg-gold text-lg font-bold text-white">A</span>
            <span class="min-w-0"><b id="me-name" class="block truncate text-sm text-ink">Administrateur</b><span class="text-xs text-gray-500">Espace admin</span></span>
          </div>
          <nav class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 lg:mx-0 lg:grid lg:gap-1.5 lg:overflow-visible lg:px-0" aria-label="Espace admin">
            <button class="side" data-tab="dashboard"><span>📊</span>Tableau de bord</button>
            <button class="side" data-tab="account"><span>👤</span>Mon compte</button>
            <button class="side" data-tab="activities"><span>🏜️</span>Catalogue activités</button>
            <button class="side" data-tab="cars"><span>🏎️</span>Catalogue voitures</button>
            <button class="side" data-tab="orders"><span>📋</span>Commandes<em id="pending-badge" class="ml-auto hidden rounded-full bg-red-500 px-2 text-xs font-bold not-italic text-white"></em></button>
            <button class="side" data-tab="clients"><span>👥</span>Clients</button>
            <button class="side" data-tab="posts"><span>📝</span>Blog</button>
            <a class="side" href="/" target="_blank"><span>🌐</span>Voir le site ↗</a>
          </nav>
        </div>
      </aside>
      <div>
        <h1 id="view-title" class="text-3xl font-bold sm:text-4xl">Tableau de bord</h1>
        <p id="view-sub" class="mt-1 text-gray-500"></p>
        <div id="panel" class="mt-6"></div>
      </div>
    </div></div>
  </section>
  <dialog id="dlg" class="m-auto w-[min(760px,96vw)] rounded-2xl bg-sand p-0 backdrop:bg-black/50">
    <form id="edit" class="max-h-[90vh] overflow-y-auto"></form>
  </dialog>
</Layout>

<style is:global>
  .blk { background: #fff; border-radius: 16px; padding: 20px; box-shadow: 0 1px 3px rgb(0 0 0 / 0.06); }
  .blk h3 { font-size: 1.05rem; font-weight: 700; display: flex; align-items: center; gap: 8px; }
  .blk .hint { font-size: 0.85rem; color: #6b7280; margin-top: 2px; }
  .lab { display: block; font-size: 0.9rem; font-weight: 600; color: #111827; margin-bottom: 6px; }
  .lab small { font-weight: 400; color: #9ca3af; }
  .pick { display: inline-flex; align-items: center; gap: 6px; border: 1.5px solid #e5e7eb; border-radius: 999px; padding: 8px 14px; cursor: pointer; font-size: 0.9rem; user-select: none; }
  .pick:has(input:checked) { border-color: #0171eb; background: #eff6ff; color: #0160c9; font-weight: 600; }
  .pick input { position: absolute; opacity: 0; pointer-events: none; }
  .sw { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 0; cursor: pointer; }
  .sw + .sw { border-top: 1px solid #f3f4f6; }
  .sw input { appearance: none; width: 46px; height: 26px; border-radius: 999px; background: #d1d5db; position: relative; flex-shrink: 0; transition: background .2s; cursor: pointer; }
  .sw input::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transition: transform .2s; box-shadow: 0 1px 2px rgb(0 0 0/.2); }
  .sw input:checked { background: #0171eb; }
  .sw input:checked::after { transform: translateX(20px); }
  .drop { border: 2px dashed #d1d5db; border-radius: 14px; padding: 16px; text-align: center; cursor: pointer; color: #6b7280; font-size: 0.9rem; transition: border-color .2s, background .2s; }
  .drop:hover { border-color: #0171eb; background: #f8fbff; }
  .side { display: flex; align-items: center; gap: 10px; white-space: nowrap; border-radius: 14px; padding: 11px 14px; font-size: 0.95rem; font-weight: 600; color: #374151; background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / .05); outline: 1px solid #f3f4f6; text-align: left; transition: all .15s; }
  .side:hover { background: #f8fafc; }
  .side[aria-pressed='true'] { background: #0171eb; color: #fff; outline-color: #0171eb; box-shadow: 0 6px 16px -6px rgb(1 113 235 / .6); }
  .side span { font-size: 1.1rem; }
  .stat { background: #fff; border-radius: 18px; padding: 18px 20px; box-shadow: 0 4px 20px rgb(0 0 0 / .06); }
  .stat b { display: block; font-size: 1.9rem; font-weight: 800; color: #111827; line-height: 1.1; margin-top: 6px; }
  .stat span { font-size: .85rem; color: #6b7280; }
</style>

<script>
  import { sb, isAdmin, getUser, goLogin, esc, aed, img, thumb } from '../../lib/app';
  const user = await getUser();
  if (!user) goLogin();
  else if (!(await isAdmin())) document.getElementById('deny')!.classList.remove('hidden');
  else document.getElementById('app')!.classList.remove('hidden');

  const panel = document.getElementById('panel')!;
  const dlg = document.getElementById('dlg') as HTMLDialogElement;
  const form = document.getElementById('edit') as HTMLFormElement;
  const STATUS: Record<string, string> = { pending: '⏳ En attente', confirmed: '✅ Confirmée', cancelled: '❌ Annulée', done: '🏁 Terminée' };
  const CATS: [string, string][] = [['desert', '🏜️ Désert'], ['mer', '🛥️ Mer & yacht'], ['ciel', '🎈 Dans les airs'], ['incontournables', '🏙️ Incontournables'], ['excursions', '🧭 Excursions'], ['famille', '👨‍👩‍👧 En famille']];
  const CAR_CATS: [string, string][] = [['supercar', 'Supercar'], ['prestige', 'Prestige'], ['suv', 'SUV de luxe'], ['sport', 'Sportive / berline']];
  const UNITS: [string, string, string][] = [['/ pers.', 'Par personne', 'Personnes'], ['/ heure', 'Par heure', 'Heures'], ['', 'Pour le groupe', 'Personnes'], ['/ jour', 'Par jour', 'Jours']];
  const BADGES = ['', 'Populaire', 'Nouveau', 'Coup de cœur', 'Promo', 'Best-seller'];
  const slugify = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

  // ═════════ Réservations ═════════
  async function showOrders() {
    const { data } = await sb.from('orders').select('*, order_items(*)').order('created_at', { ascending: false });
    panel.innerHTML = (data ?? []).length ? (data ?? []).map((o: any) => `
      <div class="blk mb-3">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div><p class="font-semibold">Réservation n°${o.id} · ${esc(o.contact_name)}</p>
          <p class="text-sm text-gray-500">${new Date(o.created_at).toLocaleString('fr-FR')} · <a class="text-gold" href="https://wa.me/${esc((o.contact_phone ?? '').replace(/\D/g, ''))}" target="_blank">📱 ${esc(o.contact_phone)}</a> · ${esc(o.contact_email)}</p></div>
          <select data-status="${o.id}" class="field !w-auto !py-2">${Object.entries(STATUS).map(([k, v]) => `<option value="${k}" ${k === o.status ? 'selected' : ''}>${v}</option>`).join('')}</select>
        </div>
        <ul class="mt-3 space-y-1 text-sm">${o.order_items.map((i: any) => `<li>• <b>${esc(i.item_title)}</b>${i.item_option ? ' (' + esc(i.item_option) + ')' : ''} · ${i.date ?? ''}${i.end_date ? ' → ' + i.end_date : ''}${i.item_type === 'activity' ? ' · ' + i.people + ' pers.' : ''}</li>`).join('')}</ul>
        ${o.total_estimate ? `<p class="mt-2 text-sm">Total estimé : <b>${aed(o.total_estimate)}</b></p>` : ''}
        ${o.notes ? `<p class="mt-2 rounded-lg bg-sand p-2 text-sm">💬 Client : ${esc(o.notes)}</p>` : ''}
        <label class="lab mt-4">Message pour le client <small>(il le voit dans « Mon compte »)</small></label>
        <div class="flex gap-2"><input data-note="${o.id}" class="field !py-2 text-sm" placeholder="Ex. Prise en charge à 15h à votre hôtel. Prix final : 1 200 AED." value="${esc(o.admin_note ?? '')}"><button data-save-note="${o.id}" class="btn-gold !px-4 !py-2 text-sm">Envoyer</button></div>
      </div>`).join('') : '<p class="blk text-gray-500">Aucune réservation pour l’instant.</p>';
  }
  panel.addEventListener('change', async (e) => {
    const s = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-status]');
    if (s) await sb.from('orders').update({ status: s.value }).eq('id', +s.dataset.status!);
  });

  // ═════════ Listes ═════════
  let current = 'orders';
  let rows: any[] = [];
  async function showTable(tab: string) {
    const order = tab === 'posts' ? 'published_at' : 'position';
    const { data } = await sb.from(tab).select('*').order(order, { ascending: tab !== 'posts' });
    rows = data ?? [];
    const name = (r: any) => tab === 'cars' ? `${r.brand} ${r.model}` : r.title;
    const sub = (r: any) => tab === 'activities' ? `${aed(r.price)} ${r.price_unit ?? ''}` : tab === 'cars' ? (r.price_per_day ? aed(r.price_per_day) + ' / jour' : 'Prix sur demande') : new Date(r.published_at).toLocaleDateString('fr-FR');
    const label = tab === 'activities' ? 'une activité' : tab === 'cars' ? 'une voiture' : 'un article';
    panel.innerHTML = `<button data-edit="new" class="btn-gold mb-4">+ Ajouter ${label}</button>` + rows.map((r) => `
      <div class="mb-2 flex items-center gap-4 rounded-2xl bg-white p-3 shadow-sm ring-1 ring-gray-100">
        <img src="${esc(thumb(r.image_url ?? r.cover_url))}" class="h-16 w-24 shrink-0 rounded-xl bg-sand object-cover" alt="">
        <div class="min-w-0 flex-1"><p class="truncate font-semibold">${esc(name(r))}</p><p class="text-sm text-gray-500">${esc(sub(r))}${r.active === false || r.published === false ? ' · <span class="text-red-600">masqué</span>' : ''}${r.featured ? ' · ⭐ populaire' : ''}</p></div>
        <button data-edit="${r.id}" class="btn-outline !px-4 !py-2 text-sm">✏️ Modifier</button>
      </div>`).join('');
  }
  panel.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const n = t.closest<HTMLElement>('[data-save-note]');
    if (n) { const id = n.dataset.saveNote!; await sb.from('orders').update({ admin_note: (panel.querySelector(`[data-note="${id}"]`) as HTMLInputElement).value }).eq('id', +id); n.textContent = '✓ Envoyé'; }
    const ed = t.closest<HTMLElement>('[data-edit]');
    if (ed) openEdit(current, ed.dataset.edit === 'new' ? null : +ed.dataset.edit!);
  });

  // ═════════ Petits composants du formulaire ═════════
  const input = (k: string, label: string, v: unknown, ph = '', type = 'text', hint = '') =>
    `<div><label class="lab" for="f_${k}">${label}${hint ? ` <small>${hint}</small>` : ''}</label><input id="f_${k}" type="${type}" ${type === 'number' ? 'step="any"' : ''} class="field" placeholder="${esc(ph)}" value="${esc(v ?? '')}"></div>`;
  const area = (k: string, label: string, v: unknown, ph = '', rows = 3, hint = '') =>
    `<div><label class="lab" for="f_${k}">${label}${hint ? ` <small>${hint}</small>` : ''}</label><textarea id="f_${k}" rows="${rows}" class="field" placeholder="${esc(ph)}">${esc(v ?? '')}</textarea></div>`;
  const toggle = (k: string, label: string, on: boolean, hint = '') =>
    `<label class="sw"><span><b class="block text-sm">${label}</b>${hint ? `<span class="text-xs text-gray-500">${hint}</span>` : ''}</span><input type="checkbox" id="f_${k}" ${on ? 'checked' : ''}></label>`;
  const picks = (name: string, opts: [string, string][], selected: string[], type = 'checkbox') =>
    `<div class="flex flex-wrap gap-2">${opts.map(([v, l]) => `<label class="pick"><input type="${type}" name="${name}" value="${esc(v)}" ${selected.includes(v) ? 'checked' : ''}>${l}</label>`).join('')}</div>`;
  const block = (icon: string, title: string, hint: string, body: string, open = true) =>
    open ? `<section class="blk"><h3>${icon} ${title}</h3>${hint ? `<p class="hint">${hint}</p>` : ''}<div class="mt-4 space-y-4">${body}</div></section>`
         : `<details class="blk"><summary class="cursor-pointer list-none"><h3>${icon} ${title} <span class="ml-auto text-sm font-normal text-gold">Afficher ▾</span></h3>${hint ? `<p class="hint">${hint}</p>` : ''}</summary><div class="mt-4 space-y-4">${body}</div></details>`;

  // Photos avec aperçu
  const photoBox = (k: string, urls: string[], multiple: boolean) => `
    <div data-photos="${k}" data-multiple="${multiple ? 1 : 0}">
      <div class="photos grid grid-cols-3 gap-2 sm:grid-cols-4">${urls.map((u) => photoItem(u)).join('')}</div>
      <label class="drop mt-2 block">📷 ${multiple ? 'Ajouter des photos' : urls.length ? 'Remplacer la photo' : 'Choisir une photo'} <span class="block text-xs">depuis votre ordinateur ou téléphone</span>
        <input type="file" accept="image/*" ${multiple ? 'multiple' : ''} class="hidden" data-upload="${k}"></label>
    </div>`;
  const photoItem = (u: string) => `<div class="photo group relative" data-url="${esc(u)}"><img src="${esc(img(u))}" class="aspect-[4/3] w-full rounded-lg object-cover" alt=""><button type="button" data-rm-photo class="absolute right-1 top-1 grid h-7 w-7 place-items-center rounded-full bg-white/90 text-sm shadow" aria-label="Retirer">✕</button></div>`;
  const getPhotos = (k: string) => [...form.querySelectorAll<HTMLElement>(`[data-photos="${k}"] .photo`)].map((p) => p.dataset.url!);

  // Formules : lignes à remplir
  const optRow = (o: any = {}) => `<div class="opt grid grid-cols-[1fr_1fr_110px_32px] gap-2"><input class="field !py-2 text-sm" data-o="name" placeholder="Nom (ex. Snow Premium)" value="${esc(o.name ?? '')}"><input class="field !py-2 text-sm" data-o="detail" placeholder="Détail (facultatif)" value="${esc(o.detail ?? '')}"><input class="field !py-2 text-sm" data-o="price" type="number" placeholder="Prix AED" value="${esc(o.price ?? '')}"><button type="button" data-rm-opt class="text-gray-400 hover:text-red-600" aria-label="Retirer">✕</button></div>`;

  // ═════════ Formulaire : Activité ═════════
  function activityForm(r: any) {
    const unit = UNITS.find((u) => u[0] === (r.price_unit ?? ''))?.[0] ?? '/ pers.';
    return [
      block('📝', 'L’essentiel', 'Ce que les clients voient en premier.', [
        input('title', 'Nom de l’activité', r.title, 'Ex. Safari dans le désert en quad'),
        `<div><span class="lab">Catégories <small>(cochez une ou plusieurs)</small></span>${picks('cats', CATS, r.categories ?? [])}</div>`,
        input('tagline', 'Petite phrase sous le titre', r.tagline, 'Ex. 100 % adrénaline sur les dunes dorées de Dubaï.', 'text', '(une ligne)'),
        area('description', 'Description complète', r.description, 'Décrivez l’expérience. Laissez une ligne vide pour faire un nouveau paragraphe.', 6),
      ].join('')),
      block('📸', 'Photos', 'La première photo est celle de la carte. Les autres s’affichent sur la page de l’activité.', [
        `<div><span class="lab">Photo principale</span>${photoBox('main', r.image_url ? [r.image_url] : [], false)}</div>`,
        `<div><span class="lab">Autres photos <small>(facultatif)</small></span>${photoBox('gallery', r.gallery ?? [], true)}</div>`,
      ].join('')),
      block('💰', 'Prix', '', [
        `<div class="grid gap-4 sm:grid-cols-2">${input('price', 'Prix (AED)', r.price, 'Ex. 350', 'number')}${input('old_price', 'Ancien prix barré', r.old_price, 'Ex. 450', 'number', '(seulement pour une promo)')}</div>`,
        `<div><span class="lab">Le prix est…</span>${picks('unit', UNITS.map((u) => [u[0], u[1]] as [string, string]), [unit], 'radio')}</div>`,
        toggle('price_from', 'Afficher « à partir de » devant le prix', r.price_from ?? true, 'À cocher si le prix change selon la formule choisie.'),
      ].join('')),
      block('⏱️', 'Infos pratiques', '', `<div class="grid gap-4 sm:grid-cols-2">${input('duration', 'Durée', r.duration, 'Ex. 2 heures')}${input('location', 'Lieu', r.location, 'Ex. Désert de Dubaï')}</div>`),
      block('✨', 'Mise en avant', 'Pour attirer l’œil sur la carte.', [
        `<div><span class="lab">Étiquette bleue sur la photo</span>${picks('badge', BADGES.map((b) => [b, b || 'Aucune'] as [string, string]), [r.badge ?? ''], 'radio')}</div>`,
        input('perk', 'Avantage en vert', r.perk, 'Ex. Transfert hôtel inclus', 'text', '(facultatif)'),
        `<div class="grid gap-4 sm:grid-cols-2">${input('rating', '⭐ Note sur 5', r.rating, 'Ex. 4.9', 'number', '(vos vrais avis Google)')}${input('reviews_count', 'Nombre d’avis', r.reviews_count, 'Ex. 23', 'number')}</div>`,
        input('video_url', '🎬 Lien d’une vidéo', r.video_url, 'Ex. https://www.instagram.com/reel/…', 'url', '(Instagram ou TikTok, facultatif)'),
      ].join('')),
      block('📋', 'Détails de la page', 'Facultatif : points forts, inclus, formules…', [
        area('highlights', 'Points forts', (r.highlights ?? []).join('\n'), 'Un par ligne, ex. :\nGuide professionnel\nÉquipement fourni', 3),
        `<div class="grid gap-4 sm:grid-cols-2">${area('included', '✅ Inclus', (r.included ?? []).join('\n'), 'Un par ligne', 4)}${area('excluded', '❌ Non inclus', (r.excluded ?? []).join('\n'), 'Un par ligne', 4)}</div>`,
        area('important', '⚠️ Information importante', r.important, 'Ex. Passeport obligatoire.', 2),
        `<div><span class="lab">Formules au choix <small>(ex. Snow Classique, Snow Plus…)</small></span><div id="opts" class="space-y-2">${(r.options ?? []).map(optRow).join('')}</div><button type="button" id="add-opt" class="mt-2 text-sm font-semibold text-gold">+ Ajouter une formule</button></div>`,
      ].join(''), !!r.id && false),
      block('👁️', 'Affichage', '', toggle('active', 'Visible sur le site', r.active ?? true, 'Désactivez pour cacher l’activité sans la supprimer.') + toggle('featured', 'Dans « Les plus populaires »', !!r.featured, 'Affichée en premier sur la page d’accueil.')),
    ].join('');
  }
  function readActivity(r: any) {
    const v = (k: string) => (form.querySelector<HTMLInputElement>('#f_' + k)?.value ?? '').trim();
    const n = (k: string) => (v(k) === '' ? null : +v(k));
    const lines = (k: string) => v(k).split('\n').map((x) => x.trim()).filter(Boolean);
    const checked = (name: string) => [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((i) => i.value);
    const unit = checked('unit')[0] ?? '/ pers.';
    const photos = getPhotos('main');
    return {
      title: v('title'), slug: r.slug || slugify(v('title')), categories: checked('cats'), tagline: v('tagline') || null, description: v('description') || null,
      image_url: photos[0] ?? null, image_alt: v('title'), gallery: getPhotos('gallery'),
      price: n('price') ?? 0, old_price: n('old_price'), price_unit: unit || null, qty_label: UNITS.find((u) => u[0] === unit)?.[2] ?? 'Participants',
      price_from: (form.querySelector('#f_price_from') as HTMLInputElement).checked,
      duration: v('duration') || null, location: v('location') || null, badge: checked('badge')[0] || null, perk: v('perk') || null,
      rating: n('rating'), reviews_count: n('reviews_count'), video_url: v('video_url') || null,
      highlights: lines('highlights'), included: lines('included'), excluded: lines('excluded'), important: v('important') || null,
      options: [...form.querySelectorAll<HTMLElement>('#opts .opt')].map((row) => {
        const g = (k: string) => (row.querySelector<HTMLInputElement>(`[data-o="${k}"]`)!.value || '').trim();
        return { name: g('name'), detail: g('detail') || null, price: g('price') ? +g('price') : null };
      }).filter((o) => o.name),
      active: (form.querySelector('#f_active') as HTMLInputElement).checked, featured: (form.querySelector('#f_featured') as HTMLInputElement).checked,
    };
  }

  // ═════════ Formulaire : Voiture ═════════
  function carForm(r: any) {
    return [
      block('🏎️', 'La voiture', '', `<div class="grid gap-4 sm:grid-cols-2">${input('brand', 'Marque', r.brand, 'Ex. Lamborghini')}${input('model', 'Modèle', r.model, 'Ex. Huracán EVO')}</div>
        <div><span class="lab">Type</span>${picks('ccat', CAR_CATS, [r.category ?? 'supercar'], 'radio')}</div>
        <div class="grid gap-4 sm:grid-cols-2">${input('seats', 'Nombre de places', r.seats, 'Ex. 2', 'number')}${input('engine', 'Moteur', r.engine, 'Ex. V10')}</div>
        ${area('description', 'Description', r.description, 'Facultatif', 3)}`),
      block('📸', 'Photo', '', photoBox('main', r.image_url ? [r.image_url] : [], false)),
      block('💰', 'Prix par jour', 'Laissez vide pour afficher « Prix sur demande ».', `<div class="grid gap-4 sm:grid-cols-2">${input('price_per_day', 'Prix par jour (AED)', r.price_per_day, 'Ex. 2500', 'number')}${input('old_price', 'Ancien prix barré', r.old_price, '', 'number', '(promo)')}</div>`),
      block('✨', 'Mise en avant', '', input('tag', 'Étiquette bleue', r.tag, 'Ex. Best-seller', 'text', '(facultatif)') + input('perk', 'Avantage en vert', r.perk, 'Ex. Livraison hôtel ou aéroport', 'text', '(facultatif)')
        + `<div class="grid gap-4 sm:grid-cols-2">${input('rating', '⭐ Note sur 5', r.rating, 'Ex. 4.9', 'number')}${input('reviews_count', 'Nombre d’avis', r.reviews_count, 'Ex. 12', 'number')}</div>` + input('video_url', '🎬 Lien d’une vidéo', r.video_url, 'https://…', 'url', '(facultatif)')),
      block('👁️', 'Affichage', '', toggle('active', 'Visible sur le site', r.active ?? true)),
    ].join('');
  }
  function readCar(r: any) {
    const v = (k: string) => (form.querySelector<HTMLInputElement>('#f_' + k)?.value ?? '').trim();
    const n = (k: string) => (v(k) === '' ? null : +v(k));
    return {
      brand: v('brand'), model: v('model'), slug: r.slug || slugify(`${v('brand')}-${v('model')}`),
      category: form.querySelector<HTMLInputElement>('input[name="ccat"]:checked')?.value ?? 'supercar',
      seats: n('seats'), engine: v('engine') || null, description: v('description') || null, image_url: getPhotos('main')[0] ?? null,
      price_per_day: n('price_per_day'), old_price: n('old_price'), rating: n('rating'), reviews_count: n('reviews_count'), video_url: v('video_url') || null, tag: v('tag') || null, perk: v('perk') || null,
      active: (form.querySelector('#f_active') as HTMLInputElement).checked,
    };
  }

  // ═════════ Formulaire : Article ═════════
  function postForm(r: any) {
    return [
      block('📝', 'Article', '', input('title', 'Titre', r.title, 'Ex. Que faire à Dubaï en famille ?') + area('excerpt', 'Résumé', r.excerpt, 'Une ou deux phrases', 2) + area('content', 'Texte', r.content, 'Laissez une ligne vide entre les paragraphes. Commencez une ligne par ## pour un sous-titre.', 10)),
      block('📸', 'Image de couverture', '', photoBox('main', r.cover_url ? [r.cover_url] : [], false)),
      block('👁️', 'Affichage', '', toggle('published', 'Publié sur le site', r.published ?? true)),
    ].join('');
  }
  function readPost(r: any) {
    const v = (k: string) => (form.querySelector<HTMLInputElement>('#f_' + k)?.value ?? '').trim();
    return { title: v('title'), slug: r.slug || slugify(v('title')), excerpt: v('excerpt') || null, content: v('content') || null, cover_url: getPhotos('main')[0] ?? null, published: (form.querySelector('#f_published') as HTMLInputElement).checked };
  }

  const FORMS: Record<string, { build: (r: any) => string; read: (r: any) => any; name: string }> = {
    activities: { build: activityForm, read: readActivity, name: 'l’activité' },
    cars: { build: carForm, read: readCar, name: 'la voiture' },
    posts: { build: postForm, read: readPost, name: 'l’article' },
  };

  function openEdit(tab: string, id: number | null) {
    const F = FORMS[tab];
    const r = id ? rows.find((x) => x.id === id) : {};
    form.innerHTML = `
      <div class="sticky top-0 z-10 flex items-center justify-between gap-3 border-b border-gray-200 bg-white px-5 py-4">
        <h2 class="text-lg font-bold">${id ? 'Modifier' : 'Ajouter'} ${F.name}</h2>
        <div class="flex gap-2"><button type="button" data-close class="btn-outline !px-4 !py-2 text-sm">Annuler</button><button class="btn-gold !px-5 !py-2 text-sm">💾 Enregistrer</button></div>
      </div>
      <div class="space-y-4 p-4 sm:p-5">${F.build(r)}
        <p id="ferr" class="hidden rounded-xl bg-red-50 p-3 text-sm text-red-700"></p>
        ${id ? `<button type="button" data-delete class="w-full rounded-xl py-3 text-sm font-semibold text-red-600 hover:bg-red-50">🗑️ Supprimer ${F.name}</button>` : ''}
      </div>`;
    form.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    form.querySelector('#add-opt')?.addEventListener('click', () => form.querySelector('#opts')!.insertAdjacentHTML('beforeend', optRow()));
    form.onclick = (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-rm-opt]')) t.closest('.opt')!.remove();
      if (t.closest('[data-rm-photo]')) t.closest('.photo')!.remove();
    };
    form.querySelectorAll<HTMLInputElement>('[data-upload]').forEach((inp) => inp.addEventListener('change', async () => {
      const box = form.querySelector<HTMLElement>(`[data-photos="${inp.dataset.upload}"]`)!;
      const grid = box.querySelector('.photos')!;
      const label = inp.parentElement!;
      const old = label.innerHTML; label.firstChild!.textContent = '⏳ Envoi en cours… ';
      for (const file of Array.from(inp.files ?? [])) {
        const path = `${tab}/${Date.now()}-${file.name.replace(/[^\w.-]/g, '_')}`;
        const { error } = await sb.storage.from('images').upload(path, file, { upsert: true });
        if (error) { alert('La photo n’a pas pu être envoyée : ' + error.message); continue; }
        const u = sb.storage.from('images').getPublicUrl(path).data.publicUrl;
        if (box.dataset.multiple !== '1') grid.innerHTML = '';
        grid.insertAdjacentHTML('beforeend', photoItem(u));
      }
      label.innerHTML = old;
    }));
    form.querySelector('[data-delete]')?.addEventListener('click', async () => {
      if (!confirm(`Supprimer définitivement ${F.name} ?`)) return;
      await sb.from(tab).delete().eq('id', id!); dlg.close(); showTable(tab);
    });
    form.onsubmit = async (e) => {
      e.preventDefault();
      const out = F.read(r);
      const err = form.querySelector('#ferr')!;
      const missing = tab === 'cars' ? (!out.brand || !out.model) : !out.title;
      if (missing) { err.textContent = 'Merci de remplir au moins le nom.'; err.classList.remove('hidden'); return; }
      if (tab === 'activities' && !out.categories.length) { err.textContent = 'Cochez au moins une catégorie.'; err.classList.remove('hidden'); return; }
      const { error } = id ? await sb.from(tab).update(out).eq('id', id) : await sb.from(tab).insert(out);
      if (error) { err.textContent = error.message.includes('duplicate') ? 'Ce nom existe déjà : choisissez un autre nom.' : 'Erreur : ' + error.message; err.classList.remove('hidden'); return; }
      dlg.close(); showTable(tab);
    };
    dlg.showModal();
    form.scrollTop = 0;
  }

  // ═════════ Tableau de bord ═════════
  const TITLES: Record<string, [string, string]> = {
    dashboard: ['Tableau de bord', 'Un coup d’œil sur votre activité.'],
    account: ['Mon compte', 'Vos informations personnelles et votre mot de passe.'],
    activities: ['Catalogue activités', 'Ajoutez, modifiez ou masquez vos activités.'],
    cars: ['Catalogue voitures', 'Gérez votre flotte et vos prix par jour.'],
    orders: ['Commandes', 'Les réservations envoyées par vos clients.'],
    clients: ['Clients', 'Les personnes qui ont créé un compte.'],
    posts: ['Blog', 'Vos articles de conseils.'],
  };
  const fmtDate = (d: string) => new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });

  async function showDashboard() {
    const [{ data: orders }, { count: nActs }, { count: nCars }, { count: nClients }] = await Promise.all([
      sb.from('orders').select('id,status,total_estimate,created_at,contact_name,order_items(item_title)').order('created_at', { ascending: false }),
      sb.from('activities').select('id', { count: 'exact', head: true }).eq('active', true),
      sb.from('cars').select('id', { count: 'exact', head: true }).eq('active', true),
      sb.from('profiles').select('id', { count: 'exact', head: true }),
    ]);
    const o = orders ?? [];
    const pending = o.filter((x: any) => x.status === 'pending').length;
    const month = new Date().toISOString().slice(0, 7);
    const thisMonth = o.filter((x: any) => x.created_at.startsWith(month));
    const ca = o.filter((x: any) => ['confirmed', 'done'].includes(x.status)).reduce((s: number, x: any) => s + (x.total_estimate ?? 0), 0);
    // nombre de réservations par activité
    const counts: Record<string, number> = {};
    o.forEach((x: any) => x.order_items.forEach((it: any) => (counts[it.item_title] = (counts[it.item_title] ?? 0) + 1)));
    const top = Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, 5);
    panel.innerHTML = `
      <div class="grid grid-cols-2 gap-4 xl:grid-cols-4">
        <button data-go="orders" class="stat text-left ${pending ? 'ring-2 ring-red-400' : ''}"><span>⏳ À traiter</span><b>${pending}</b><span>commande${pending > 1 ? 's' : ''} en attente</span></button>
        <div class="stat"><span>📅 Ce mois-ci</span><b>${thisMonth.length}</b><span>réservation${thisMonth.length > 1 ? 's' : ''}</span></div>
        <div class="stat"><span>💰 Chiffre confirmé</span><b>${aed(ca) || '0 AED'}</b><span>commandes confirmées</span></div>
        <button data-go="clients" class="stat text-left"><span>👥 Clients</span><b>${nClients ?? 0}</b><span>comptes créés</span></button>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <button data-go="activities" class="blk flex items-center gap-3 text-left hover:ring-2 hover:ring-gold"><span class="text-2xl">🏜️</span><span><b class="block">${nActs ?? 0} activités</b><span class="text-sm text-gray-500">visibles sur le site</span></span></button>
        <button data-go="cars" class="blk flex items-center gap-3 text-left hover:ring-2 hover:ring-gold"><span class="text-2xl">🏎️</span><span><b class="block">${nCars ?? 0} voitures</b><span class="text-sm text-gray-500">dans la flotte</span></span></button>
        <button data-new="activities" class="blk flex items-center gap-3 text-left hover:ring-2 hover:ring-gold"><span class="text-2xl">➕</span><span><b class="block">Nouvelle activité</b><span class="text-sm text-gray-500">l’ajouter en 2 minutes</span></span></button>
      </div>
      <div class="mt-6 grid gap-4 xl:grid-cols-[1.5fr_1fr]">
        <section class="blk"><h3>📋 Dernières commandes</h3>
          ${o.length ? `<ul class="mt-3 divide-y divide-gray-100">${o.slice(0, 6).map((x: any) => `<li class="flex items-center justify-between gap-3 py-3 text-sm"><span class="min-w-0"><b>n°${x.id} · ${esc(x.contact_name ?? '')}</b><span class="block truncate text-gray-500">${esc(x.order_items.map((i: any) => i.item_title).join(', '))}</span></span><span class="shrink-0 text-right"><span class="block">${STATUS[x.status] ?? x.status}</span><span class="text-xs text-gray-400">${fmtDate(x.created_at)}</span></span></li>`).join('')}</ul><button data-go="orders" class="mt-2 text-sm font-semibold text-gold">Voir toutes les commandes →</button>` : '<p class="mt-3 text-sm text-gray-500">Aucune commande pour l’instant. Elles apparaîtront ici dès qu’un client réservera.</p>'}
        </section>
        <section class="blk"><h3>🔥 Les plus réservées</h3>
          ${top.length ? `<ol class="mt-3 space-y-2 text-sm">${top.map(([t, n], i) => `<li class="flex justify-between gap-3"><span>${i + 1}. ${esc(t)}</span><b>${n}</b></li>`).join('')}</ol>` : '<p class="mt-3 text-sm text-gray-500">Pas encore de données.</p>'}
        </section>
      </div>`;
  }

  // ═════════ Mon compte ═════════
  async function showAccount() {
    const { data: p } = await sb.from('profiles').select('*').eq('id', user!.id).maybeSingle();
    panel.innerHTML = `
      <form id="acc" class="blk max-w-2xl space-y-4">
        <h3>👤 Mes informations</h3>
        <div class="grid gap-4 sm:grid-cols-2">${input('full_name', 'Nom complet', p?.full_name, 'Votre nom')}${input('phone', 'Téléphone WhatsApp', p?.phone, '+971…', 'tel')}</div>
        <div><span class="lab">Email de connexion</span><p class="rounded-xl bg-sand px-4 py-3 text-sm">${esc(user!.email)}</p></div>
        <button class="btn-gold !py-2.5">💾 Enregistrer</button><span id="acc-ok" class="ml-3 hidden text-sm text-emerald-700">Enregistré ✓</span>
      </form>
      <form id="pwd" class="blk mt-4 max-w-2xl space-y-4">
        <h3>🔒 Changer mon mot de passe</h3>
        ${input('pw1', 'Nouveau mot de passe', '', '6 caractères minimum', 'password')}
        ${input('pw2', 'Confirmer le mot de passe', '', '', 'password')}
        <button class="btn-outline !py-2.5">Changer le mot de passe</button><span id="pwd-msg" class="ml-3 text-sm"></span>
      </form>`;
    panel.querySelector('#acc')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const v = (k: string) => (panel.querySelector<HTMLInputElement>('#f_' + k)!.value || '').trim();
      await sb.from('profiles').update({ full_name: v('full_name'), phone: v('phone') }).eq('id', user!.id);
      panel.querySelector('#acc-ok')!.classList.remove('hidden'); paintMe(v('full_name'));
    });
    panel.querySelector('#pwd')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const a = panel.querySelector<HTMLInputElement>('#f_pw1')!.value, b = panel.querySelector<HTMLInputElement>('#f_pw2')!.value;
      const m = panel.querySelector('#pwd-msg')!;
      if (a.length < 6) { m.textContent = '6 caractères minimum.'; m.className = 'ml-3 text-sm text-red-600'; return; }
      if (a !== b) { m.textContent = 'Les deux mots de passe sont différents.'; m.className = 'ml-3 text-sm text-red-600'; return; }
      const { error } = await sb.auth.updateUser({ password: a });
      m.textContent = error ? 'Erreur : ' + error.message : 'Mot de passe changé ✓'; m.className = 'ml-3 text-sm ' + (error ? 'text-red-600' : 'text-emerald-700');
    });
  }

  // ═════════ Clients ═════════
  async function showClients() {
    const [{ data: people }, { data: orders }] = await Promise.all([
      sb.from('profiles').select('*').order('created_at', { ascending: false }),
      sb.from('orders').select('user_id'),
    ]);
    const n: Record<string, number> = {};
    (orders ?? []).forEach((o: any) => (n[o.user_id] = (n[o.user_id] ?? 0) + 1));
    panel.innerHTML = (people ?? []).length ? `<div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-100"><table class="w-full text-left text-sm">
      <thead class="bg-gray-50 text-xs uppercase text-gray-500"><tr><th class="p-3">Client</th><th class="hidden p-3 sm:table-cell">Contact</th><th class="p-3">Commandes</th><th class="hidden p-3 md:table-cell">Inscrit le</th></tr></thead>
      <tbody class="divide-y divide-gray-100">${(people ?? []).map((p: any) => `<tr>
        <td class="p-3"><b>${esc(p.full_name || '—')}</b>${p.is_admin ? ' <span class="rounded bg-blue-50 px-1.5 text-xs text-gold">admin</span>' : ''}<span class="block text-gray-500 sm:hidden">${esc(p.email ?? '')}</span></td>
        <td class="hidden p-3 sm:table-cell">${esc(p.email ?? '')}${p.phone ? `<br><a class="text-gold" target="_blank" href="https://wa.me/${esc(p.phone.replace(/\D/g, ''))}">📱 ${esc(p.phone)}</a>` : ''}</td>
        <td class="p-3">${n[p.id] ?? 0}</td><td class="hidden p-3 md:table-cell">${fmtDate(p.created_at)}</td></tr>`).join('')}</tbody></table></div>`
      : '<p class="blk text-gray-500">Aucun client pour l’instant.</p>';
  }

  const paintMe = (name?: string | null) => {
    document.getElementById('me-name')!.textContent = name || user?.email || 'Administrateur';
    document.getElementById('me-initial')!.textContent = (name || user?.email || 'A')[0].toUpperCase();
  };
  async function paintPending() {
    const { count } = await sb.from('orders').select('id', { count: 'exact', head: true }).eq('status', 'pending');
    const b = document.getElementById('pending-badge')!; b.textContent = String(count ?? 0); b.classList.toggle('hidden', !count);
  }

  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const show = (t: string) => {
    current = t;
    tabs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tab === t)));
    document.getElementById('view-title')!.textContent = TITLES[t][0];
    document.getElementById('view-sub')!.textContent = TITLES[t][1];
    panel.innerHTML = '<div class="h-40 animate-pulse rounded-2xl bg-white"></div>';
    history.replaceState(null, '', '#' + t);
    ({ dashboard: showDashboard, account: showAccount, orders: showOrders, clients: showClients } as Record<string, () => void>)[t]?.() ?? showTable(t);
    if (t === 'orders' || t === 'dashboard') paintPending();
  };
  tabs.forEach((b) => b.addEventListener('click', () => show(b.dataset.tab!)));
  panel.addEventListener('click', (e) => {
    const g = (e.target as HTMLElement).closest<HTMLElement>('[data-go]'); if (g) show(g.dataset.go!);
    const nw = (e.target as HTMLElement).closest<HTMLElement>('[data-new]'); if (nw) { current = nw.dataset.new!; showTable(current).then(() => openEdit(current, null)); }
  });
  if (await isAdmin()) {
    const { data: me } = await sb.from('profiles').select('full_name').eq('id', user!.id).maybeSingle();
    paintMe(me?.full_name);
    const start = location.hash.slice(1);
    show(TITLES[start] ? start : 'dashboard');
  }
</script>
