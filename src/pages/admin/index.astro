  function dayDetail(day: string, its: any[], bls: any[], nameOf: (t: string, s: string) => string) {
    const box = panel.querySelector('#day-detail')!;
    box.innerHTML = `<div class="blk">
      <h3 class="capitalize">${new Date(day + 'T12:00').toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' })}</h3>
      ${its.length ? `<ul class="mt-3 space-y-1 text-sm">${its.map((it: any) => `<li>• <b>${esc(it.item_title)}</b> · ${esc(it.orders.contact_name ?? '')} · n°${it.orders.id} · ${STATUS[it.orders.status]}${it.item_type === 'activity' ? ' · ' + it.people + ' pers.' : ''}</li>`).join('')}</ul>` : '<p class="mt-2 text-sm text-gray-500">Aucune réservation ce jour-là.</p>'}
      <h4 class="mt-5 font-semibold">Dates complètes</h4>
      ${bls.length ? `<ul class="mt-2 space-y-1 text-sm">${bls.map((b: any) => `<li class="flex items-center justify-between gap-2 rounded-lg bg-red-50 px-3 py-2"><span>${esc(nameOf(b.item_type, b.item_slug))}${b.note ? ' — ' + esc(b.note) : ''}</span><button data-unblock="${b.id}" class="text-sm font-semibold text-red-600">Débloquer</button></li>`).join('')}</ul>` : ''}
      <div class="mt-3 grid gap-2 sm:grid-cols-[1fr_1fr_auto]">
        <select id="blk-item" class="field !py-2 text-sm">${catalog.map((c) => `<option value="${c.type}|${esc(c.slug)}">${c.type === 'car' ? '' : ''} ${esc(c.name)}</option>`).join('')}</select>
        <input id="blk-note" class="field !py-2 text-sm" placeholder="Note (facultatif, ex. yacht déjà loué)">
        <button id="blk-add" class="btn-gold !py-2 text-sm">Marquer complet</button>
      </div>
    </div>`;
    box.querySelector('#blk-add')!.addEventListener('click', async () => {
      const [t, sl] = (box.querySelector('#blk-item') as HTMLSelectElement).value.split('|');
      const { error } = await sb.from('blocked_dates').insert({ item_type: t, item_slug: sl, day, note: (box.querySelector('#blk-note') as HTMLInputElement).value || null });
      if (error && !error.message.includes('duplicate')) return alert(error.message);
      await showCalendar(); panel.querySelector<HTMLElement>(`[data-day="${day}"]`)?.click();
    });
    box.querySelectorAll<HTMLElement>('[data-unblock]').forEach((b) => b.addEventListener('click', async () => {
      await sb.from('blocked_dates').delete().eq('id', +b.dataset.unblock!);
      await showCalendar(); panel.querySelector<HTMLElement>(`[data-day="${day}"]`)?.click();
    }));
    box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ═════════ Codes promo ═════════
  async function showPromos() {
    const { data } = await sb.from('promo_codes').select('*').order('created_at', { ascending: false });
    panel.innerHTML = `
      <form id="promo-new" class="blk">
        <h3>${ap('plus', '#0171eb', 16)} Nouveau code</h3>
        <div class="promo-grid mt-4 grid items-end gap-3 sm:grid-cols-4">
          ${input('pcode', 'Code', '', 'Ex. DUBAI10')}
          ${input('ppct', 'Réduction (%)', '', 'Ex. 10', 'number')}
          ${input('pexp', 'Valable jusqu’au', '', '', 'date', '(facultatif)')}
          ${input('pmax', 'Utilisations max.', '', 'Illimité', 'number', '(facultatif)')}
        </div>
        <button class="btn-gold mt-4 !py-2.5">Créer le code</button><span id="perr" class="ml-3 text-sm text-red-600"></span>
      </form>
      <div class="mt-4 space-y-2">${(data ?? []).map((c: any) => `
        <div class="flex flex-wrap items-center gap-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-gray-100">
          <span class="rounded-lg bg-blue-50 px-3 py-1.5 font-mono font-bold text-gold">${esc(c.code)}</span>
          <b>-${c.percent} %</b>
          <span class="text-sm text-gray-500">${c.uses} utilisation${c.uses > 1 ? 's' : ''}${c.max_uses ? ' / ' + c.max_uses : ''}${c.expires_on ? ' · jusqu’au ' + new Date(c.expires_on + 'T12:00').toLocaleDateString('fr-FR') : ''}</span>
          <label class="sw ml-auto !py-0"><span class="mr-2 text-sm">${c.active ? 'Actif' : 'Désactivé'}</span><input type="checkbox" data-ptoggle="${esc(c.code)}" ${c.active ? 'checked' : ''}></label>
          <button data-pdel="${esc(c.code)}" class="text-sm text-gray-400 hover:text-red-600"></button>
        </div>`).join('') || '<p class="blk text-sm text-gray-500">Aucun code pour l’instant.</p>'}</div>`;
    panel.querySelector('#promo-new')!.addEventListener('submit', async (e) => {
      e.preventDefault();
