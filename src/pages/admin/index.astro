---
import Layout from '../../layouts/Layout.astro';
import { ap, ai } from '../../lib/admin-icons';
---
<Layout title="Espace admin">
  <section class="container-x pb-20 pt-28 sm:pt-32">
    <div id="deny" class="hidden rounded-2xl bg-sand p-8 text-center"><p class="text-lg font-semibold">Accès réservé à l'administrateur.</p></div>
    <div id="app" class="hidden"><div class="lg:grid lg:grid-cols-[250px_1fr] lg:gap-8">
      <aside class="hidden lg:block">
        <div class="lg:sticky lg:top-28">
          <div class="mb-4 hidden items-center gap-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-gray-100 lg:flex">
            <span id="me-initial" class="grid h-11 w-11 place-items-center rounded-full bg-gold text-lg font-bold text-white">A</span>
            <span class="min-w-0"><b id="me-name" class="block truncate text-sm text-ink">Administrateur</b><span class="text-xs text-gray-500">Espace admin</span></span>
          </div>
          <nav class="no-scrollbar -mx-5 flex gap-2 overflow-x-auto px-5 lg:mx-0 lg:grid lg:gap-1.5 lg:overflow-visible lg:px-0" aria-label="Espace admin">
            <button class="side" data-tab="dashboard"><Fragment set:html={ap('dashboard', '#0171eb', 17)} />Tableau de bord</button>
            <button class="side" data-tab="account"><Fragment set:html={ap('user', '#0ea5e9', 17)} />Mon compte</button>
            <button class="side" data-tab="activities"><Fragment set:html={ap('sunset', '#f59e0b', 17)} />Catalogue activités</button>
            <button class="side" data-tab="categories"><Fragment set:html={ap('folder', '#8b5cf6', 17)} />Catégories</button>
            <button class="side" data-tab="cars"><Fragment set:html={ap('car', '#c9a227', 17)} />Catalogue voitures</button>
            <button class="side" data-tab="orders"><Fragment set:html={ap('list', '#0171eb', 17)} />Commandes<em id="pending-badge" class="ml-auto hidden rounded-full bg-red-500 px-2 text-xs font-bold not-italic text-white"></em></button>
            <button class="side" data-tab="clients"><Fragment set:html={ap('users', '#ec4899', 17)} />Clients</button>
            <button class="side" data-tab="calendar"><Fragment set:html={ap('calendar', '#10b981', 17)} />Calendrier</button>
            <button class="side" data-tab="promos"><Fragment set:html={ap('tag', '#059669', 17)} />Codes promo</button>
            <button class="side" data-tab="stats"><Fragment set:html={ap('stats', '#6366f1', 17)} />Statistiques</button>
            <button class="side" data-tab="posts"><Fragment set:html={ap('blog', '#0ea5e9', 17)} />Blog</button>
            <button class="side" data-tab="settings"><Fragment set:html={ap('settings', '#6b7280', 17)} />Réglages du site</button>
            <a class="side" href="/" target="_blank"><Fragment set:html={ap('world', '#0171eb', 17)} />Voir le site ↗</a>
            <button class="side !text-red-600" id="logout"><Fragment set:html={ap('logout', '#dc2626', 17)} />Se déconnecter</button>
          </nav>
        </div>
      </aside>
      <div>
        <h1 id="view-title" class="text-2xl font-bold sm:text-3xl">Tableau de bord</h1>
        <div id="panel" class="mt-6"></div>
      </div>
    </div></div>
    <nav id="admin-bn" class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-5 items-start border-t border-gray-200 bg-white/95 px-1 pb-[max(env(safe-area-inset-bottom),8px)] pt-1.5 backdrop-blur lg:hidden" aria-label="Navigation admin">
      <button class="bn" data-bn="dashboard" data-covers="dashboard"><span class="bn-ic"><Fragment set:html={ai('dashboard', 22)} /></span>Accueil</button>
      <button class="bn" data-bn="orders" data-covers="orders calendar"><span class="bn-ic"><Fragment set:html={ai('list', 22)} /><em id="bn-badge" class="hidden"></em></span>Réservations</button>
      <button class="bn" data-bn="hub-catalog" data-covers="hub-catalog activities cars categories"><span class="bn-ic"><Fragment set:html={ai('catalog', 22)} /></span>Catalogue</button>
      <button class="bn" data-bn="settings" data-covers="settings"><span class="bn-ic"><Fragment set:html={ai('home', 22)} /></span>Apparence</button>
      <button class="bn" data-bn="hub-more" data-covers="hub-more account clients promos stats posts"><span class="bn-ic"><Fragment set:html={ai('user', 22)} /></span>Profil</button>
    </nav>
  </section>
  <dialog id="dlg" class="m-auto w-[min(760px,96vw)] rounded-2xl bg-sand p-0 backdrop:bg-black/50">
    <form id="edit" class="max-h-[90vh] overflow-y-auto"></form>
  </dialog>
</Layout>

<style is:global>
  .blk { background: #fff; border-radius: 16px; padding: 20px; box-shadow: 0 1px 3px rgb(0 0 0 / 0.06); }
  .blk h3 { font-size: 1.05rem; font-weight: 700; display: flex; align-items: center; gap: 8px; }
  .grp-lab { font-size: .68rem; font-weight: 800; letter-spacing: .1em; color: #6b7280; text-transform: uppercase; margin: 22px 4px 10px; }
  .grp-lab:first-child { margin-top: 4px; }
  .acc { padding: 0; border-radius: 20px; box-shadow: 0 1px 2px rgb(0 0 0 / .04); outline: 1px solid #eceff3; }
  .acc > summary > span:first-child, .hub-row > span:first-child { width: 40px !important; height: 40px !important; border-radius: 12px !important; }
  .acc > summary > span:first-child svg, .hub-row > span:first-child svg { width: 19px !important; height: 19px !important; }
  .acc-t { flex: 1; min-width: 0; }
  .acc-t b { display: block; font-size: .92rem; font-weight: 700; color: #111827; }
  .acc-t .acc-sum { display: block; max-width: 100% !important; margin-top: 1px; font-size: .8rem; }
  .hub-row { display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; background: #fff; border-radius: 18px; padding: 12px 14px; outline: 1px solid #eceff3; box-shadow: 0 1px 2px rgb(0 0 0 / .04); margin-bottom: 10px; transition: outline-color .15s; }
  .hub-row:hover { outline-color: #0171eb; }
  .bn { display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 10.5px; font-weight: 600; color: #6b7280; padding: 4px 0; }
  .bn-ic { position: relative; display: grid; place-items: center; width: 56px; height: 32px; border-radius: 12px; transition: background .15s; }
  .bn { min-width: 0; height: 52px; line-height: 1; white-space: nowrap; letter-spacing: -0.01em; }
  .bn-ic { flex-shrink: 0; }
  .bn[aria-pressed='true'] { color: #0171eb; }
  .bn[aria-pressed='true'] .bn-ic { background: #e8f1fe; }
  .bn-ic em.hidden { display: none; }
  .bn-ic em { position: absolute; top: -2px; right: 8px; min-width: 17px; height: 17px; border-radius: 999px; background: #ef4444; color: #fff; font-size: 10px; font-weight: 800; font-style: normal; display: grid; place-items: center; padding: 0 4px; }
  @media (max-width: 1023px) {
    body:has(#admin-bn) a[aria-label="Nous écrire sur WhatsApp"] { display: none; }
    body:has(#admin-bn) footer { padding-bottom: 80px; }
  }
  .acc .acc-sum-old { display: none; }
  .acc > summary { list-style: none; display: flex; align-items: center; gap: 12px; padding: 12px 14px; cursor: pointer; user-select: none; }
  .acc > summary::-webkit-details-marker { display: none; }
  .acc > summary h3 { flex: 1; min-width: 0; margin: 0; }
  .acc .acc-sum { font-size: .85rem; color: #6b7280; max-width: 45%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .acc .chev { color: #9ca3af; font-size: 1.3rem; line-height: 1; transition: transform .2s; }
  .acc[open] .chev { transform: rotate(90deg); }
  .acc > .acc-body { padding: 0 18px 18px; }
  .acc[open] > summary { border-bottom: 1px solid #f3f4f6; margin-bottom: 16px; }
  .row-btn { display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; background: #fff; border-radius: 16px; padding: 10px 14px 10px 10px; box-shadow: 0 1px 3px rgb(0 0 0 / .06); outline: 1px solid #f3f4f6; transition: box-shadow .15s, outline-color .15s; }
  .row-btn:hover { outline-color: #0171eb; box-shadow: 0 6px 18px -8px rgb(1 113 235 / .4); }
  .badge { font-size: .75rem; font-weight: 700; border-radius: 999px; padding: 3px 10px; white-space: nowrap; }
  .blk .hint { font-size: 0.85rem; color: #6b7280; margin-top: 2px; }
  .lab { display: block; font-size: 0.82rem; font-weight: 600; color: #111827; margin-bottom: 6px; }
  .lab small { font-weight: 400; color: #9ca3af; }
  .pick { display: inline-flex; align-items: center; gap: 6px; border: 1.5px solid #e5e7eb; border-radius: 999px; padding: 8px 14px; cursor: pointer; font-size: 0.9rem; user-select: none; }
  .pick:has(input:checked) { border-color: #0171eb; background: #eff6ff; color: #0160c9; font-weight: 600; }
  .pick input { position: absolute; opacity: 0; pointer-events: none; }
  .sw { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 0; cursor: pointer; }
  .sw + .sw { border-top: 1px solid #f3f4f6; }
  .sw input { appearance: none; width: 46px; height: 26px; border-radius: 999px; background: #d1d5db; position: relative; flex-shrink: 0; transition: background .2s; cursor: pointer; }
  .sw input::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transition: transform .2s; box-shadow: 0 1px 2px rgb(0 0 0/.2); }
  .sw input:checked { background: #0171eb; }
  .sw input:checked::after { transform: translateX(20px); }
  .drop { display: inline-block !important; padding: 2px 0; cursor: pointer; color: #0171eb; font-size: .8rem; font-weight: 600; }
  .drop:hover { text-decoration: underline; }
  .photos:empty + .drop { display: block !important; border: 1.5px dashed #d1d5db; border-radius: 12px; padding: 12px; text-align: center; color: #6b7280; }
  .side { display: flex; align-items: center; gap: 10px; white-space: nowrap; border-radius: 12px; padding: 9px 12px; font-size: 0.875rem; font-weight: 600; color: #374151; background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / .05); outline: 1px solid #f3f4f6; text-align: left; transition: all .15s; }
  .side:hover { background: #f8fafc; }
  .side[aria-pressed='true'] { background: #0171eb; color: #fff; outline-color: #0171eb; box-shadow: 0 6px 16px -6px rgb(1 113 235 / .6); }
  .side[aria-pressed='true'] span[style] { background: rgb(255 255 255 / .2) !important; }
  .side[aria-pressed='true'] svg { color: #fff !important; }
  #panel.stale { pointer-events: none; }
  .crop-dlg { margin: auto; width: min(560px, calc(100vw - 16px)); max-width: 100vw; max-height: calc(100dvh - 16px); border-radius: 18px; padding: 0; overflow: hidden; background: #fff; }
  .crop-dlg::backdrop { background: rgb(0 0 0 / .6); }
  .crop-dlg .crop-area { height: min(60dvh, 460px); }
  .crop-chip { border-radius: 999px; border: 1px solid #e5e7eb; padding: 5px 12px; font-size: 12.5px; font-weight: 600; color: #374151; }
  .crop-chip.on { border-color: #0171eb; background: #eff6ff; color: #0171eb; }
  .crop-round .cropper-view-box, .crop-round .cropper-face { border-radius: 50%; }
  [data-photos="logo"] .photos { grid-template-columns: 96px; }
  [data-photos="logo"] .photo img { aspect-ratio: 1; border-radius: 9999px; object-fit: cover; box-shadow: 0 0 0 1px rgb(0 0 0 / .08); }
  .stat { background: #fff; border-radius: 16px; padding: 14px 16px; box-shadow: 0 4px 20px rgb(0 0 0 / .06); }
  .stat b { display: block; font-size: 1.3rem; font-weight: 800; color: #111827; line-height: 1.1; margin-top: 6px; }
  .stat span { font-size: .75rem; color: #6b7280; }
  #app .field { font-size: 14px; padding-top: 9px; padding-bottom: 9px; }
  #app .pick { font-size: .82rem; padding: 6px 12px; }
  #app .blk:not(.acc) { padding: 16px; }
  /* Admin plus compact */
  #app { font-size: 14px; }
  #app .acc > summary, #app .hub-row { padding: 10px 12px !important; gap: 10px !important; }
  #app .acc > summary > span:first-child, #app .hub-row > span:first-child { width: 34px !important; height: 34px !important; border-radius: 10px !important; }
  #app .acc > summary > span:first-child svg, #app .hub-row > span:first-child svg { width: 17px !important; height: 17px !important; }
  #app .acc-t b { font-size: .85rem !important; }
  #app .acc-t .acc-sum { font-size: .74rem !important; }
  #app .acc > .acc-body { padding: 0 12px 12px; }
  #app .acc > .acc-body.space-y-4 > * + * { margin-top: .75rem; }
  #app .grp-lab { margin: 16px 4px 8px; font-size: .62rem; }
  #app .hub-row, #app .acc { margin-bottom: 8px; border-radius: 16px; }
  #app .lab { font-size: .75rem; margin-bottom: 4px; }
  #app .field { padding: 7px 11px; border-radius: 10px; }
  #app .pick { font-size: .75rem; padding: 5px 10px; }
  #app .sw { padding: 8px 0; }
  #app .row-btn { padding: 8px 12px 8px 8px; gap: 10px; }
  #app .row-btn img { height: 44px; width: 60px; }
  #app .side { padding: 7px 10px; font-size: .82rem; }
  #view-title { font-size: 1.2rem !important; }
  .bn { font-size: 10px; } .bn-ic { height: 28px; width: 48px; } .bn-ic svg { width: 20px; height: 20px; }
  #edit .blk { padding: 12px; }
  .promo-grid .field { height: 44px; }
  .promo-grid input[type=date] { min-height: 44px; padding-top: 0; padding-bottom: 0; }
  .day { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; min-width: 46px; height: 58px; border-radius: 14px; background: #fff; outline: 1px solid #eceff3; color: #111827; }
  .day small { font-size: 10px; color: #6b7280; text-transform: capitalize; }
  .day b { font-size: 15px; line-height: 1.1; }
  .day i { width: 5px; height: 5px; border-radius: 50%; background: #f59e0b; }
  .day.on { background: #0171eb; outline-color: #0171eb; color: #fff; }
  .day.on small { color: rgb(255 255 255 / .8); }
  .day.on i { background: #fff; }
</style>

<script>
  import { sb, isAdmin, getUser, goLogin, esc, aed, img, thumb } from '../../lib/app';
  import { ap, ai } from '../../lib/admin-icons';
  import { cropImage } from '../../lib/cropper';
  import { pill, iconKey, ICON_COLORS } from '../../lib/icons';
  import { ICON_LIB } from '../../lib/icon-library';
  const user = await getUser();
  if (!user) goLogin();
  else if (!(await isAdmin())) document.getElementById('deny')!.classList.remove('hidden');
  else document.getElementById('app')!.classList.remove('hidden');

  const panel = document.getElementById('panel')!;
  // Une seule section ouverte à la fois
  document.addEventListener('toggle', (e) => {
    const d = e.target as HTMLDetailsElement;
    if (!d.matches?.('details.acc') || !d.open) return;
    const root = d.closest('form, #panel') ?? document;
    root.querySelectorAll<HTMLDetailsElement>('details.acc[open]').forEach((o) => { if (o !== d && !o.contains(d) && !d.contains(o)) o.open = false; });
    setTimeout(() => { const r = d.getBoundingClientRect(); if (r.top < 70) d.scrollIntoView({ block: 'start', behavior: 'smooth' }); }, 30);
  }, true);
  // Recadrer une photo déjà en place
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const b = t.closest<HTMLElement>('[data-recrop]') ?? (t.matches('.photo > img') ? t.parentElement!.querySelector<HTMLElement>('[data-recrop]') : null); if (!b) return;
    e.preventDefault(); e.stopPropagation();
    const ph = b.closest<HTMLElement>('.photo')!, key = ph.closest<HTMLElement>('[data-photos]')?.dataset.photos ?? '';
    const inCat = !!ph.closest('form')?.querySelector('#ip-slot');
    const ratio = key === 'logo' ? 1 : key === 'hero' || key === 'cars_hero' ? 16 / 9 : key === 'cars_tile' || inCat ? 3 / 4 : 4 / 3;
    b.style.opacity = '.5';
    let raw: File;
    try { const r = await fetch(img(ph.dataset.url!)); const bl = await r.blob(); raw = new File([bl], (ph.dataset.url!.split('/').pop() || 'photo').split('?')[0], { type: bl.type || 'image/jpeg' }); }
    catch { b.style.opacity = ''; return alert('Impossible d’ouvrir cette photo pour la recadrer.'); }
    b.style.opacity = '';
    const file = await cropImage(raw, ratio, key === 'logo'); if (!file) return;
    const path = `recadre/${Date.now()}-${file.name.replace(/[^\w.-]/g, '_')}`;
    const { error } = await sb.storage.from('images').upload(path, file, { upsert: true });
    if (error) return alert('La photo n’a pas pu être envoyée : ' + error.message);
    const u = sb.storage.from('images').getPublicUrl(path).data.publicUrl;
    ph.dataset.url = u; ph.querySelector('img')!.src = u;
  }, true);
  const dlg = document.getElementById('dlg') as HTMLDialogElement;
  const form = document.getElementById('edit') as HTMLFormElement;
  const STATUS: Record<string, string> = { pending: '● En attente', confirmed: '● Confirmée', cancelled: '● Annulée', done: '● Terminée' };
  let CATS: [string, string][] = [];
  const loadCats = async () => { const { data } = await sb.from('categories').select('slug,label,icon,icon_color').order('position'); CATS = (data ?? []).map((c: any) => [c.slug, `<span class="inline-flex items-center gap-1.5">${pill(c.icon, 13, true, c.icon_color)}${esc(c.label)}</span>`]); };
  const CAR_CATS: [string, string][] = [['supercar', 'Supercar'], ['prestige', 'Prestige'], ['suv', 'SUV de luxe'], ['sport', 'Sportive / berline']];
  const UNITS: [string, string, string][] = [['/ pers.', 'Par personne', 'Personnes'], ['/ heure', 'Par heure', 'Heures'], ['', 'Pour le groupe', 'Personnes'], ['/ jour', 'Par jour', 'Jours']];
  const BADGES = ['', 'Populaire', 'Nouveau', 'Coup de cœur', 'Promo', 'Best-seller'];
  const slugify = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

  // ═════════ Réservations ═════════
  let dayFilter = '';
  async function showOrders() {
    const { data } = await sb.from('orders').select('*, order_items(*)').order('created_at', { ascending: false });
    const all = data ?? [];
    const COL: Record<string, string> = { pending: 'bg-amber-50 text-amber-700', confirmed: 'bg-emerald-50 text-emerald-700', done: 'bg-gray-100 text-gray-600', cancelled: 'bg-red-50 text-red-700' };
    const LAB: Record<string, string> = { pending: 'À confirmer', confirmed: 'Confirmée', done: 'Terminée', cancelled: 'Annulée' };
    const fd = (d: string | null) => (d ? new Date(d + 'T12:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }) : '');
    const iso = (d: Date) => d.toISOString().slice(0, 10);
    const today = iso(new Date()), tomorrow = iso(new Date(Date.now() + 864e5)), week = iso(new Date(Date.now() + 7 * 864e5));
    const dayOf = (o: any) => o.order_items.map((i: any) => i.date).filter(Boolean).sort()[0] ?? null;
    const groupOf = (o: any) => {
      if (o.status === 'cancelled') return 'Annulées';
      const d = dayOf(o);
      if (!d) return 'Sans date';
      if (d < today) return o.status === 'done' ? 'Passées' : 'Passées';
      if (d === today) return 'Aujourd’hui';
      if (d === tomorrow) return 'Demain';
      if (d <= week) return 'Cette semaine';
      return 'Plus tard';
    };
    const ORDER = ['Aujourd’hui', 'Demain', 'Cette semaine', 'Plus tard', 'Sans date', 'Passées', 'Annulées'];
    const groups: Record<string, any[]> = {};
    all.forEach((o: any) => (groups[groupOf(o)] ??= []).push(o));
    Object.values(groups).forEach((g) => g.sort((a, b) => String(dayOf(a)).localeCompare(String(dayOf(b)))));
    const iconOf = (o: any) => (o.order_items.some((i: any) => i.item_type === 'car') ? ap('car', '#c9a227', 14) : ap('sunset', '#f59e0b', 14));
    const row = (o: any) => {
      const it = o.order_items[0] ?? {};
      const title = o.order_items.length > 1 ? `${esc(it.item_title)} +${o.order_items.length - 1}` : esc(it.item_title ?? 'Réservation');
      const when = it.end_date ? `${fd(it.date)} → ${fd(it.end_date)}` : fd(it.date);
      return `
      <details class="blk acc mb-2">
        <summary>${iconOf(o)}<span class="acc-t"><b>${title}</b><span class="acc-sum">${esc(o.contact_name ?? 'Client')} · ${when}${it.item_type === 'activity' && it.people ? ' · ' + it.people + ' pers.' : ''}</span></span>
          <span class="badge ${COL[o.status] ?? ''}">${LAB[o.status] ?? o.status}</span></summary>
        <div class="acc-body space-y-3 text-sm">
          ${o.order_items.map((i: any) => `<p><b>${esc(i.item_title)}</b>${i.item_option ? ' · ' + esc(i.item_option) : ''} · ${fd(i.date)}${i.end_date ? ' → ' + fd(i.end_date) : ''}${i.item_type === 'activity' ? ' · ' + i.people + ' pers.' : ''}</p>`).join('')}
          ${o.total_estimate ? `<p class="text-base font-bold">${aed(o.total_estimate)}${o.promo_code ? ` <span class="text-xs font-normal text-gray-500">code ${esc(o.promo_code)}</span>` : ''}</p>` : ''}
          ${o.notes ? `<p class="rounded-lg bg-sand p-2">${esc(o.notes)}</p>` : ''}
          <div class="flex flex-wrap gap-2">
            ${o.contact_phone ? `<a class="btn-wa !px-4 !py-2 text-sm" target="_blank" href="https://wa.me/${esc((o.contact_phone ?? '').replace(/\D/g, ''))}">WhatsApp</a>` : ''}
            ${o.status === 'pending' ? `<button data-set="${o.id}" data-s="confirmed" class="btn-gold !px-4 !py-2 text-sm">Confirmer</button><button data-set="${o.id}" data-s="cancelled" class="btn-outline !px-4 !py-2 text-sm">Refuser</button>` : ''}
            ${o.status === 'confirmed' ? `<button data-set="${o.id}" data-s="done" class="btn-outline !px-4 !py-2 text-sm">Terminée</button><button data-set="${o.id}" data-s="cancelled" class="btn-outline !px-4 !py-2 text-sm">Annuler</button>` : ''}
            ${['done', 'cancelled'].includes(o.status) ? `<button data-set="${o.id}" data-s="pending" class="btn-outline !px-4 !py-2 text-sm">Remettre à confirmer</button>` : ''}
          </div>
          <div class="flex gap-2"><input data-note="${o.id}" class="field !py-2 text-sm" placeholder="Message au client" value="${esc(o.admin_note ?? '')}"><button data-save-note="${o.id}" class="btn-outline !px-4 !py-2 text-sm">Envoyer</button></div>
          <p class="text-xs text-gray-400">n°${o.id} · ${esc(o.contact_email ?? '')}</p>
        </div>
      </details>`;
    };
    // Bande de dates : « Tout » puis les 14 prochains jours
    const covers = (o: any, d: string) => o.order_items.some((i: any) => i.date && i.date <= d && (i.end_date ?? i.date) >= d);
    const days = Array.from({ length: 14 }, (_, k) => new Date(Date.now() + k * 864e5));
    const strip = `<div class="no-scrollbar -mx-5 mb-3 flex gap-2 overflow-x-auto px-5 pb-1 sm:mx-0 sm:px-0">
      <button data-day="" class="day ${dayFilter ? '' : 'on'}"><b>Tout</b><small>${all.filter((o: any) => o.status !== 'cancelled').length}</small></button>
      ${days.map((d) => { const k = iso(d); const n = all.filter((o: any) => o.status !== 'cancelled' && covers(o, k)).length; return `<button data-day="${k}" class="day ${dayFilter === k ? 'on' : ''}"><small>${d.toLocaleDateString('fr-FR', { weekday: 'short' }).replace('.', '')}</small><b>${d.getDate()}</b>${n ? '<i></i>' : '<i class="opacity-0"></i>'}</button>`; }).join('')}
    </div>`;
    if (dayFilter) {
      const list = all.filter((o: any) => o.status !== 'cancelled' && covers(o, dayFilter));
      panel.innerHTML = strip + grp(new Date(dayFilter + 'T12:00').toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' })) + (list.length ? list.map(row).join('') : '<p class="blk text-sm text-gray-500">Aucune réservation ce jour-là.</p>');
    } else panel.innerHTML = strip + (all.length
      ? ORDER.filter((g) => groups[g]?.length).map((g) => g === 'Annulées' || g === 'Passées'
          ? `<details class="mt-4"><summary class="grp-lab cursor-pointer list-none">${g} (${groups[g].length}) ›</summary>${groups[g].map(row).join('')}</details>`
          : grp(g) + groups[g].map(row).join('')).join('')
      : '<p class="blk text-gray-500">Aucune réservation.</p>');
    panel.querySelectorAll<HTMLElement>('[data-day]').forEach((b) => b.addEventListener('click', () => { dayFilter = b.dataset.day!; showOrders(); }));
    panel.querySelectorAll<HTMLElement>('[data-set]').forEach((b) => b.addEventListener('click', async () => { await sb.from('orders').update({ status: b.dataset.s }).eq('id', +b.dataset.set!); paintPending(); showOrders(); }));
  }
  panel.addEventListener('change', async (e) => {
    const s = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-status]');
    if (s) { await sb.from('orders').update({ status: s.value }).eq('id', +s.dataset.status!); paintPending(); showOrders(); }
  });

  // ═════════ Listes ═════════
  let current = 'orders';
  let rows: any[] = [];
  let listFilter = 'all';
  async function showTable(tab: string) {
    const order = tab === 'posts' ? 'published_at' : 'position';
    const { data } = await sb.from(tab).select('*').order(order, { ascending: tab !== 'posts' });
    rows = data ?? [];
    if (tab === 'activities') await loadCats();
    const name = (r: any) => tab === 'cars' ? `${r.brand} ${r.model}` : r.title;
    const sub = (r: any) => tab === 'activities' ? `${aed(r.price)} ${r.price_unit ?? ''}` : tab === 'cars' ? (r.price_per_day ? aed(r.price_per_day) + ' / jour' : 'Prix sur demande') : new Date(r.published_at).toLocaleDateString('fr-FR');
    const hidden = (r: any) => r.active === false || r.published === false;
    const label = tab === 'activities' ? 'une activité' : tab === 'cars' ? 'une voiture' : 'un article';
    const filters: [string, string][] = [['all', 'Tout'], ['visible', 'En ligne'], ['hidden', 'Masqués'], ...(tab === 'activities' ? CATS : [])];
    const nVis = rows.filter((r) => !hidden(r)).length;
    panel.innerHTML = `
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <button data-edit="new" class="btn-gold !py-2.5">+ Ajouter ${label}</button>
        <span class="text-sm text-gray-500">${rows.length} au total · ${nVis} en ligne</span>
      </div>
      <input id="list-q" type="search" class="field mb-3" placeholder="Rechercher…">
      <div class="no-scrollbar -mx-5 mb-4 flex gap-2 overflow-x-auto px-5 sm:mx-0 sm:px-0">${filters.map(([k, l]) => `<button data-lf="${k}" class="chip" aria-pressed="${k === listFilter}">${l}</button>`).join('')}</div>
      <div id="list" class="space-y-2">${rows.map((r) => `
        <button type="button" data-edit="${r.id}" data-q="${esc((name(r) + ' ' + sub(r)).toLowerCase())}" data-st="${hidden(r) ? 'hidden' : 'visible'}" data-cats="${esc((r.categories ?? []).join(' '))}" class="row-btn">
          <img src="${esc(thumb(r.image_url ?? r.cover_url))}" class="h-14 w-20 shrink-0 rounded-xl bg-sand object-cover" alt="">
          <span class="min-w-0 flex-1"><b class="block truncate">${esc(name(r))}</b><span class="text-sm text-gray-500">${esc(sub(r))}</span></span>
          ${hidden(r) ? '<span class="badge bg-red-50 text-red-700">Masqué</span>' : r.featured ? '<span class="badge bg-blue-50 text-blue-700">Populaire</span>' : '<span class="badge bg-emerald-50 text-emerald-700">En ligne</span>'}
          <span class="text-xl text-gray-300">›</span>
        </button>`).join('')}</div>
      <p id="list-empty" class="hidden blk text-sm text-gray-500">Aucun résultat.</p>`;
    const norm = (x: string) => x.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    const apply = () => {
      const q = norm((panel.querySelector('#list-q') as HTMLInputElement).value);
      let n = 0;
      panel.querySelectorAll<HTMLElement>('#list [data-edit]').forEach((el) => {
        const okF = listFilter === 'all' || el.dataset.st === listFilter || (el.dataset.cats ?? '').split(' ').includes(listFilter);
        const ok = okF && (!q || norm(el.dataset.q ?? '').includes(q));
        el.style.display = ok ? '' : 'none'; if (ok) n++;
      });
      panel.querySelector('#list-empty')!.classList.toggle('hidden', n > 0);
    };
    panel.querySelector('#list-q')!.addEventListener('input', apply);
    panel.querySelectorAll<HTMLElement>('[data-lf]').forEach((b) => b.addEventListener('click', () => { listFilter = b.dataset.lf!; panel.querySelectorAll('[data-lf]').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); apply(); }));
    apply();
  }
  panel.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const n = t.closest<HTMLElement>('[data-save-note]');
    if (n) { const id = n.dataset.saveNote!; await sb.from('orders').update({ admin_note: (panel.querySelector(`[data-note="${id}"]`) as HTMLInputElement).value }).eq('id', +id); n.textContent = '✓ Envoyé'; }
    const ed = t.closest<HTMLElement>('[data-edit]');
    if (ed) openEdit(current, ed.dataset.edit === 'new' ? null : +ed.dataset.edit!);
  });

  // ═════════ Petits composants du formulaire ═════════
  const input = (k: string, label: string, v: unknown, ph = '', type = 'text', hint = '') =>
    `<div><label class="lab" for="f_${k}">${label}</label><input id="f_${k}" type="${type}" ${type === 'number' ? 'step="any"' : ''} class="field"  value="${esc(v ?? '')}"></div>`;
  const area = (k: string, label: string, v: unknown, ph = '', rows = 3, hint = '') =>
    `<div><label class="lab" for="f_${k}">${label}</label><textarea id="f_${k}" rows="${rows}" class="field" >${esc(v ?? '')}</textarea></div>`;
  const toggle = (k: string, label: string, on: boolean, hint = '') =>
    `<label class="sw"><span><b class="block text-sm">${label}</b></span><input type="checkbox" id="f_${k}" ${on ? 'checked' : ''}></label>`;
  const picks = (name: string, opts: [string, string][], selected: string[], type = 'checkbox') =>
    `<div class="flex flex-wrap gap-2">${opts.map(([v, l]) => `<label class="pick"><input type="${type}" name="${name}" value="${esc(v)}" ${selected.includes(v) ? 'checked' : ''}>${l}</label>`).join('')}</div>`;
  const block = (icon: string, title: string, hint: string, body: string, open = true) =>
    open ? `<section class="blk"><h3>${icon}${title}</h3><div class="mt-4 space-y-4">${body}</div></section>`
         : `<details class="blk"><summary class="cursor-pointer list-none"><h3>${icon}${title} <span class="ml-auto text-sm font-normal text-gold">Afficher ▾</span></h3>${hint ? `<p class="hint">${hint}</p>` : ''}</summary><div class="mt-4 space-y-4">${body}</div></details>`;

  /** Section repliable : titre + résumé quand elle est fermée */
  const sec = (icon: string, title: string, summary: string, body: string, open = false) =>
    `<details class="blk acc mb-3" ${open ? 'open' : ''}><summary>${icon}<span class="acc-t"><b>${title}</b>${summary ? `<span class="acc-sum">${summary}</span>` : ''}</span><span class="chev">›</span></summary><div class="acc-body space-y-4">${body}</div></details>`;
  const grp = (label: string) => `<p class="grp-lab">${label}</p>`;

  // Photos avec aperçu
  const photoBox = (k: string, urls: string[], multiple: boolean) => `
    <div data-photos="${k}" data-multiple="${multiple ? 1 : 0}">
      <div class="photos grid grid-cols-3 gap-2 sm:grid-cols-4">${urls.map((u) => photoItem(u)).join('')}</div>
      <label class="drop mt-2 block">${multiple ? 'Ajouter des photos' : urls.length ? 'Remplacer la photo' : 'Choisir une photo'}
        <input type="file" accept="image/*" ${multiple ? 'multiple' : ''} class="hidden" data-upload="${k}"></label>
    </div>`;
  const photoItem = (u: string) => `<div class="photo group relative" data-url="${esc(u)}"><img src="${esc(img(u))}" class="aspect-[4/3] w-full cursor-pointer rounded-lg object-cover" alt="" title="Toucher pour recadrer"><button type="button" data-rm-photo class="absolute right-1 top-1 grid h-7 w-7 place-items-center rounded-full bg-white/95 text-gray-700 shadow hover:text-red-600" aria-label="Retirer"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button><button type="button" data-recrop class="absolute bottom-1 left-1 flex h-7 items-center gap-1 rounded-full bg-white/95 px-2 text-[11px] font-semibold text-gray-700 shadow" aria-label="Recadrer"><svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 2v14a2 2 0 0 0 2 2h14M2 6h14a2 2 0 0 1 2 2v14"/></svg>Recadrer</button></div>`;
  const getPhotos = (k: string) => [...form.querySelectorAll<HTMLElement>(`[data-photos="${k}"] .photo`)].map((p) => p.dataset.url!);

  // Formules : lignes à remplir
  const X_ICON = '<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>';
  const picBtn = (u: string | null | undefined) => `<label class="relative grid h-12 w-12 shrink-0 cursor-pointer place-items-center overflow-hidden rounded-lg bg-gray-100 text-gray-400" title="Photo">${u ? `<img src="${esc(img(u))}" class="h-full w-full object-cover" alt="">` : ap('camera', '#9ca3af', 18)}<input type="file" accept="image/*" class="hidden" data-row-upload></label>`;
  const optRow = (o: any = {}) => `<div class="opt space-y-2 rounded-xl border border-gray-200 p-3" data-img="${esc(o.image ?? '')}">
    <div class="flex items-center gap-2">${picBtn(o.image)}<input class="field !py-2 text-sm" data-o="name" placeholder="Nom" value="${esc(o.name ?? '')}"><button type="button" data-rm-opt class="grid h-8 w-8 shrink-0 place-items-center text-gray-400 hover:text-red-600" aria-label="Retirer">${X_ICON}</button></div>
    <div class="grid grid-cols-[1fr_90px_64px] gap-2"><input class="field !py-2 text-sm" data-o="group" placeholder="Groupe" value="${esc(o.group ?? '')}"><input class="field !py-2 text-sm" data-o="price" type="number" placeholder="Prix" value="${esc(o.price ?? '')}"><input class="field !py-2 text-sm" data-o="people" type="number" placeholder="Pers." value="${esc(o.people ?? '')}"></div>
    <input class="field !py-2 text-sm" data-o="detail" placeholder="Détail" value="${esc(o.detail ?? '')}">
    <input class="field !py-2 text-sm" data-o="durations" placeholder="Durées : 30 min = 180 ; 1 h = 320" value="${esc((o.durations ?? []).map((d: any) => `${d.label} = ${d.price}`).join(' ; '))}">
  </div>`;
  const extraRow = (o: any = {}) => `<div class="extra space-y-2 rounded-xl border border-gray-200 p-3" data-img="${esc(o.image ?? '')}">
    <div class="flex items-center gap-2">${picBtn(o.image)}<input class="field !py-2 text-sm" data-o="name" placeholder="Nom" value="${esc(o.name ?? '')}"><input class="field !w-24 shrink-0 !py-2 text-sm" data-o="price" type="number" placeholder="Prix" value="${esc(o.price ?? '')}"><button type="button" data-rm-opt class="grid h-8 w-8 shrink-0 place-items-center text-gray-400 hover:text-red-600" aria-label="Retirer">${X_ICON}</button></div>
    <textarea class="field resize-none !py-2 text-sm" rows="2" data-o="detail" placeholder="Description">${esc(o.detail ?? '')}</textarea>
  </div>`;

  // ═════════ Formulaire : Activité ═════════
  function activityForm(r: any) {
    const unit = UNITS.find((u) => u[0] === (r.price_unit ?? ''))?.[0] ?? '/ pers.';
    const isNew = !r.id;
    const nPhotos = (r.image_url ? 1 : 0) + (r.gallery ?? []).length;
    const nOpts = (r.options ?? []).length;
    const flags = [r.active === false ? 'Masquée' : 'Visible', r.featured ? 'Populaire' : '', r.badge ?? ''].filter(Boolean).join(' · ');
    return [
      grp('Informations') + sec(ap('blog', '#0ea5e9', 16), 'L’essentiel', `${aed(r.price ?? 0)} ${r.price_unit ?? ''}`, [
        input('title', 'Nom', r.title, 'Ex. Safari dans le désert en quad'),
        `<div><span class="lab">Catégories</span>${picks('cats', CATS, r.categories ?? [])}</div>`,
        `<div class="grid gap-4 sm:grid-cols-2">${input('price', 'Prix (AED)', r.price, 'Ex. 350', 'number')}<div><span class="lab">Le prix est…</span>${picks('unit', UNITS.map((u) => [u[0], u[1]] as [string, string]), [unit], 'radio')}</div></div>`,
        `<div class="grid gap-4 sm:grid-cols-2">${input('duration', 'Durée', r.duration, 'Ex. 2 heures')}${input('location', 'Lieu', r.location, 'Ex. Désert de Dubaï')}</div>`,
        input('tagline', 'Sous-titre', r.tagline, 'Ex. 100 % adrénaline sur les dunes dorées.'),
      ].join(''), true),
      sec(ap('camera', '#8b5cf6', 16), 'Photos', nPhotos ? `${nPhotos} photo${nPhotos > 1 ? 's' : ''}` : 'Aucune photo', [
        `<div><span class="lab">Photo principale</span>${photoBox('main', r.image_url ? [r.image_url] : [], false)}</div>`,
        `<div><span class="lab">Autres photos</span>${photoBox('gallery', r.gallery ?? [], true)}</div>`,
      ].join(''), isNew),
      sec(ap('list', '#0171eb', 16), 'Description et détails', r.description ? 'Rempli' : 'À compléter', [
        area('description', 'Description', r.description, 'Laissez une ligne vide pour un nouveau paragraphe.', 5),
        area('highlights', 'Points forts', (r.highlights ?? []).join('\n'), 'Un par ligne', 3),
        `<div class="grid gap-4 sm:grid-cols-2">${area('included', 'Inclus', (r.included ?? []).join('\n'), 'Un par ligne', 3)}${area('excluded', 'Non inclus', (r.excluded ?? []).join('\n'), 'Un par ligne', 3)}</div>`,
        area('important', 'Important', r.important, 'Ex. Passeport obligatoire.', 2),
      ].join('')),
      grp('Vente et affichage') + sec(ap('tag', '#0171eb', 16), 'Formules', nOpts ? `${nOpts} formule${nOpts > 1 ? 's' : ''}` : 'Aucune',
        `<div id="opts" class="space-y-2">${(r.options ?? []).map(optRow).join('')}</div><button type="button" id="add-opt" class="text-sm font-semibold text-gold">+ Ajouter une formule</button>`),
      sec(ap('clock', '#0d9488', 16), 'Horaires et options en plus', [(r.time_slots ?? []).length ? `${r.time_slots.length} horaires` : 'Horaires libres', (r.extras ?? []).length ? `${r.extras.length} option${r.extras.length > 1 ? 's' : ''}` : ''].filter(Boolean).join(' · '), [
        input('time_slots', 'Horaires de départ', (r.time_slots ?? []).join(', '), '09:00, 09:30, 10:00'),
        `<div><span class="lab">Options en plus</span><div id="extras" class="space-y-2">${(r.extras ?? []).map(extraRow).join('')}</div><button type="button" id="add-extra" class="mt-2 text-sm font-semibold text-gold">+ Ajouter une option</button></div>`,
      ].join('')),
      sec(ap('eye', '#6366f1', 16), 'Affichage et mise en avant', flags, [
        toggle('active', 'Visible', r.active ?? true) + toggle('featured', 'Populaire', !!r.featured),
        `<div><span class="lab">Étiquette</span>${picks('badge', BADGES.map((b) => [b, b || 'Aucune'] as [string, string]), [r.badge ?? ''], 'radio')}</div>`,
        input('perk', 'Avantage', r.perk, 'Ex. Transfert hôtel inclus', 'text', '(facultatif)'),
        `<details class="rounded-xl bg-sand/60 p-3"><summary class="cursor-pointer text-sm font-semibold text-gray-600">Options avancées</summary><div class="mt-3 space-y-4">
          ${toggle('price_from', '« À partir de »', r.price_from ?? true)}
          <div class="grid gap-4 sm:grid-cols-3">${input('old_price', 'Prix barré (promo)', r.old_price, '', 'number')}${input('rating', 'Note /5', r.rating, 'Ex. 4.9', 'number')}${input('reviews_count', 'Nombre d’avis', r.reviews_count, '', 'number')}</div>
          ${input('video_url', 'Lien vidéo', r.video_url, 'https://…', 'url')}
        </div></details>`,
      ].join('')),
    ].join('');
  }
  function readActivity(r: any) {
    const v = (k: string) => (form.querySelector<HTMLInputElement>('#f_' + k)?.value ?? '').trim();
    const n = (k: string) => (v(k) === '' ? null : +v(k));
    const lines = (k: string) => v(k).split('\n').map((x) => x.trim()).filter(Boolean);
    const checked = (name: string) => [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((i) => i.value);
    const unit = checked('unit')[0] ?? '/ pers.';
    const photos = getPhotos('main');
    return {
      title: v('title'), slug: r.slug || slugify(v('title')), categories: checked('cats'), tagline: v('tagline') || null, description: v('description') || null,
      image_url: photos[0] ?? null, image_alt: v('title'), gallery: getPhotos('gallery'),
      price: n('price') ?? 0, old_price: n('old_price'), price_unit: unit || null, qty_label: UNITS.find((u) => u[0] === unit)?.[2] ?? 'Participants',
      price_from: (form.querySelector('#f_price_from') as HTMLInputElement).checked,
      duration: v('duration') || null, location: v('location') || null, badge: checked('badge')[0] || null, perk: v('perk') || null,
      rating: n('rating'), reviews_count: n('reviews_count'), video_url: v('video_url') || null,
      highlights: lines('highlights'), included: lines('included'), excluded: lines('excluded'), important: v('important') || null,
      options: [...form.querySelectorAll<HTMLElement>('#opts .opt')].map((row) => {
        const g = (k: string) => (row.querySelector<HTMLInputElement>(`[data-o="${k}"]`)!.value || '').trim();
        const durations = g('durations').split(/[;\n]+/).map((x) => { const i = x.lastIndexOf('='); return i > 0 ? { label: x.slice(0, i).trim(), price: +x.slice(i + 1).replace(/[^\d.]/g, '') } : null; }).filter((d): d is { label: string; price: number } => !!d && !!d.label && d.price > 0);
        return { name: g('name'), detail: g('detail') || null, price: g('price') ? +g('price') : null, group: g('group') || null, people: g('people') ? +g('people') : null, image: row.dataset.img || null, durations };
      }).filter((o) => o.name),
      extras: [...form.querySelectorAll<HTMLElement>('#extras .extra')].map((row) => {
        const g = (k: string) => (row.querySelector<HTMLInputElement>(`[data-o="${k}"]`)!.value || '').trim();
        return { name: g('name'), detail: g('detail') || null, price: +g('price') || 0, image: row.dataset.img || null };
      }).filter((o) => o.name),
      time_slots: v('time_slots').split(/[,;\s]+/).map((t) => t.trim().replace('h', ':').replace(/^(\d):/, '0$1:')).filter((t) => /^\d{2}:\d{2}$/.test(t)),
      active: (form.querySelector('#f_active') as HTMLInputElement).checked, featured: (form.querySelector('#f_featured') as HTMLInputElement).checked,
    };
  }

  // ═════════ Formulaire : Voiture ═════════
  function carForm(r: any) {
    const flags = [r.active === false ? 'Masquée' : 'Visible', r.tag ?? ''].filter(Boolean).join(' · ');
    return [
      grp('La voiture') + sec(ap('car', '#c9a227', 16), 'L’essentiel', r.price_per_day ? aed(r.price_per_day) + ' / jour' : 'Prix sur demande', [
        `<div class="grid gap-4 sm:grid-cols-2">${input('brand', 'Marque', r.brand, 'Ex. Lamborghini')}${input('model', 'Modèle', r.model, 'Ex. Huracán EVO')}</div>`,
        `<div><span class="lab">Type</span>${picks('ccat', CAR_CATS, [r.category ?? 'supercar'], 'radio')}</div>`,
        input('price_per_day', 'Prix / jour (AED)', r.price_per_day, 'Vide = « Prix sur demande »', 'number'),
        `<div><span class="lab">Photo</span>${photoBox('main', r.image_url ? [r.image_url] : [], false)}</div>`,
      ].join(''), true),
      sec(ap('list', '#0171eb', 16), 'Caractéristiques', [r.seats ? r.seats + ' places' : '', r.engine ?? ''].filter(Boolean).join(' · ') || 'À compléter', [
        `<div class="grid gap-4 sm:grid-cols-2">${input('seats', 'Nombre de places', r.seats, 'Ex. 2', 'number')}${input('engine', 'Moteur', r.engine, 'Ex. V10')}</div>`,
        area('description', 'Description', r.description, 'Facultatif', 3),
      ].join('')),
      grp('Affichage') + sec(ap('eye', '#6366f1', 16), 'Affichage et mise en avant', flags, [
        toggle('active', 'Visible', r.active ?? true),
        `<div class="grid gap-4 sm:grid-cols-2">${input('tag', 'Étiquette', r.tag, 'Ex. Best-seller')}${input('perk', 'Avantage', r.perk, 'Ex. Livraison hôtel')}</div>`,
        `<details class="rounded-xl bg-sand/60 p-3"><summary class="cursor-pointer text-sm font-semibold text-gray-600">Options avancées</summary><div class="mt-3 space-y-4">
