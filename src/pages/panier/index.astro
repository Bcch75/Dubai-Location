---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Panier">
  <section class="container-x pb-20 pt-28 sm:pt-32">
    <h1 class="text-3xl font-bold sm:text-4xl">Mon panier</h1>
    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_380px]">
      <div id="items" class="space-y-3"></div>
      <aside id="checkout" class="hidden lg:sticky lg:top-28 lg:self-start">
        <form id="form" class="rounded-2xl border border-line bg-white p-5 shadow-soft">
          <div class="flex gap-2">
            <input id="promo" class="field !py-2.5 uppercase" placeholder="Code promo" autocomplete="off">
            <button type="button" id="promo-apply" class="btn-outline shrink-0 !px-4 !py-2.5 text-sm">Appliquer</button>
          </div>
          <p id="promo-msg" class="mt-1.5 hidden text-sm"></p>
          <div id="discount-row" class="mt-4 hidden items-center justify-between text-sm text-emerald-700"><span id="discount-label"></span><span id="discount-val"></span></div>
          <div class="mt-3 flex items-center justify-between border-t border-line pt-3"><span class="text-muted">Total estimé</span><span id="total" class="text-2xl font-bold"></span></div>
          <p class="mt-1 text-xs text-muted">Aucun paiement maintenant : le prix final vous est confirmé avant la prestation.</p>
          <div id="login-needed" class="mt-5 hidden rounded-xl bg-sand p-4 text-sm">Connectez-vous pour valider votre réservation.<a id="login-link" class="btn-gold mt-3 w-full !py-2.5">Se connecter / créer un compte</a></div>
          <div id="fields" class="mt-5 hidden space-y-3">
            <div><label class="label" for="name">Nom complet</label><input id="name" class="field" required autocomplete="name"></div>
            <div><label class="label" for="phone">Téléphone WhatsApp</label><input id="phone" class="field" required type="tel" autocomplete="tel" placeholder="+33 6 12 34 56 78"></div>
            <div><label class="label" for="notes">Hôtel, remarques (facultatif)</label><textarea id="notes" rows="2" class="field resize-none"></textarea></div>
            <button class="w-full rounded-xl bg-gold py-3.5 font-semibold text-white hover:bg-gold-deep">Valider ma réservation</button>
            <p id="err" class="hidden text-sm text-red-600"></p>
          </div>
        </form>
      </aside>
    </div>
  </section>
</Layout>
<script>
  import { sb, cart, esc, aed, img, url, getUser, nights, waLink } from '../../lib/app';
  const fmt = (d: string | null) => (d ? new Date(d + 'T12:00').toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' }) : '');
  const items = document.getElementById('items')!;
  let promo: { code: string; pct: number } | null = null;
  const render = () => {
    const list = cart.get();
    document.getElementById('checkout')!.classList.toggle('hidden', !list.length);
    if (!list.length) { items.innerHTML = `<div class="rounded-2xl bg-sand p-10 text-center"><p class="text-lg font-semibold">Votre panier est vide</p><a href="${url('activites/')}" class="btn-gold mt-5">Découvrir les activités</a></div>`; return; }
    items.innerHTML = list.map((i) => `
      <div class="flex gap-4 rounded-2xl border border-line bg-white p-3">
        <img src="${esc(img(i.image))}" alt="" class="h-24 w-28 shrink-0 rounded-xl object-cover">
        <div class="min-w-0 flex-1">
          <p class="font-semibold">${esc(i.title)}</p>
          ${i.option ? `<p class="text-sm text-muted">${esc(i.option)}</p>` : ''}
          <p class="text-sm text-muted">${i.type === 'car' ? `Du ${fmt(i.date)} au ${fmt(i.endDate)} · ${nights(i)} j` : `${fmt(i.date)} · ${i.qty} ${esc(i.qtyLabel.toLowerCase())}`}</p>
          <p class="mt-1 font-semibold">${i.unitPrice ? aed(i.unitPrice * (i.type === 'car' ? nights(i) : i.qty)) : 'Prix sur demande'}</p>
        </div>
        <button data-rm="${i.key}" class="self-start text-sm text-muted hover:text-red-600" aria-label="Retirer">✕</button>
      </div>`).join('');
    const sub = cart.total(), disc = promo ? Math.round((sub * promo.pct) / 100) : 0;
    document.getElementById('discount-row')!.classList.toggle('hidden', !promo); document.getElementById('discount-row')!.classList.toggle('flex', !!promo);
    if (promo) { document.getElementById('discount-label')!.textContent = `Code ${promo.code} (-${promo.pct} %)`; document.getElementById('discount-val')!.textContent = '-' + aed(disc); }
    document.getElementById('total')!.textContent = aed(sub - disc) + (list.some((i) => !i.unitPrice) ? ' + sur demande' : '');
  };
  items.addEventListener('click', (e) => { const k = (e.target as HTMLElement).closest<HTMLElement>('[data-rm]')?.dataset.rm; if (k) { cart.remove(k); render(); } });
  render();
  document.getElementById('promo-apply')!.addEventListener('click', async () => {
    const code = (document.getElementById('promo') as HTMLInputElement).value.trim().toUpperCase();
    const m = document.getElementById('promo-msg')!;
    if (!code) return;
    const { data: pct } = await sb.rpc('check_promo', { p_code: code });
    if (pct) { promo = { code, pct }; m.textContent = `Code appliqué : -${pct} % ✓`; m.className = 'mt-1.5 text-sm text-emerald-700'; }
    else { promo = null; m.textContent = 'Ce code n’est pas valide ou a expiré.'; m.className = 'mt-1.5 text-sm text-red-600'; }
    render();
  });
  const u = await getUser();
  if (!u) {
    document.getElementById('login-needed')!.classList.remove('hidden');
    (document.getElementById('login-link') as HTMLAnchorElement).href = url('connexion/?next=' + encodeURIComponent(location.pathname));
  } else {
    document.getElementById('fields')!.classList.remove('hidden');
    const { data: p } = await sb.from('profiles').select('full_name,phone').eq('id', u.id).maybeSingle();
    (document.getElementById('name') as HTMLInputElement).value = p?.full_name ?? '';
    (document.getElementById('phone') as HTMLInputElement).value = p?.phone ?? '';
  }
  document.getElementById('form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const user = await getUser(); if (!user) return;
    const list = cart.get(); if (!list.length) return;
    const v = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
    const err = document.getElementById('err')!;
    const btn = (e.target as HTMLFormElement).querySelector('button')!; btn.disabled = true; btn.textContent = 'Envoi…';
    const { data: order, error } = await sb.from('orders').insert({ user_id: user.id, contact_name: v('name'), contact_phone: v('phone'), contact_email: user.email, notes: v('notes') || null, total_estimate: (cart.total() - (promo ? Math.round((cart.total() * promo.pct) / 100) : 0)) || null, promo_code: promo?.code ?? null, discount_percent: promo?.pct ?? null }).select('id').single();
    if (error || !order) { err.textContent = 'Erreur : ' + (error?.message ?? 'inconnue'); err.classList.remove('hidden'); btn.disabled = false; btn.textContent = 'Valider ma réservation'; return; }
    const { error: e2 } = await sb.from('order_items').insert(list.map((i) => ({ order_id: order.id, item_type: i.type, item_slug: i.slug, item_title: i.title, item_option: i.option, date: i.date, end_date: i.endDate, people: i.qty, unit_price: i.unitPrice, price_label: i.priceUnit })));
    if (e2) { err.textContent = 'Erreur : ' + e2.message; err.classList.remove('hidden'); btn.disabled = false; return; }
    await sb.rpc('finalize_order', { p_order: order.id });
    await sb.from('profiles').update({ full_name: v('name'), phone: v('phone') }).eq('id', user.id);
    const recap = `Bonjour Dubai Location 👋 Je viens de faire la réservation n°${order.id} sur le site :\n` + list.map((i) => `• ${i.title}${i.option ? ' (' + i.option + ')' : ''} : ${i.type === 'car' ? `du ${i.date} au ${i.endDate}` : `${i.date}, ${i.qty} ${i.qtyLabel.toLowerCase()}`}`).join('\n') + `\nNom : ${v('name')}`;
    cart.clear();
    document.querySelector('main section')!.innerHTML = `<div class="mx-auto max-w-xl rounded-3xl bg-sand p-8 text-center"><div class="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-emerald-100 text-emerald-600"><svg viewBox="0 0 24 24" class="h-9 w-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></div><h1 class="mt-3 text-3xl font-bold">Réservation envoyée !</h1><p class="mt-3 text-muted">Votre demande n°<b>${order.id}</b> est enregistrée. Nous vous confirmons la disponibilité et le prix très vite.</p><a href="${waLink(recap)}" target="_blank" rel="noopener" class="btn-wa mt-6">Accélérer sur WhatsApp</a><a href="${url('compte/')}" class="mt-4 block font-semibold text-gold">Voir mes commandes →</a></div>`;
  });
</script>
