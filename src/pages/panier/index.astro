---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Panier">
  <section class="container-x pb-20 pt-24 sm:pt-32">
    <h1 class="text-[24px] font-extrabold text-ink sm:text-4xl">Mon panier</h1>
    <p id="count" class="mt-1 text-[18px] text-gray-500"></p>
    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_400px] lg:items-start">
      <div id="items" class="space-y-6"></div>
      <aside id="recap" class="hidden lg:sticky lg:top-28">
        <div class="rounded-[28px] bg-white p-6 shadow-[0_10px_40px_-12px_rgb(15_27_61/0.18)] sm:p-7">
          <h2 class="text-[18px] font-extrabold text-ink">Récapitulatif</h2>
          <div class="mt-4 space-y-3 text-[14px]">
            <p class="flex justify-between"><span class="text-gray-600">Sous-total</span><b id="sub" class="font-bold text-ink"></b></p>
            <p id="disc-row" class="hidden justify-between text-emerald-600"><span id="disc-l"></span><b id="disc"></b></p>
            <p class="flex justify-between text-[14px]"><span class="text-gray-600">Articles</span><span id="n" class="text-ink"></span></p>
          </div>
          <details class="mt-5 group">
            <summary class="cursor-pointer list-none text-[14px] font-medium text-sky-500">Vous avez un code promo ?</summary>
            <div class="mt-3 flex gap-2">
              <input id="promo" class="h-12 min-w-0 flex-1 rounded-xl border border-gray-300 px-4 text-base uppercase outline-none focus:border-sky-400" placeholder="Code promo" autocomplete="off">
              <button type="button" id="promo-apply" class="h-12 shrink-0 rounded-xl bg-gray-100 px-4 font-semibold text-ink">Appliquer</button>
            </div>
            <p id="promo-msg" class="mt-2 hidden text-sm"></p>
          </details>
          <div class="my-6 border-t border-gray-200"></div>
          <p class="flex items-center justify-between"><span class="text-[15px] text-gray-700">Total</span><b id="total" class="text-[19px] font-extrabold text-ink"></b></p>
          <div class="my-6 border-t border-gray-200"></div>
          <button type="button" id="go" class="h-12 w-full rounded-2xl bg-[#38b2f5] text-[16px] font-medium text-white">Passer la réservation</button>
          <a href="/activites/" class="mt-6 block text-center text-[15px] font-medium text-sky-500">Continuer mes achats</a>
          <div class="my-6 border-t border-gray-200"></div>
          <p class="flex gap-3 text-[14px] text-gray-600"><svg viewBox="0 0 24 24" class="h-6 w-6 shrink-0 text-emerald-600" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2 2 4-4"/></svg>Aucun paiement en ligne : vous réglez après confirmation sur WhatsApp. Vos données sont protégées.</p>
        </div>
      </aside>
    </div>
    <section id="recos-wrap" class="mt-16 hidden"><h2 class="text-[22px] font-extrabold text-ink">D'après vos dernières recherches</h2><div id="recos" class="no-scrollbar -mx-5 mt-5 flex snap-x scroll-px-5 gap-6 overflow-x-auto px-5 pb-6 pt-1 sm:mx-0 sm:px-0"></div></section>
  </section>

  <dialog id="checkout" class="sheet">
    <form id="form" class="p-6">
      <div class="flex items-center justify-between"><h3 class="text-[17px] font-extrabold text-ink">Vos coordonnées</h3><button type="button" data-x class="grid h-10 w-10 place-items-center rounded-full bg-gray-100 text-gray-600" aria-label="Fermer"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
      <div class="mt-5 space-y-4">
        <div><label class="mb-1.5 block text-[14px] font-bold text-ink" for="name">Nom complet</label><input id="name" required autocomplete="name" class="h-11 w-full rounded-[14px] border border-gray-300 px-4 text-base outline-none focus:border-sky-400"></div>
        <div><label class="mb-1.5 block text-[14px] font-bold text-ink" for="phone">Téléphone WhatsApp</label><input id="phone" required type="tel" autocomplete="tel" placeholder="+33 6 12 34 56 78" class="h-11 w-full rounded-[14px] border border-gray-300 px-4 text-base outline-none focus:border-sky-400"></div>
        <div><label class="mb-1.5 block text-[14px] font-bold text-ink" for="notes">Hôtel, remarques <span class="font-normal text-gray-400">(facultatif)</span></label><textarea id="notes" rows="2" class="w-full resize-none rounded-[14px] border border-gray-300 px-4 py-3 text-base outline-none focus:border-sky-400"></textarea></div>
      </div>
      <button id="send" class="mt-6 h-12 w-full rounded-2xl bg-[#38b2f5] text-[15px] font-medium text-white">Confirmer ma réservation</button>
      <p id="err" class="mt-2 hidden text-center text-sm text-red-600"></p>
    </form>
  </dialog>
</Layout>
<style is:global>
  dialog.sheet { margin: auto auto 12px; width: calc(100% - 24px); max-width: 480px; max-height: calc(100dvh - 40px); border-radius: 28px; padding: 0; }
  dialog.sheet::backdrop { background: rgb(15 23 42 / .45); }
  @media (min-width: 640px) { dialog.sheet { margin: auto; } }
</style>
<script>
  import { sb, cart, esc, aed, img, url, getUser, nights, waLink, lineTotal, cachedActivities, activityCard, paintFavs, type CartItem } from '../../lib/app';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const S = (d: string, c = 'h-6 w-6') => `<svg viewBox="0 0 24 24" class="${c} shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
  const P = {
    ticket: '<path d="M15 5v2m0 4v2m0 4v2M5 5h14a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3a2 2 0 0 0 0-4V7a2 2 0 0 1 2-2"/>',
    clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>', people: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6.5 6.5 0 0 1 3.5 5.5"/>',
    layers: '<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>', ok: '<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>',
    plus: '<circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/>', pen: '<path d="M4 20h4L19 9l-4-4L4 16z"/>',
    trash: '<path d="M4 7h16M10 11v6M14 11v6M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/>', car: '<path d="M5 16V11l2-5h10l2 5v5"/><path d="M3 16h18v2a1 1 0 0 1-1 1h-2v-3M6 19H4a1 1 0 0 1-1-1v-2"/>',
  };
  const star = '<svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="currentColor"><path d="m12 2.5 2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z"/></svg>';
  const cap = (s: string) => s.replace(/^./, (c) => c.toUpperCase());
  const long = (d: string | null, y = false) => (d ? new Date(d + 'T12:00').toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', ...(y ? { year: 'numeric' } : {}) }) : '');
  const shortD = (d: string | null) => (d ? new Date(d + 'T12:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }) : '');
  const qLabel = (i: CartItem) => { const l = i.qtyLabel.toLowerCase(); return `${i.qty} ${i.qty > 1 ? l : l.replace(/s$/, '')}`; };
  let promo: { code: string; pct: number } | null = null;
  const hasExtras = (slug: string) => !!cachedActivities().find((a) => a.slug === slug)?.extras?.some((x) => x.name);

  const card = (i: CartItem) => {
    const isCar = i.type === 'car';
    const link = url(`${isCar ? 'voiture' : 'activite'}/?s=${encodeURIComponent(i.slug)}`);
    const line = (icon: string, t: string, cls = 'text-[15px] font-extrabold text-[#0f1b3d]') => `<p class="flex gap-4">${S(icon, 'h-6 w-6 text-[#0f1b3d]')}<span class="${cls}">${t}</span></p>`;
    return `<article class="rounded-[28px] border border-gray-200 bg-white p-5 sm:p-6">
      ${i.image ? `<a href="${link}"><img src="${esc(img(i.image))}" alt="" class="h-44 w-full rounded-2xl object-cover sm:h-56"></a>` : ''}
      <p class="mt-5 text-[15px] text-gray-600">${isCar ? `Du ${shortD(i.date)} au ${shortD(i.endDate)}` : cap(long(i.date))}</p>
      <a href="${link}" class="mt-1 block text-[18px] font-extrabold leading-tight text-ink">${esc(i.title)}</a>
      ${i.rating ? `<p class="mt-2 flex items-center gap-1 text-[15px]"><span class="flex gap-1 text-ink">${star.repeat(5)}</span><span class="ml-1 font-medium">${Number(i.rating).toFixed(1)}</span>${i.reviews ? `<span class="text-gray-400">(${i.reviews})</span>` : ''}</p>` : ''}
      <div class="mt-4 space-y-4">
        ${i.tagline ? line(P.ticket, esc(i.tagline)) : ''}
        ${isCar ? line(P.car, `${nights(i)} jour${nights(i) > 1 ? 's' : ''} de location`) : line(P.clock, `${long(i.date, true)}${i.time ? ' · ' + esc(i.time) : ''}`)}
        ${isCar ? '' : line(P.people, esc(qLabel(i)))}
      </div>
      ${i.option || i.extras?.length || i.unitPrice ? `<div class="mt-5 border-t border-gray-200 pt-5">
        <p class="flex items-center gap-3">${S(P.layers, 'h-6 w-6 text-sky-500')}<b class="text-[15px] font-extrabold text-ink">Formules choisies</b></p>
        <div class="mt-3 space-y-2 pl-9">
          <p class="flex items-start justify-between gap-3 text-[14px]"><span class="min-w-0 text-gray-600">${esc(i.option ?? i.title)}${i.duration ? ' · ' + esc(i.duration) : ''}<br><span class="text-gray-400">${isCar ? `${nights(i)} j × ${aed(i.unitPrice)}` : `${i.qty} × ${aed(i.unitPrice)} · ${shortD(i.date)}${i.time ? ' · ' + esc(i.time) : ''}`}</span></span><span class="shrink-0 font-medium text-ink">${i.unitPrice ? aed(i.unitPrice * (isCar ? nights(i) : i.qty)) : 'Sur demande'}</span></p>
          ${(i.extras ?? []).map((x) => `<p class="flex items-start justify-between gap-3 text-[14px]"><span class="text-gray-600">+ ${esc(x.name)}<br><span class="text-gray-400">${x.qty} × ${aed(x.price)}</span></span><span class="shrink-0 font-medium text-ink">${aed(x.price * x.qty)}</span></p>`).join('')}
        </div></div>` : ''}
      <p class="mt-5 flex gap-4">${S(P.ok, 'h-6 w-6 text-emerald-600')}<span class="text-[15px] font-extrabold text-[#0f1b3d]">Annulation gratuite jusqu'à 24h avant</span></p>
      ${isCar || !hasExtras(i.slug) ? '' : `<div class="mt-5 border-t border-gray-200 pt-5"><a href="${link}&edit=${i.key}&opts=1" class="inline-flex items-center gap-2.5 text-[15px] font-medium text-sky-500">${S(P.plus, 'h-6 w-6')}Ajouter des options</a></div>`}
      <div class="mt-5 flex items-center gap-5">
        <a href="${link}${isCar ? '' : `&edit=${i.key}`}" class="inline-flex h-12 items-center gap-2.5 rounded-full border-2 border-[#0f1b3d] px-6 text-[15px] font-extrabold text-[#0f1b3d]">${S(P.pen, 'h-5 w-5')}Modifier</a>
        <button type="button" data-rm="${i.key}" class="grid h-11 w-11 place-items-center rounded-full text-[#0f1b3d] hover:bg-red-50 hover:text-red-600" aria-label="Retirer du panier">${S(P.trash, 'h-6 w-6')}</button>
        <b class="ml-auto whitespace-nowrap text-[16px] font-extrabold text-[#e5283a]">${lineTotal(i) ? aed(lineTotal(i)) : 'Sur demande'}</b>
      </div>
    </article>`;
  };

  const render = () => {
    const list = cart.get();
    $('count').textContent = `${list.length} article${list.length > 1 ? 's' : ''}`;
    $('recap').classList.toggle('hidden', !list.length);
    if (!list.length) {
      $('items').innerHTML = `<div class="py-12 text-center"><div class="mx-auto grid h-24 w-24 place-items-center rounded-full bg-gray-100 text-gray-400"><svg viewBox="0 0 24 24" class="h-11 w-11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/><path d="M2.5 3.5h2.6l2.4 12h11.6l2-8.5H6.2"/></svg></div><p class="mt-8 text-[20px] font-extrabold text-ink">Votre panier est vide</p><p class="mt-3 text-[15px] text-gray-600">Ajoutez une activité pour réserver.</p><a href="${url('activites/')}" class="mt-7 inline-flex h-12 items-center rounded-xl bg-[#38b2f5] px-6 text-[15px] font-medium text-white">Découvrir nos activités</a></div>`;
      return;
    }
    $('items').innerHTML = list.map(card).join('');
    const sub = cart.total(), disc = promo ? Math.round((sub * promo.pct) / 100) : 0;
    $('sub').textContent = aed(sub);
    $('n').textContent = String(list.length);
    $('disc-row').classList.toggle('hidden', !promo); $('disc-row').classList.toggle('flex', !!promo);
    if (promo) { $('disc-l').textContent = `Code ${promo.code} (-${promo.pct} %)`; $('disc').textContent = '-' + aed(disc); }
    $('total').textContent = aed(sub - disc) + (list.some((i) => !i.unitPrice) ? ' +' : '');
  };
  $('items').addEventListener('click', (e) => {
    const rm = (e.target as HTMLElement).closest<HTMLElement>('[data-rm]')?.dataset.rm;
    if (rm) { cart.remove(rm); render(); }
  });
  render();

  // Recommandations
  try {
    const seen: string[] = JSON.parse(localStorage.getItem('dl-seen') || '[]');
    const inCart = new Set(cart.get().map((i) => i.slug));
    const acts = cachedActivities();
    const pick = [...seen.map((s) => acts.find((a) => a.slug === s)).filter(Boolean), ...acts.filter((a) => a.featured)].filter((a, i, arr) => a && !inCart.has(a.slug) && arr.indexOf(a) === i).slice(0, 8) as typeof acts;
    if (pick.length) { $('recos').innerHTML = pick.map((a) => activityCard(a, 'w-[78vw] max-w-[300px] shrink-0 snap-start sm:w-[280px]')).join(''); $('recos-wrap').classList.remove('hidden'); paintFavs(); }
  } catch {}

  $('promo-apply').addEventListener('click', async () => {
    const code = ($<HTMLInputElement>('promo')).value.trim().toUpperCase();
    const m = $('promo-msg');
    if (!code) return;
    const { data: pct } = await sb.rpc('check_promo', { p_code: code });
    if (pct) { promo = { code, pct }; m.textContent = `Code appliqué : -${pct} % ✓`; m.className = 'mt-2 text-sm text-emerald-700'; }
    else { promo = null; m.textContent = 'Ce code n’est pas valide ou a expiré.'; m.className = 'mt-2 text-sm text-red-600'; }
    render();
  });

  // Validation
  const dlg = $<HTMLDialogElement>('checkout');
  dlg.querySelector('[data-x]')!.addEventListener('click', () => dlg.close());
  $('go').addEventListener('click', async () => {
    const u = await getUser();
    if (!u) { location.href = url('connexion/?next=' + encodeURIComponent(location.pathname)); return; }
    const { data: p } = await sb.from('profiles').select('full_name,phone').eq('id', u.id).maybeSingle();
    if (!$<HTMLInputElement>('name').value) $<HTMLInputElement>('name').value = p?.full_name ?? '';
    if (!$<HTMLInputElement>('phone').value) $<HTMLInputElement>('phone').value = p?.phone ?? '';
    dlg.showModal();
  });
  $('form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const user = await getUser(); if (!user) return;
    const list = cart.get(); if (!list.length) return;
    const v = (id: string) => ($<HTMLInputElement>(id)).value.trim();
    const err = $('err'), btn = $<HTMLButtonElement>('send');
    btn.disabled = true; btn.textContent = 'Envoi…';
    const fail = (m: string) => { err.textContent = m; err.classList.remove('hidden'); btn.disabled = false; btn.textContent = 'Confirmer ma réservation'; };
    // Voitures : les dates sont-elles toujours libres ?
    for (const i of list.filter((x) => x.type === 'car' && x.date)) {
      const { data: taken } = await sb.from('blocked_dates').select('day').eq('item_type', 'car').eq('item_slug', i.slug).gte('day', i.date!).lte('day', i.endDate ?? i.date!).limit(1);
      if (taken?.length) return fail(`${i.title} n’est plus disponible à ces dates. Modifiez les dates ou choisissez une autre voiture.`);
    }
    const sub = cart.total(), total = sub - (promo ? Math.round((sub * promo.pct) / 100) : 0);
    const { data: order, error } = await sb.from('orders').insert({ user_id: user.id, contact_name: v('name'), contact_phone: v('phone'), contact_email: user.email, notes: v('notes') || null, total_estimate: total || null, promo_code: promo?.code ?? null, discount_percent: promo?.pct ?? null }).select('id').single();
    if (error || !order) return fail('Erreur : ' + (error?.message ?? 'inconnue'));
    const optText = (i: CartItem) => [i.option, i.duration, i.time, ...(i.extras ?? []).map((x) => `+ ${x.name} ×${x.qty}`)].filter(Boolean).join(' · ') || null;
    const { error: e2 } = await sb.from('order_items').insert(list.map((i) => ({ order_id: order.id, item_type: i.type, item_slug: i.slug, item_title: i.title, item_option: optText(i), date: i.date, end_date: i.endDate, people: i.qty, unit_price: i.unitPrice, price_label: i.priceUnit, details: { time: i.time ?? null, duration: i.duration ?? null, extras: i.extras ?? [], line_total: lineTotal(i) } })));
    if (e2) return fail('Erreur : ' + e2.message);
    await sb.rpc('finalize_order', { p_order: order.id });
    await sb.from('profiles').update({ full_name: v('name'), phone: v('phone') }).eq('id', user.id);
    const recap = `Bonjour Dubai Location 👋 Je viens de faire la réservation n°${order.id} sur le site :\n` + list.map((i) => `• ${i.title}${optText(i) ? ' (' + optText(i) + ')' : ''} : ${i.type === 'car' ? `du ${i.date} au ${i.endDate}` : `${i.date}, ${qLabel(i)}`}`).join('\n') + `\nNom : ${v('name')}`;
    cart.clear(); dlg.close();
    document.querySelector('main section')!.innerHTML = `<div class="mx-auto max-w-xl py-10 text-center"><div class="mx-auto grid h-24 w-24 place-items-center rounded-[28px] bg-emerald-50 text-emerald-600"><svg viewBox="0 0 24 24" class="h-12 w-12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></div><h1 class="mt-6 text-[22px] font-extrabold">Réservation envoyée !</h1><p class="mt-3 text-[15px] text-gray-600">Votre demande n°<b>${order.id}</b> est enregistrée. Nous vous confirmons la disponibilité et le prix très vite.</p><a href="${waLink(recap)}" target="_blank" rel="noopener" class="btn-wa mt-7">Accélérer sur WhatsApp</a><a href="${url('compte/#commandes')}" class="mt-5 block text-[15px] font-medium text-sky-500">Voir mes réservations</a></div>`;
  });
</script>
