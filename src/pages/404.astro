---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page introuvable">
  <section class="container-x flex min-h-[80svh] flex-col items-center justify-center pt-28 text-center">
    <p class="font-display text-8xl font-extrabold text-gold">404</p>
    <h1 class="mt-4 text-3xl font-bold sm:text-4xl">Cette page s'est perdue dans le désert</h1>
    <p class="mt-3 text-muted">Pas de panique, on vous ramène en ville.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3"><a href="/" class="btn-ink">Retour à l'accueil</a><a href="/activites" class="btn-outline">Voir les expériences</a></div>
  </section>
</Layout>
