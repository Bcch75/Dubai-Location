---
import Layout from './Layout.astro';
interface Props { title: string; intro?: string }
const { title, intro } = Astro.props;
---
<Layout title={title}>
  <section class="container-x max-w-3xl pb-24 pt-36 sm:pt-44">
    <span class="eyebrow">Informations</span>
    <h1 class="mt-4 text-4xl font-bold sm:text-5xl">{title}</h1>
    {intro && <p class="mt-5 text-lg text-muted">{intro}</p>}
    <div class="prose-text mt-10 space-y-5 leading-relaxed text-ink-soft">
      <slot />
    </div>
  </section>
</Layout>
<style is:global>
  .prose-text h2 { font-family: var(--font-sans); font-weight: 700; font-size: 1.25rem; color: var(--color-ink); margin-top: 2.25rem; letter-spacing: 0; }
  .prose-text ul { list-style: disc; padding-left: 1.25rem; }
  .prose-text li { margin-top: .4rem; }
  .prose-text .todo { background: #fff4d6; border-left: 3px solid var(--color-gold); padding: .75rem 1rem; border-radius: .5rem; font-size: .95rem; }
</style>
