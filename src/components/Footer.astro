---
import Icon from './Icon.astro';
import { site, socials, waLink } from '../data/site';
import Social from './Social.astro';
import { getCategories } from '../lib/data';
const categories = await getCategories();
const year = new Date().getFullYear();
---
<footer class="border-t border-line bg-white text-sm text-muted">
  <div class="container-x grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <span class="text-lg font-extrabold text-gold">DUBAI LOCATION</span>
      <p class="mt-3 max-w-sm leading-relaxed">Votre conciergerie à Dubaï : réservation d'activités, d'excursions et location de voitures de prestige.</p>
      <a href={waLink()} target="_blank" rel="noopener" class="btn-wa mt-5 !px-5 !py-2.5 text-sm"><Icon name="whatsapp" class="h-4 w-4" /> Réserver sur WhatsApp</a>
    </div>
    <div class="md:col-span-2">
      <h3 class="font-semibold text-ink">Activités</h3>
      <ul class="mt-4 space-y-2.5">
        {categories.map((c) => <li><a href={`/activites/${c.slug}/`} class="hover:text-ink">{c.label}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-2">
      <h3 class="font-semibold text-ink">Services</h3>
      <ul class="mt-4 space-y-2.5">
        <li><a href="/activites/" class="hover:text-ink">Toutes les activités</a></li>
        <li><a href="/voitures/" class="hover:text-ink">Location de voitures</a></li>
        <li><a href="/contact/" class="hover:text-ink">Contact & FAQ</a></li>
      </ul>
    </div>
    <div class="md:col-span-3">
      <h3 class="font-semibold text-ink">Légal & contact</h3>
      <ul class="mt-4 space-y-2.5">
        <li><a href="/conditions" class="hover:text-ink">Conditions de réservation</a></li>
        <li><a href="/mentions-legales" class="hover:text-ink">Mentions légales</a></li>
        <li><a href={`tel:+${site.whatsapp}`} class="hover:text-ink">{site.phoneDisplay}</a></li>
        <li><a href={`mailto:${site.email}`} class="break-all hover:text-ink">{site.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="container-x flex flex-col gap-3 border-t border-line py-6 sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {site.name}. Tous droits réservés</p>
    <div class="flex items-center gap-4 pr-20 text-ink">
      {socials.filter((x) => x.url && x.key !== 'google').map((x) => <a href={x.url} target="_blank" rel="noopener" aria-label={x.label} class="transition hover:text-gold"><Social k={x.key} class="h-5 w-5" /></a>)}
      <a href={waLink()} target="_blank" rel="noopener" aria-label="WhatsApp" class="transition hover:text-gold"><Social k="whatsapp" class="h-5 w-5" /></a>
      <a href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" class="h-4 w-4" /></a>
    </div>
  </div>
</footer>
