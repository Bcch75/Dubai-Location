---
import Icon from './Icon.astro';
import { site, waLink } from '../data/site';
interface Props { transparent?: boolean }
const path = Astro.url.pathname + Astro.url.search;
const links = [
  { href: '/activites/?cat=desert', label: 'Désert', icon: '🏜️' },
  { href: '/activites/?cat=mer', label: 'Mer & yacht', icon: '🛥️' },
  { href: '/activites/?cat=ciel', label: 'Dans les airs', icon: '🎈' },
  { href: '/voitures/', label: 'Voitures', icon: '🏎️' },
  { href: '/blog/', label: 'Blog', icon: '' },
];
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-5 sm:pt-4">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 rounded-2xl border border-line/70 bg-white/95 px-4 py-2.5 shadow-[0_4px_24px_-8px_rgb(17_24_39/0.18)] backdrop-blur sm:px-6" aria-label="Navigation principale">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${site.name}, accueil`}>
      <span class="grid h-10 w-10 place-items-center rounded-xl bg-gold text-white">
        <svg viewBox="0 0 32 32" class="h-6 w-6" aria-hidden="true"><path d="M16 3c-.8 6-1.4 14-1.4 22h2.8C17.4 17 16.8 9 16 3z" fill="currentColor"/><path d="M8 27h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </span>
      <span class="leading-none">
        <span class="block text-[17px] font-extrabold tracking-tight text-gold">DUBAI</span>
        <span class="mt-0.5 block rounded bg-gold px-1.5 py-0.5 text-[10px] font-bold tracking-wider text-white">LOCATION</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class:list={['rounded-full px-4 py-2 text-[15px] font-semibold text-ink transition hover:bg-sand', path === l.href && 'bg-sand']}>
            {l.icon && <span aria-hidden="true" class="mr-1">{l.icon}</span>}{l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-0.5">
      <a href="/activites/" class="grid h-10 w-10 place-items-center rounded-full text-ink transition hover:bg-sand" aria-label="Rechercher"><Icon name="search" class="h-5 w-5" /></a>
      <a href="/favoris/" class="grid h-10 w-10 place-items-center rounded-full text-ink transition hover:bg-sand" aria-label="Mes favoris"><Icon name="heart" class="h-5 w-5" /></a>
      <a href="/panier/" class="relative grid h-10 w-10 place-items-center rounded-full text-ink transition hover:bg-sand" aria-label="Panier">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/><path d="M2.5 3.5h2.6l2.4 12h11.6l2-8.5H6.2"/></svg>
        <span data-cart-count class="absolute -right-0.5 -top-0.5 hidden min-w-[18px] rounded-full bg-gold px-1 text-center text-[11px] font-bold leading-[18px] text-white">0</span>
      </a>
      <a href="/connexion/" data-account-link class="grid h-10 w-10 place-items-center rounded-full text-ink transition hover:bg-sand" aria-label="Mon compte">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
      </a>
      <button id="menu-open" class="grid h-10 w-10 place-items-center rounded-full text-ink hover:bg-sand lg:hidden" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="pointer-events-none fixed inset-0 z-50 opacity-0 transition-opacity duration-300 lg:hidden" aria-hidden="true">
    <div class="absolute inset-0 bg-ink/40" data-close></div>
    <div class="menu-panel absolute inset-x-3 top-3 -translate-y-3 rounded-2xl bg-white p-5 shadow-lift transition-transform duration-300">
      <div class="flex items-center justify-between">
        <span class="text-lg font-extrabold text-gold">DUBAI LOCATION</span>
        <button class="grid h-10 w-10 place-items-center rounded-full bg-sand" aria-label="Fermer le menu" data-close><Icon name="close" class="h-5 w-5" /></button>
      </div>
      <ul class="mt-4 space-y-1">
        <li><a href="/activites/" data-close class="block rounded-xl px-3 py-3 text-lg font-semibold hover:bg-sand">Toutes les activités</a></li>
        {links.map((l) => <li><a href={l.href} data-close class="block rounded-xl px-3 py-3 text-lg font-semibold hover:bg-sand">{l.icon && <span class="mr-2">{l.icon}</span>}{l.label}</a></li>)}
        <li><a href="/contact/" data-close class="block rounded-xl px-3 py-3 text-lg font-semibold hover:bg-sand">Contact</a></li>
        <li><a href="/compte/" data-close class="block rounded-xl px-3 py-3 text-lg font-semibold hover:bg-sand">Mon compte</a></li>
      </ul>
      <a href={waLink()} target="_blank" rel="noopener" class="btn-wa mt-5 w-full"><Icon name="whatsapp" class="h-5 w-5" /> Écrire sur WhatsApp</a>
    </div>
  </div>
</header>

<style>
  #mobile-menu.is-open { opacity: 1; pointer-events: auto; }
  #mobile-menu.is-open .menu-panel { transform: none; }
</style>

<script>
  const menu = document.getElementById('mobile-menu')!;
  const openBtn = document.getElementById('menu-open')!;
  const setOpen = (open: boolean) => {
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  openBtn.addEventListener('click', () => setOpen(true));
  menu.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
