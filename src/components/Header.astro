---
import Icon from './Icon.astro';
import { getCategories } from '../lib/data';
import { pill } from '../lib/icons';
import { site, waLink } from '../data/site';
interface Props { transparent?: boolean }
const path = Astro.url.pathname + Astro.url.search;
const categories = await getCategories();
const links = [
  ...categories.filter((c) => c.in_menu).slice(0, 4).map((c) => ({ href: `/activites/${c.slug}/`, label: c.label, icon: c.icon ?? '', color: c.icon_color ?? null })),
  { href: '/voitures/', label: 'Voitures', icon: 'car', color: null },
  { href: '/blog/', label: 'Blog', icon: '', color: null },
];
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-5 sm:pt-4">
  <nav class="mx-auto flex h-16 max-w-[1220px] items-center justify-between gap-2 rounded-2xl bg-white pl-3 pr-1.5 shadow-[0_25px_50px_-12px_rgb(0_0_0/0.25)] ring-1 ring-gray-200/50 sm:gap-4 sm:px-6" aria-label="Navigation principale">
    <a href="/" class="flex shrink-0 items-center gap-2 sm:gap-2.5" aria-label={`${site.name}, accueil`}>
      {site.logoUrl
        ? <img src={site.logoUrl} alt="" class="h-9 w-9 shrink-0 rounded-full object-cover ring-1 ring-black/10 min-[390px]:h-10 min-[390px]:w-10 sm:h-11 sm:w-11" />
        : <img src="/logo.svg" alt="" class="h-9 w-9 shrink-0 rounded-full min-[390px]:h-10 min-[390px]:w-10 sm:h-11 sm:w-11" />}
      <span class="gold-text leading-none">
        <span class="block font-serif-logo text-[17px] font-bold tracking-[0.06em] min-[390px]:text-[19px] sm:text-[21px]">DUBAI</span>
        <span class="mt-0.5 block text-[8.5px] font-semibold tracking-[0.32em] min-[390px]:text-[9.5px] sm:text-[10px]">LOCATION</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class:list={['flex h-10 items-center gap-2 rounded-full px-4 text-base font-semibold text-black transition hover:bg-gray-100', path === l.href && 'bg-gray-100']}>
            {l.icon && <Fragment set:html={pill(l.icon, 15, false, l.color)} />}{l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex shrink-0 items-center">
      <div class="relative">
        <button type="button" id="lc-btn" class="flex h-[34px] items-center gap-1 rounded-full px-1.5 text-ink transition hover:bg-sand min-[390px]:h-[38px] sm:h-10 sm:px-2" aria-label="Langue et devise" aria-expanded="false">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
          <span id="lc-cur" class="text-[11px] font-bold">AED</span>
        </button>
        <div id="lc-panel" class="fixed inset-x-3 top-[84px] z-50 hidden rounded-2xl bg-white p-4 shadow-[0_25px_50px_-12px_rgb(0_0_0/0.35)] ring-1 ring-gray-200 sm:absolute sm:inset-x-auto sm:right-0 sm:top-12 sm:w-72">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">Langue</p>
          <div id="lc-langs" class="mt-2 grid grid-cols-2 gap-1.5"></div>
          <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-gray-400">Devise</p>
          <div id="lc-curs" class="mt-2 grid grid-cols-2 gap-1.5"></div>
        </div>
      </div>
      <a href="/activites/" class="hidden min-[390px]:grid h-[34px] w-[34px] min-[390px]:h-[38px] min-[390px]:w-[38px] place-items-center rounded-full text-ink transition hover:bg-sand sm:h-10 sm:w-10" aria-label="Rechercher"><Icon name="search" class="h-5 w-5" /></a>
      <a href="/favoris/" class="grid h-[34px] w-[34px] min-[390px]:h-[38px] min-[390px]:w-[38px] place-items-center rounded-full text-ink transition hover:bg-sand sm:h-10 sm:w-10" aria-label="Mes favoris"><Icon name="heart" class="h-5 w-5" /></a>
      <a href="/panier/" class="relative grid h-[34px] w-[34px] min-[390px]:h-[38px] min-[390px]:w-[38px] place-items-center rounded-full text-ink transition hover:bg-sand sm:h-10 sm:w-10" aria-label="Panier">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/><path d="M2.5 3.5h2.6l2.4 12h11.6l2-8.5H6.2"/></svg>
        <span data-cart-count class="absolute -right-0.5 -top-0.5 hidden min-w-[18px] rounded-full bg-gold px-1 text-center text-[11px] font-bold leading-[18px] text-white">0</span>
      </a>
      <a href="/connexion/" data-account-link class="hidden h-[34px] w-[34px] min-[390px]:h-[38px] min-[390px]:w-[38px] place-items-center sm:grid rounded-full text-ink transition hover:bg-sand sm:h-10 sm:w-10" aria-label="Mon compte">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
      </a>
      <button id="menu-open" class="grid h-[34px] w-[34px] min-[390px]:h-[38px] min-[390px]:w-[38px] place-items-center rounded-full text-ink hover:bg-sand lg:hidden" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="pointer-events-none fixed inset-0 z-50 opacity-0 transition-opacity duration-300 lg:hidden" aria-hidden="true">
    <div class="absolute inset-0 bg-ink/40" data-close></div>
    <div class="menu-panel absolute inset-x-3 top-3 -translate-y-3 rounded-2xl bg-white p-5 shadow-lift transition-transform duration-300">
      <div class="flex items-center justify-between">
        <span class="gold-text font-serif-logo text-lg font-bold tracking-[0.08em]">DUBAI LOCATION</span>
        <button class="grid h-10 w-10 place-items-center rounded-full bg-sand" aria-label="Fermer le menu" data-close><Icon name="close" class="h-5 w-5" /></button>
      </div>
      <ul class="mt-4 space-y-1">
        <li><a href="/activites/" data-close class="block rounded-xl px-3 py-3 text-lg font-semibold hover:bg-sand">Toutes les activités</a></li>
        {links.map((l) => <li><a href={l.href} data-close class="block rounded-xl px-3 py-3 text-lg font-semibold hover:bg-sand">{l.icon && <span class="mr-2 inline-flex align-middle" set:html={pill(l.icon, 16, false, l.color)} />}{l.label}</a></li>)}
        <li><a href="/contact/" data-close class="block rounded-xl px-3 py-3 text-lg font-semibold hover:bg-sand">Contact</a></li>
        <li><a href="/compte/" data-close class="block rounded-xl px-3 py-3 text-lg font-semibold hover:bg-sand">Mon compte</a></li>
      </ul>
      <a href={waLink()} target="_blank" rel="noopener" class="btn-wa mt-5 w-full"><Icon name="whatsapp" class="h-5 w-5" /> Écrire sur WhatsApp</a>
    </div>
  </div>
</header>

<style>
  #mobile-menu.is-open { opacity: 1; pointer-events: auto; }
  #mobile-menu.is-open .menu-panel { transform: none; }
</style>

<script>
  import { LANGS, lang, chooseLang, CURRENCIES, currency, chooseCurrency } from '../lib/app';
  const lcBtn = document.getElementById('lc-btn')!, lcPanel = document.getElementById('lc-panel')!;
  const opt = (on: boolean, data: string, label: string) => `<button type="button" ${data} class="rounded-lg px-2.5 py-2 text-left text-sm ${on ? 'bg-blue-50 font-semibold text-gold ring-1 ring-gold' : 'hover:bg-gray-100'}">${label}</button>`;
  document.getElementById('lc-cur')!.textContent = currency();
  document.getElementById('lc-langs')!.innerHTML = LANGS.map(([c, f, l]) => opt(lang() === c, `data-lang="${c}"`, `${f} ${l}`)).join('');
  document.getElementById('lc-curs')!.innerHTML = Object.entries(CURRENCIES).map(([c, v]) => opt(currency() === c, `data-cur="${c}"`, `${v.flag} ${c}`)).join('');
  lcBtn.addEventListener('click', (e) => { e.stopPropagation(); const open = lcPanel.classList.toggle('hidden') === false; lcBtn.setAttribute('aria-expanded', String(open)); });
  document.addEventListener('click', (e) => { if (!lcPanel.contains(e.target as Node)) lcPanel.classList.add('hidden'); });
  lcPanel.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-lang],[data-cur]'); if (!b) return;
    if (b.dataset.lang) chooseLang(b.dataset.lang); else chooseCurrency(b.dataset.cur!);
  });
  const menu = document.getElementById('mobile-menu')!;
  const openBtn = document.getElementById('menu-open')!;
  const setOpen = (open: boolean) => {
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  openBtn.addEventListener('click', () => setOpen(true));
  menu.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
