---
import Icon from './Icon.astro';
import { getCategories } from '../lib/data';
import { pill } from '../lib/icons';
import { site, waLink } from '../data/site';
interface Props { transparent?: boolean }
const path = Astro.url.pathname + Astro.url.search;
const categories = await getCategories();
const links = [
  ...categories.filter((c) => c.in_menu).slice(0, 4).map((c) => ({ href: `/activites/${c.slug}/`, label: c.label, icon: c.icon ?? '', color: c.icon_color ?? null })),
  { href: '/voitures/', label: 'Voitures', icon: 'car', color: null },
  { href: '/blog/', label: 'Blog', icon: '', color: null },
];
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-5 sm:pt-4">
  <nav class="mx-auto flex h-[68px] max-w-[1220px] sm:h-[72px] items-center justify-between gap-2 rounded-2xl bg-white pl-3 pr-1.5 shadow-[0_25px_50px_-12px_rgb(0_0_0/0.25)] ring-1 ring-gray-200/50 sm:gap-4 sm:px-6" aria-label="Navigation principale">
    <a href="/" class="flex shrink-0 items-center gap-2 sm:gap-2.5" aria-label={`${site.name}, accueil`}>
      {site.logoUrl
        ? <img src={site.logoUrl} alt="" class="h-10 w-10 shrink-0 rounded-full object-cover ring-1 ring-black/10 min-[390px]:h-11 min-[390px]:w-11 sm:h-11 sm:w-11" />
        : <img src="/logo.svg" alt="" class="h-10 w-10 shrink-0 rounded-full min-[390px]:h-11 min-[390px]:w-11 sm:h-11 sm:w-11" />}
      <span class="gold-text leading-none">
        <span class="block font-serif-logo text-[14px] font-bold tracking-[0.06em] min-[390px]:text-[15px] sm:text-[18px]">DUBAI</span>
        <span class="mt-0.5 block text-[7px] font-semibold tracking-[0.3em] min-[390px]:text-[7.5px] sm:text-[8.5px]">LOCATION</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class:list={['flex h-10 items-center gap-2 rounded-full px-4 text-base font-semibold text-black transition hover:bg-gray-100', path === l.href && 'bg-gray-100']}>
            {l.icon && <Fragment set:html={pill(l.icon, 15, false, l.color)} />}{l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex shrink-0 items-center min-[360px]:gap-1 min-[390px]:gap-2">
      <div class="relative">
        <button type="button" id="lc-btn" class="flex h-10 items-center gap-1 rounded-full px-1.5 text-ink transition hover:bg-sand min-[390px]:h-11 sm:h-10 sm:px-2" aria-label="Langue et devise" aria-expanded="false">
          <svg viewBox="0 0 24 24" class="h-6 w-6 min-[390px]:h-[26px] min-[390px]:w-[26px]" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
          <span id="lc-cur" class="text-[11px] font-bold">AED</span>
        </button>
        <div id="lc-panel" class="fixed inset-x-3 top-[84px] z-50 hidden rounded-2xl bg-white p-4 shadow-[0_25px_50px_-12px_rgb(0_0_0/0.35)] ring-1 ring-gray-200 sm:absolute sm:inset-x-auto sm:right-0 sm:top-12 sm:w-72">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">Langue</p>
          <div id="lc-langs" class="mt-2 grid grid-cols-2 gap-1.5"></div>
          <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-gray-400">Devise</p>
          <div id="lc-curs" class="mt-2 grid grid-cols-2 gap-1.5"></div>
        </div>
      </div>
      <a href="/activites/" class="hidden min-[430px]:grid h-10 w-10 min-[390px]:h-11 min-[390px]:w-11 place-items-center rounded-full text-ink transition hover:bg-sand sm:h-11 sm:w-11" aria-label="Rechercher"><Icon name="search" class="h-6 w-6 min-[390px]:h-[26px] min-[390px]:w-[26px]" /></a>
      <a href="/favoris/" class="grid h-10 w-10 min-[390px]:h-11 min-[390px]:w-11 place-items-center rounded-full text-ink transition hover:bg-sand sm:h-11 sm:w-11" aria-label="Mes favoris"><Icon name="heart" class="h-6 w-6 min-[390px]:h-[26px] min-[390px]:w-[26px]" /></a>
      <a href="/panier/" class="relative grid h-10 w-10 min-[390px]:h-11 min-[390px]:w-11 place-items-center rounded-full text-ink transition hover:bg-sand sm:h-11 sm:w-11" aria-label="Panier">
        <svg viewBox="0 0 24 24" class="h-6 w-6 min-[390px]:h-[26px] min-[390px]:w-[26px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/><path d="M2.5 3.5h2.6l2.4 12h11.6l2-8.5H6.2"/></svg>
        <span data-cart-count class="absolute -right-0.5 -top-0.5 hidden min-w-[18px] rounded-full bg-gold px-1 text-center text-[11px] font-bold leading-[18px] text-white">0</span>
      </a>
      <a href="/connexion/" data-account-link class="hidden h-10 w-10 min-[390px]:h-11 min-[390px]:w-11 place-items-center sm:grid rounded-full text-ink transition hover:bg-sand sm:h-11 sm:w-11" aria-label="Mon compte">
        <svg viewBox="0 0 24 24" class="h-6 w-6 min-[390px]:h-[26px] min-[390px]:w-[26px]" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
      </a>
      <button id="menu-open" class="grid h-10 w-10 min-[390px]:h-11 min-[390px]:w-11 place-items-center rounded-full text-ink hover:bg-sand lg:hidden" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" class="h-7 w-7" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="pointer-events-none fixed inset-0 z-50 opacity-0 transition-opacity duration-200 lg:hidden" aria-hidden="true">
    <div class="absolute inset-0 bg-black/30" data-close></div>
    <div class="menu-panel absolute inset-x-3 top-3 max-h-[calc(100dvh-24px)] -translate-y-2 overflow-y-auto rounded-2xl bg-white shadow-[0_25px_50px_-12px_rgb(0_0_0/0.35)] ring-1 ring-gray-200/50 transition-transform duration-200 sm:inset-x-5 sm:top-4">
      <div class="flex h-[68px] items-center justify-between gap-2 border-b border-gray-100 pl-3 pr-1.5">
        <a href="/" class="flex shrink-0 items-center gap-2" aria-label={`${site.name}, accueil`}>
          <img src={site.logoUrl || '/logo.svg'} alt="" class="h-10 w-10 shrink-0 rounded-full object-cover min-[390px]:h-11 min-[390px]:w-11" />
          <span class="gold-text leading-none">
            <span class="block font-serif-logo text-[14px] font-bold tracking-[0.06em] min-[390px]:text-[15px]">DUBAI</span>
            <span class="mt-0.5 block text-[7px] font-semibold tracking-[0.3em] min-[390px]:text-[7.5px]">LOCATION</span>
          </span>
        </a>
        <div class="flex items-center min-[360px]:gap-1 min-[390px]:gap-2">
          <a href="/activites/" class="hidden h-10 w-10 min-[390px]:h-11 min-[390px]:w-11 place-items-center rounded-full text-ink min-[430px]:grid" aria-label="Rechercher"><Icon name="search" class="h-6 w-6 min-[390px]:h-[26px] min-[390px]:w-[26px]" /></a>
          <a href="/favoris/" class="grid h-10 w-10 min-[390px]:h-11 min-[390px]:w-11 place-items-center rounded-full text-ink" aria-label="Mes favoris"><Icon name="heart" class="h-6 w-6 min-[390px]:h-[26px] min-[390px]:w-[26px]" /></a>
          <a href="/panier/" class="relative grid h-10 w-10 min-[390px]:h-11 min-[390px]:w-11 place-items-center rounded-full text-ink" aria-label="Panier">
            <svg viewBox="0 0 24 24" class="h-6 w-6 min-[390px]:h-[26px] min-[390px]:w-[26px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/><path d="M2.5 3.5h2.6l2.4 12h11.6l2-8.5H6.2"/></svg>
            <span data-cart-count class="absolute -right-0.5 -top-0.5 hidden min-w-[18px] rounded-full bg-gold px-1 text-center text-[11px] font-bold leading-[18px] text-white">0</span>
          </a>
          <button class="grid h-10 w-10 min-[390px]:h-11 min-[390px]:w-11 place-items-center rounded-full text-ink" aria-label="Fermer le menu" data-close><Icon name="close" class="h-7 w-7" /></button>
        </div>
      </div>
      <ul class="px-3 py-2">
        {links.map((l) => <li><a href={l.href} data-close class="flex items-center gap-3 rounded-xl px-3 py-3.5 text-[19px] font-bold text-ink hover:bg-gray-50">{l.icon && <span class="inline-flex" set:html={pill(l.icon, 18, false, l.color)} />}{l.label}</a></li>)}
        <li><a href="/panier/" data-close class="flex items-center gap-3 rounded-xl px-3 py-3.5 text-[19px] font-bold text-ink hover:bg-gray-50"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/><path d="M2.5 3.5h2.6l2.4 12h11.6l2-8.5H6.2"/></svg>Panier</a></li>
      </ul>
      <div class="flex items-center justify-between gap-2 border-y border-gray-100 px-4 py-3.5">
        <div id="mm-langs" class="flex gap-1"></div>
        <label class="relative shrink-0">
          <span class="sr-only">Devise</span>
          <select id="mm-cur" class="h-10 appearance-none rounded-xl bg-gray-100 pl-3 pr-8 text-base font-semibold text-ink outline-none"></select>
          <svg viewBox="0 0 24 24" class="pointer-events-none absolute right-2.5 top-1/2 h-4 w-4 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </label>
      </div>
      <div id="mm-guest" class="space-y-3 p-4">
        <a href="/connexion/" class="flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#38b2f5] text-[17px] font-semibold text-white"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>Connexion</a>
        <a href="/connexion/#inscription" class="flex h-12 w-full items-center justify-center gap-2 rounded-xl border border-gray-300 text-[17px] font-medium text-ink"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10" cy="8" r="4"/><path d="M3 21a7 7 0 0 1 14 0M19 8v6M16 11h6"/></svg>Inscription</a>
      </div>
      <div id="mm-user" class="hidden space-y-3 p-4">
        <a id="mm-account" href="/compte/" class="flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#38b2f5] text-[17px] font-semibold text-white"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><span>Mon compte</span></a>
        <a href="/compte/#commandes" class="flex h-12 w-full items-center justify-center gap-2 rounded-xl border border-gray-300 text-[17px] font-medium text-ink">Mes commandes</a>
      </div>
    </div>
  </div>
</header>

<style>
  #mobile-menu.is-open { opacity: 1; pointer-events: auto; }
  #mobile-menu.is-open .menu-panel { transform: none; }
</style>

<script>
  import { LANGS, lang, chooseLang, CURRENCIES, currency, chooseCurrency, getUser, isAdmin } from '../lib/app';
  const lcBtn = document.getElementById('lc-btn')!, lcPanel = document.getElementById('lc-panel')!;
  const opt = (on: boolean, data: string, label: string) => `<button type="button" ${data} class="rounded-lg px-2.5 py-2 text-left text-sm ${on ? 'bg-blue-50 font-semibold text-gold ring-1 ring-gold' : 'hover:bg-gray-100'}">${label}</button>`;
  document.getElementById('lc-cur')!.textContent = currency();
  document.getElementById('lc-langs')!.innerHTML = LANGS.map(([c, f, l]) => opt(lang() === c, `data-lang="${c}"`, `${f} ${l}`)).join('');
  document.getElementById('lc-curs')!.innerHTML = Object.entries(CURRENCIES).map(([c, v]) => opt(currency() === c, `data-cur="${c}"`, `${v.flag} ${c}`)).join('');
  lcBtn.addEventListener('click', (e) => { e.stopPropagation(); const open = lcPanel.classList.toggle('hidden') === false; lcBtn.setAttribute('aria-expanded', String(open)); });
  document.addEventListener('click', (e) => { if (!lcPanel.contains(e.target as Node)) lcPanel.classList.add('hidden'); });
  lcPanel.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-lang],[data-cur]'); if (!b) return;
    if (b.dataset.lang) chooseLang(b.dataset.lang); else chooseCurrency(b.dataset.cur!);
  });
  const ml = document.getElementById('mm-langs')!;
  ml.innerHTML = LANGS.map(([c, f, l]) => `<button type="button" data-lang="${c}" aria-label="${l}" class="grid h-11 w-12 place-items-center rounded-xl text-2xl ${lang() === c ? 'bg-sky-50 ring-1 ring-sky-400' : ''}">${f}</button>`).join('');
  ml.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-lang]'); if (b) chooseLang(b.dataset.lang!); });
  const SYM: Record<string, string> = { AED: 'د.إ', EUR: '€', USD: '$', GBP: '£' };
  const mc = document.getElementById('mm-cur') as HTMLSelectElement;
  mc.innerHTML = Object.keys(CURRENCIES).map((c) => `<option value="${c}" ${currency() === c ? 'selected' : ''}>${SYM[c] ?? ''} ${c}</option>`).join('');
  mc.addEventListener('change', () => chooseCurrency(mc.value));
  getUser().then(async (u) => {
    if (!u) return;
    document.getElementById('mm-guest')!.classList.add('hidden');
    document.getElementById('mm-user')!.classList.remove('hidden');
    if (await isAdmin()) { const a = document.getElementById('mm-account') as HTMLAnchorElement; a.href = '/admin/'; a.querySelector('span')!.textContent = 'Espace admin'; }
  });
  const menu = document.getElementById('mobile-menu')!;
  const openBtn = document.getElementById('menu-open')!;
  const setOpen = (open: boolean) => {
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  openBtn.addEventListener('click', () => setOpen(true));
  menu.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
